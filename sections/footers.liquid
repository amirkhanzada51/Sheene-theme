<!-- Shopify Section Schema / Custom Liquid Footer -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

<style>
  .custom-footer-section {
    background-color: #1a1a1a;
    color: #e5e5e5;
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    padding: 60px 0px 0px 0px;
    margin: 0;
    box-sizing: border-box;
    width: 100%;
  }

  .custom-footer-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px 50px 40px;
    display: flex;
    justify-content: space-between;
    gap: 40px;
  }

  .custom-footer-col {
    flex: 1;
  }

  .custom-footer-col-1 {
    max-width: 280px;
  }

  .custom-footer-col-2 {
    max-width: 250px;
  }

  .custom-footer-col-3 {
    max-width: 380px;
  }

  .custom-footer-heading {
    color: #d3d2d1;
    font-family: 'Jost', sans-serif;
    font-size: 17px;
    font-weight: 500;
    margin-bottom:10px;
    letter-spacing: 0.2px;
  }

  .custom-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .custom-footer-links li {
    margin-bottom: 5px;
  }

  .custom-footer-links a {
    color: #cccccc;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .custom-footer-links a:hover {
    color: #ffffff;
  }

  .custom-footer-contact-p {
    color: #cccccc;
    margin: 0 0 5px 0;
  }

  .custom-footer-link-underline {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .custom-footer-link-underline:hover {
    color: #ffffff;
    
  }

  .custom-footer-socials {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 24px;
  }

  .custom-footer-socials a {
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .custom-footer-socials a:hover {
    opacity: 0.8;
    transform: translateY(-2px);
  }

  .custom-footer-socials svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .custom-footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 10px 40px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .custom-footer-copyright {
    color: #cccccc;
    font-size: 15px;
    margin: 0;
  }

  .custom-footer-copyright a {
    color: #d3d2d1;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .custom-footer-container {
      flex-direction: column;
      gap: 35px;
      padding-bottom: 40px;
    }
    .custom-footer-col {
      max-width: 100%;
    }
  }
</style>

<footer class="custom-footer-section">
  <div class="custom-footer-container">
    
    <!-- Column 1: Company Overview -->
    <div class="custom-footer-col custom-footer-col-1">
      <div class="custom-footer-heading">Company Overview</div>
      <ul class="custom-footer-links">
        <li><a href="/pages/about-us">About Us</a></li>
        <li><a href="/pages/our-values">Our values</a></li>
        <li><a href="/policies/privacy-policy">Privacy notice</a></li>
        <li><a href="/policies/cookies">Cookie Policy</a></li>
        <li><a href="/policies/terms-of-service">Terms & conditions</a></li>
        <li><a href="/pages/disclaimer">Disclaimer</a></li>
        <li><a href="/pages/corporate-information">Corporate Information</a></li>
        <li><a href="/pages/media-outreach">Media Outreach</a></li>
        <li><a href="/pages/distributor-queries">Distributor Queries</a></li>
        <li><a href="/pages/grievance-redressal">Grievance Redressal</a></li>
      </ul>
    </div>

    <!-- Column 2: Quick Links -->
    <div class="custom-footer-col custom-footer-col-2">
      <div class="custom-footer-heading">Quick Links</div>
      <ul class="custom-footer-links">
        <li><a href="/pages/knowledge">Knowledge</a></li>
        <li><a href="/pages/faqs">FAQs</a></li>
        <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
        <li><a href="/policies/refund-policy">Return & refund policy</a></li>
        <li><a href="/pages/payment-policy">Payment Policy</a></li>
        <li><a href="/apps/track-order">Track order</a></li>
        {% comment %} <li><a href="/pages/download-app">Download App</a></li> {% endcomment %}
      </ul>
    </div>

    <!-- Column 3: Contact Us -->
    <div class="custom-footer-col custom-footer-col-3">
      <div class="custom-footer-heading">Contact Us</div>
      
      <p class="custom-footer-contact-p">Need help fast?</p>
      <p class="custom-footer-contact-p">
        <a href="https://wa.me/923272937782" class="custom-footer-link-underline">+923272937782</a>
      </p>
      <p class="custom-footer-contact-p">This is AI WhatsApp number. Kindly DM.</p>
      <p class="custom-footer-contact-p">OR</p>
      <p class="custom-footer-contact-p">
        Fill out <a href="/pages/contact" class="custom-footer-link-underline">our form</a> or email 
        <a href="mailto:contact@sheene.shop" class="custom-footer-link-underline">contact@sheene.shop</a>
      </p>
      
      <br>
      
      <p class="custom-footer-contact-p">
        For gifting inquiries, write to us at 
        <a href="mailto:contact@sheene.shop" class="custom-footer-link-underline">contact@sheene.shop</a>
      </p>

      <!-- Social Media Icons -->
