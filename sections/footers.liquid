        </a>
        <a href="https://www.tiktok.com/@sheene.skincare" aria-label="TikTok" target="_blank">
        <svg class="icon icon-tiktok" viewBox="0 0 20 20"><path fill="currentColor" d="M10.511 1.705h2.74s-.157 3.51 3.795 3.768v2.711s-2.114.129-3.796-1.158l.028 5.606A5.073 5.073 0 1 1 8.213 7.56h.708v2.785a2.298 2.298 0 1 0 1.618 2.205z"></path></svg>  
        </a>
      </div>
    </div>

  </div>

  <!-- Copyright Bottom Bar -->
  <div class="custom-footer-bottom">
    <p class="custom-footer-copyright">
      Copyright &copy; {{ 'now' | date: "%Y" }} <a href="{{ routes.root_url }}">{{ shop.name }}</a>.
    </p>
  </div>
</footer>

