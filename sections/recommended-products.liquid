<script>
(function () {

  const section =
    document.querySelector(
      '#rpfu-{{ section.id }}'
    );

  if (!section) return;


  const grid =
    section.querySelector(
      '[data-rpfu-grid]'
    );

  const productId =
    section.dataset.productId;

  const toast =
    document.querySelector(
      '[data-rpfu-toast]'
    );

    
  if (!grid || !productId) return;


  /* =======================================================
     HIDE SECTION
     ======================================================= */

  function hideSection() {

    section.hidden = true;

    section.style.display =
      'none';

  }


  /* =======================================================
     MONEY
     ======================================================= */

  function money(value) {

    const amount =
      Number(value || 0) / 100;

    return 'Rs. ' +
      amount.toLocaleString(
        'en-PK',
        {
          minimumFractionDigits: 0,
          maximumFractionDigits: 2
        }
      );

  }


  /* =======================================================
     ESCAPE HTML
     ======================================================= */

  function escapeHtml(value) {

    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');

  }


  /* =======================================================
     IMAGE URL
     ======================================================= */

  function imageUrl(image) {

    if (!image) return '';

    if (typeof image === 'string') {
      return image;
    }

    return image.src || '';

  }


  /* =======================================================
     PRODUCT URL
     ======================================================= */

  function productUrl(product) {

    if (
      product &&
      product.url
    ) {

      return product.url;

    }

    return '#';

  }


  /* =======================================================
     CREATE CARD
     ======================================================= */

  function createCard(product) {

    const card =
      document.createElement('article');

    card.className =
      'rpfu-card';


    /* =====================================================
       PRODUCT URL
       ===================================================== */

    const currentProductUrl =
      productUrl(product);


    /* =====================================================
       TRENDING
       ===================================================== */

    const tags =
      Array.isArray(product.tags)
        ? product.tags
        : [];


    const isTrending =
      tags.some(function (tag) {

        return String(tag)
          .toLowerCase()
          .includes('trending');

      });


    if (isTrending) {

      card.classList.add(
        'is-trending'
      );

    }


    /* =====================================================
       IMAGES
       ===================================================== */

    let images =
      Array.isArray(product.images)
        ? product.images
        : [];


    if (
      images.length === 0 &&
      product.featured_image
    ) {

      images = [
        product.featured_image
      ];

    }


    images =
      images.slice(0, 8);


    const imageMarkup =
      images.map(function (image) {

        return `
          <div class="rpfu-slide">

            <img
              src="${escapeHtml(
                imageUrl(image)
              )}"
              alt="${escapeHtml(
                product.title
              )}"
              loading="lazy"
            >

          </div>
        `;

      }).join('');


    /* =====================================================
       DOTS
       ===================================================== */

    const dotsMarkup =
      images.map(function (_, index) {

        return `
          <span
            class="rpfu-dot ${
              index === 0
                ? 'active'
                : ''
            }"
            data-dot="${index}"
          ></span>
        `;

      }).join('');


    /* =====================================================
       SINGLE IMAGE
       ===================================================== */

    if (images.length <= 1) {

      card.classList.add(
        'single-image'
      );

    }


    /* =====================================================
       VARIANTS
       ===================================================== */

    const variants =
      Array.isArray(product.variants)
        ? product.variants
        : [];


    const firstVariant =
      variants.length
        ? variants[0]
        : null;


    /* =====================================================
       PRICE
       ===================================================== */

    const price =
      firstVariant
        ? firstVariant.price
        : product.price;


    const comparePrice =
      firstVariant
        ? firstVariant.compare_at_price
        : product.compare_at_price;


    let priceMarkup = `
      <span class="rpfu-price">
        ${money(price)}
      </span>
    `;


    if (
      comparePrice &&
      Number(comparePrice) >
      Number(price)
    ) {

      priceMarkup += `
        <span class="rpfu-compare">
          ${money(comparePrice)}
        </span>
      `;

    }


    /* =====================================================
       DESCRIPTION
       ===================================================== */

    let description = '';


    if (product.description) {

      const temp =
        document.createElement('div');

      temp.innerHTML =
        product.description;

      description =
        temp.textContent
          .replace(/\s+/g, ' ')
          .trim();

    }


    if (description.length > 58) {

      description =
        description
          .substring(0, 58)
          .trim() + '...';

    }


    /* =====================================================
       VARIANT BUTTONS
       ===================================================== */

    let variantMarkup = '';


    if (variants.length > 1) {

      variantMarkup = `

        <div
          class="rpfu-variants"
          data-variants
        >

          ${variants
            .slice(0, 6)
            .map(function (
              variant,
              index
            ) {

              let label =
                variant.title;


              if (
                !label ||
                label ===
                'Default Title'
              ) {

                label =
                  variant.option1 ||
                  'Option ' +
                  (index + 1);

              }


              return `
                <button
                  type="button"
                  class="rpfu-variant ${
                    index === 0
                      ? 'active'
                      : ''
                  }"
                  data-variant-id="${
                    variant.id
                  }"
                >
                  ${escapeHtml(label)}
                </button>
              `;

            }).join('')}

        </div>

      `;

    }


    /* =====================================================
       CARD HTML
       ===================================================== */

    card.innerHTML = `

      <div
        class="rpfu-media"
        data-current-slide="0"
      >

        <!-- CLICKABLE PRODUCT IMAGE -->

        <a
          href="${escapeHtml(
            currentProductUrl
          )}"
          class="rpfu-image-link"
          aria-label="${escapeHtml(
            product.title
          )}"
        >

          <div
            class="rpfu-slides"
            data-slides
          >
            ${imageMarkup}
          </div>

        </a>


        <span class="rpfu-trending">
          Trending
        </span>


        <!-- PREVIOUS IMAGE -->

        <button
          type="button"
          class="rpfu-image-arrow rpfu-prev"
          data-prev
          aria-label="Previous image"
        >

          <svg viewBox="0 0 24 24">
            <path d="M15 18L9 12L15 6"></path>
          </svg>

        </button>


        <!-- NEXT IMAGE -->

        <button
          type="button"
          class="rpfu-image-arrow rpfu-next"
          data-next
          aria-label="Next image"
        >

          <svg viewBox="0 0 24 24">
            <path d="M9 18L15 12L9 6"></path>
          </svg>

        </button>


        <div class="rpfu-dots">
          ${dotsMarkup}
        </div>

      </div>


      <div class="rpfu-info">

        <!-- CLICKABLE PRODUCT TITLE -->

        <h3 class="rpfu-title">

          <a
            href="${escapeHtml(
              currentProductUrl
            )}"
            class="rpfu-title-link"
          >
            ${escapeHtml(
              product.title
            )}
          </a>

        </h3>


        <div class="rpfu-description">
          ${escapeHtml(
            description
          )}
        </div>


        <div class="rpfu-price-row">
          ${priceMarkup}
        </div>


        ${variantMarkup}


        <button
          type="button"
          class="rpfu-add ${
            variants.length > 1
              ? 'select-size'
              : ''
          }"
          data-add
          data-variant-id="${
            firstVariant
              ? firstVariant.id
              : ''
          }"
        >
          ${
            variants.length > 1
              ? 'Select Size'
              : 'Add to Cart'
          }
        </button>

      </div>

    `;


    /* =====================================================
       IMAGE SLIDER
       ===================================================== */

    const slides =
      card.querySelector(
        '[data-slides]'
      );

    const dots =
      card.querySelectorAll(
        '[data-dot]'
      );


    let currentSlide = 0;


    function goToSlide(index) {

      if (images.length <= 1) {
        return;
      }


      if (index < 0) {

        index =
          images.length - 1;

      }


      if (
        index >= images.length
      ) {

        index = 0;

      }


      currentSlide = index;


      slides.style.transform =
        'translateX(-' +
        (
          currentSlide * 100
        ) +
        '%)';


      dots.forEach(
        function (dot, i) {

          dot.classList.toggle(
            'active',
            i === currentSlide
          );

        }
      );

    }


    /* =====================================================
       IMAGE ARROWS
       ===================================================== */

    const prev =
      card.querySelector(
        '[data-prev]'
      );

    const next =
      card.querySelector(
        '[data-next]'
      );


    if (prev) {

      prev.addEventListener(
        'click',
        function (event) {

          event.preventDefault();

          event.stopPropagation();

          goToSlide(
            currentSlide - 1
          );

        }
      );

    }


    if (next) {

      next.addEventListener(
        'click',
        function (event) {

          event.preventDefault();

          event.stopPropagation();

          goToSlide(
            currentSlide + 1
          );

        }
      );

    }


    /* =====================================================
       VARIANT SELECTION
       ===================================================== */

    const variantButtons =
      card.querySelectorAll(
        '.rpfu-variant[data-variant-id]'
      );

    const addButton =
      card.querySelector(
        '[data-add]'
      );


    variantButtons.forEach(
      function (button) {

        button.addEventListener(
          'click',
          function () {

            variantButtons.forEach(
              function (item) {

                item.classList.remove(
                  'active'
                );

              }
            );


            button.classList.add(
              'active'
            );


            addButton.dataset.variantId =
              button.dataset.variantId;


            addButton.textContent =
              'Add to Cart';


            addButton.classList.remove(
              'select-size'
            );

          }
        );

      }
    );


    /* =====================================================
       ADD TO CART
       ===================================================== */

    if (addButton) {

      addButton.addEventListener(
        'click',
        async function () {

          const variantId =
            addButton.dataset.variantId;


          if (!variantId) {
            return;
          }


          addButton.classList.add(
            'loading'
          );

          addButton.disabled = true;


          try {

            const response =
              await fetch(
                '/cart/add.js',
                {
                  method: 'POST',

                  headers: {
                    'Content-Type':
                      'application/json',

                    'Accept':
                      'application/json'
                  },

                  body:
                    JSON.stringify({
                      items: [
                        {
                          id:
                            Number(
                              variantId
                            ),
                          quantity: 1
                        }
                      ]
                    })
                }
              );


            if (!response.ok) {

              throw new Error(
                'Cart error'
              );

            }


            await response.json();


            showToast(
              'Added to cart'
            );


            document.dispatchEvent(
              new CustomEvent(
                'cart:refresh'
              )
            );


            document.dispatchEvent(
              new CustomEvent(
                'cart:updated'
              )
            );


          } catch (error) {

            console.error(
              error
            );

            showToast(
              'Unable to add to cart'
            );

          }


          addButton.classList.remove(
            'loading'
          );

          addButton.disabled =
            false;

        }
      );

    }


    return card;

  }


  /* =======================================================
     TOAST
     ======================================================= */

  let toastTimer = null;


  function showToast(message) {

    if (!toast) return;


    toast.textContent =
      message;


    toast.classList.add(
      'show'
    );


    clearTimeout(
      toastTimer
    );


    toastTimer =
      setTimeout(
        function () {

          toast.classList.remove(
            'show'
          );

        },
        2200
      );

  }


  /* =======================================================
     LOAD SHOPIFY RECOMMENDATIONS
     ======================================================= */

  async function loadRecommendations() {

    try {

      const response =
        await fetch(
          '/recommendations/products.json' +
          '?product_id=' +
          encodeURIComponent(
            productId
          ) +
          '&limit=8' +
          '&intent=related'
        );


      if (!response.ok) {

        throw new Error(
          'Recommendation request failed'
        );

      }


      const data =
        await response.json();


      const products =
        data.products || [];


      if (!products.length) {

        grid.innerHTML = '';

        hideSection();

        return;

      }


      /*
        Desktop:
        EXACTLY 4 PRODUCT CARDS.
      */

      const displayProducts =
        products.slice(0, 4);


      displayProducts.forEach(
        function (product) {

          grid.appendChild(
            createCard(product)
          );

        }
      );


    } catch (error) {

      console.error(
        'Recommended products:',
        error
      );

      grid.innerHTML = '';

      hideSection();

    }

  }


  loadRecommendations();


})();
</script>


