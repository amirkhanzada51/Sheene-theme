{% comment %}
  SHEENE - Recommended products (product page)

  Cards ab wahi hain jo home page par Shop Bundles / Our Best Sellers
  mein hain: snippet 'sheene-home-product-slider' hi render hota hai.
  Design, badge, image slider, Choose options popup, sab usi se.

  Kaise kaam karta hai:
  1. Page load par 4 skeleton cards (grey boxes) dikhte hain.
  2. Shopify ke recommendations endpoint se yahi section dobara
     render hota hai, is dafa asli products ke saath (Shopify ka
     standard tareeqa, Dawn bhi yahi karta hai).
  3. Skeleton ki jagah asli cards aa jate hain. Recommendations
     na milen to poora section hide.

  Snippet mein ek chhota sa badlaav chahiye (product_list param),
  woh neeche chat mein diya hai.
{% endcomment %}

{% liquid
  assign HEADING = 'Recommended'
  assign LIMIT = 4
  assign SHOW_BADGE = false
  assign BADGE_TEXT = 'Recommended'
%}

<div
  class="sh-reco"
  id="ShReco-{{ section.id }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ LIMIT }}&intent=related"
>
  {%- if recommendations.performed -%}
    {%- if recommendations.products_count > 0 -%}
      {% render 'sheene-home-product-slider',
        product_list: recommendations.products,
        grid_id: 'recommended',
        heading: HEADING,
        show_badge: SHOW_BADGE,
        badge_text: BADGE_TEXT,
        limit: LIMIT,
        mobile_limit: LIMIT,
        show_view_all: false,
        show_buy_now: false
      %}
    {%- endif -%}
  {%- else -%}
    <div class="sh-reco__skel" aria-hidden="true">
      <h2 class="sh-reco__heading">{{ HEADING }}</h2>
      <div class="sh-reco__grid">
        {%- for i in (1..LIMIT) -%}
          <div>
            <div class="sh-reco__media"></div>
            <div class="sh-reco__line"></div>
            <div class="sh-reco__line sh-reco__line--short"></div>
            <div class="sh-reco__btn"></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

<style>
  .sh-reco { width: 100%; }
  .sh-reco__skel { padding: 40px 7px 8px; }
  .sh-reco__heading {
    margin: 0 0 34px;
    font-size: 32px;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.5px;
    color: #111;
  }
  .sh-reco__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 52px 24px;
  }
  .sh-reco__media {
    aspect-ratio: 1 / 1;
    background: linear-gradient(100deg, #eceff0 30%, #f5f6f7 50%, #eceff0 70%);
    background-size: 200% 100%;
    animation: shRecoShimmer 1.3s linear infinite;
  }
  .sh-reco__line { height: 16px; width: 80%; margin-top: 17px; border-radius: 4px; background: #eceff0; }
  .sh-reco__line--short { width: 45%; margin-top: 10px; }
  .sh-reco__btn { height: 48px; margin-top: 14px; background: #eceff0; }
  @keyframes shRecoShimmer { to { background-position: -200% 0; } }
  @media (prefers-reduced-motion: reduce) { .sh-reco__media { animation: none; } }
  @media screen and (max-width: 989px) {
    .sh-reco__skel { padding-left: 12px; padding-right: 12px; }
    .sh-reco__grid { gap: 42px 16px; }
  }
  @media screen and (max-width: 749px) {
    .sh-reco__skel { padding: 28px 7px 12px; }
    .sh-reco__heading { margin-bottom: 28px; }
    .sh-reco__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 34px 12px; }
    .sh-reco__btn { height: 46px; margin-top: 12px; }
  }
  .sh-reco .custom-best-sellers { animation: shRecoIn 0.35s ease; }
  @keyframes shRecoIn { from { opacity: 0; } to { opacity: 1; } }
</style>

{%- unless recommendations.performed -%}
<script>
  (function () {
    var root = document.getElementById('ShReco-{{ section.id }}');
    if (!root || root.dataset.loaded) return;
    root.dataset.loaded = '1';

    function hide() {
      var sec = root.closest('.shopify-section') || root;
      sec.style.display = 'none';
    }

    /* innerHTML se aaye scripts nahi chalte, is liye naye bana ke lagate hain */
    function runScripts(container) {
      container.querySelectorAll('script').forEach(function (old) {
        var s = document.createElement('script');
        for (var i = 0; i < old.attributes.length; i++) s.setAttribute(old.attributes[i].name, old.attributes[i].value);
        s.textContent = old.textContent;
        old.parentNode.replaceChild(s, old);
      });
    }

    fetch(root.dataset.url)
      .then(function (r) { if (!r.ok) throw new Error('reco'); return r.text(); })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var fresh = doc.getElementById(root.id);
        if (!fresh || !fresh.querySelector('.custom-best-sellers__card')) return hide();
        root.innerHTML = fresh.innerHTML;
        runScripts(root);
      })
      .catch(hide);
  })();
</script>
{%- endunless -%}

{% schema %}
{
  "name": "Recommended Products",
  "tag": "section",
  "class": "recommended-products-section",
  "settings": [],
  "presets": [{ "name": "Recommended Products" }]
}
{% endschema %}
