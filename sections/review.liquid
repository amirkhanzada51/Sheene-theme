<style>
/* ================================
   PIXEL PERFECT CUSTOMER REVIEWS
   ================================ */

.mb-cr,
.mb-cr * {
  box-sizing: border-box;
}

.mb-cr {
  width: 100%;
  background: #fff;
  font-family: "Jost", Arial, sans-serif;
  padding: 82px 0 118px;
  overflow: hidden;
  color: #111;
}

.mb-cr-inner {
  width: calc(100% - 140px);
  max-width: 1780px;
  margin: 0 auto;
    padding: 40px 7px 8px;
}

/* HEADING — EXACT 32PX */
.mb-cr-heading {
  margin: 0 0 24px;
  font-size: 32px;
  line-height: 1.15;
  font-weight: 500;
  letter-spacing: -0.65px;
  color: #080808;
  font-family: Jost;
}

/* SLIDER */
.mb-cr-slider {
  position: relative;
  width: 100%;
}

.mb-cr-window {
  width: 100%;
  overflow: hidden;
}

.mb-cr-track {
  display: flex;
  gap: 32px;
  width: max-content;
  transition: transform .5s cubic-bezier(.22,.61,.36,1);
}

/* CARD */
.mb-cr-card {
  position: relative;
  flex: 0 0 calc((100vw - 140px - 64px) / 3);
  height: 435px;
  padding: 24px;
  background: #fff;
  border: 1px solid #d9dde7;
  border-radius: 8px;
  overflow: hidden;
}

/* TOP */
.mb-cr-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mb-cr-user {
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.mb-cr-name {
  font-size: 16px;
  line-height: 21px;
  font-weight: 600;
  color: #292929;
}

.mb-cr-verified {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-left: 5px;
  font-size: 17px;
  line-height: 21px;
  color: #7b8497;
}

.mb-cr-check {
  width: 12px;
  height: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #41669c;
  color: #fff;
  font: 700 8px/12px Arial;
}

.mb-cr-date {
  font-size: 12px;
  line-height: 21px;
  color: #7b8497;
  white-space: nowrap;
}

/* STARS */
.mb-cr-stars {
  display: flex;
  gap: 1px;
  {% comment %} margin-top: 14px; {% endcomment %}
}

.mb-cr-star {
  font: 900 29px/29px Arial, sans-serif;
  color: #050505;
}

/* TITLE */
.mb-cr-title {
  font-size: 18px;
  line-height: 1.25;
  font-weight: 600;
  letter-spacing: -.45px;
  color: #272727;
  white-space: nowrap;
  overflow: hidden;
}

/* TEXT */
.mb-cr-text {
  max-width: 470px;
  font-size: 14px;
  line-height: 1.62;
  font-weight: 400;
  color: #616161;
}

/* PRODUCT */
.mb-cr-product {
  position: absolute;
  left: 32px;
  right: 32px;
  bottom: 20px;
  display: flex;
  align-items: center;
}

.mb-cr-product-img {
  width: 45px;
  height: 45px;
  flex: 0 0 45px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f2f2;
  border-radius: 2px;
  overflow: hidden;
}

.mb-cr-product-img img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.mb-cr-product-name {
  margin: 0 0 0 9px;
  font-size: 14px;
  line-height: 1.25;
  color: #7b8497;
}

/* ARROWS */
.mb-cr-arrow {
  position: absolute;
  z-index: 10;
  top: 191px;

  width: 39px;
  height: 39px;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 0;
  border: 0;
  border-radius: 50%;

  background: #fff;
  color: #30345d;

  box-shadow:
    0 6px 20px rgba(0,0,0,.10),
    0 1px 5px rgba(0,0,0,.04);

  cursor: pointer;
  transition: .2s ease;
}

.mb-cr-arrow:hover {
  transform: scale(1.04);
}

.mb-cr-arrow svg {
  width: 28px;
  height: 28px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.mb-cr-prev {
  left: 32px;
}

.mb-cr-next {
  right: 32px;
}

.mb-cr-arrow.disabled {
  opacity: .35;
  pointer-events: none;
}


/* TABLET */
@media(max-width:1199px) {

  .mb-cr-inner {
    width: calc(100% - 70px);
  }

  .mb-cr-card {
    flex-basis: calc((100vw - 70px - 32px) / 2);
  }
}


/* MOBILE */
@media(max-width:767px) {

  .mb-cr {
    padding: 48px 0 70px;
  }

  .mb-cr-inner {
    width: calc(100% - 32px);
  }

  .mb-cr-heading {
    font-size: 32px;
    margin-bottom: 30px;
  }

  .mb-cr-card {
    flex-basis: calc(100vw - 32px);
    height: 405px;
    padding: 27px 24px 25px;
  }

  .mb-cr-name {
    font-size: 16px;
  }

  .mb-cr-verified {
    font-size: 15px;
  }

  .mb-cr-date {
    font-size: 14px;
  }

  .mb-cr-star {
    font-size: 27px;
  }

  .mb-cr-title {
    font-size: 20px;
  }

  .mb-cr-text {
    font-size: 16px;
  }

  .mb-cr-product {
    left: 24px;
    right: 24px;
    bottom: 24px;
  }

  .mb-cr-product-name {
    font-size: 16px;
  }

  .mb-cr-arrow {
    width: 48px;
    height: 48px;
    top: 175px;
  }

  .mb-cr-prev {
    left: -10px;
  }

  .mb-cr-next {
    right: -10px;
  }
}
</style>


