<script>
(function () {

  const track = document.getElementById("MBCRTrack");
  const prev = document.getElementById("MBCRPrev");
  const next = document.getElementById("MBCRNext");

  if (!track || !prev || !next) return;

  let index = 0;


  function visibleCards() {

    if (window.innerWidth <= 767) {
      return 1;
    }

    if (window.innerWidth <= 1199) {
      return 2;
    }

    return 3;
  }


  function cardStep() {

    const card = track.querySelector(".mb-cr-card");

    if (!card) return 0;

    const gap = parseFloat(
      getComputedStyle(track).gap
    ) || 0;

    return card.offsetWidth + gap;
  }


  function maxIndex() {

    const total =
      track.querySelectorAll(".mb-cr-card").length;

    const visible = visibleCards();

    return Math.max(
      0,
      Math.ceil(total / visible) - 1
    );
  }


  function update() {

    const visible = visibleCards();
    const step = cardStep();

    const max = maxIndex();

    if (index > max) {
      index = max;
    }

    track.style.transform =
      "translateX(-" +
      (index * step * visible) +
      "px)";


    if (index === 0) {
      prev.classList.add("disabled");
    } else {
      prev.classList.remove("disabled");
    }


    if (index >= max) {
      next.classList.add("disabled");
    } else {
      next.classList.remove("disabled");
    }
  }


  next.addEventListener("click", function () {

    if (index < maxIndex()) {
      index++;
      update();
    }

  });


  prev.addEventListener("click", function () {

    if (index > 0) {
      index--;
      update();
    }

  });


  window.addEventListener("resize", function () {
    index = 0;
    update();
  });


  update();

})();
</script>