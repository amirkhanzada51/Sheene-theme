<style>

/* =========================================================
   SHOP BY CATEGORY
   FINAL VERSION
   CARD IMAGE: 277px × 208px
   DESKTOP: 4 ITEMS
   TOTAL: 8 ITEMS
   MOBILE: RESPONSIVE
   FONT: JOST

   LARGE LEFT / RIGHT ARROWS REMOVED
   ONLY BOTTOM CONTROLS REMAIN
   ========================================================= */

.custom-category-section {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;

  padding: 40px 0;
  margin: 0;

  background: #fff;

  overflow: hidden;
}

.custom-category-section *,
.custom-category-section *::before,
.custom-category-section *::after {
  box-sizing: border-box;
}


/* =========================================================
   INNER CONTAINER
   ========================================================= */

.custom-category-section__inner {
  width: 100%;
  max-width: 100%;

  margin: 0 auto;

  padding: 0 40px;
}


/* =========================================================
   HEADING
   ========================================================= */

.custom-category-section__heading {
  margin: 0 0 34px;
  padding: 0;

  font-family: Jost, sans-serif;

  font-size: 32px;
  line-height: 1.2;

  font-weight: 500;

  color: #111;

  text-align: left;

  letter-spacing: 0;
}


/* =========================================================
   SLIDER WRAPPER
   ========================================================= */

.custom-category-section__slider-wrapper {
  position: relative;

  width: 100%;

  overflow: hidden;
}


/* =========================================================
   SLIDER TRACK
   ========================================================= */

.custom-category-section__track {
  display: flex;

  align-items: flex-start;

  gap: 24px;

  width: max-content;

  margin: 0;
  padding: 0;

  transform: translate3d(0, 0, 0);

  transition:
    transform 0.55s cubic-bezier(.22, .61, .36, 1);

  will-change: transform;
}


/* =========================================================
   CATEGORY CARD
   ========================================================= */

.custom-category-card {
  flex: 0 0 277px;

  width: 277px;

  min-width: 277px;

  display: flex;

  flex-direction: column;

  align-items: center;

  text-decoration: none;

  color: inherit;

  cursor: pointer;
}


/* =========================================================
   CATEGORY IMAGE
   EXACT SIZE: 277 × 208
   ========================================================= */

.custom-category-card__image-wrapper {
  position: relative;

  width: 277px;
  height: 208px;

  flex: 0 0 208px;

  overflow: hidden;

  background: #eeeeee;
}


.custom-category-card__image {
  display: block;

  width: 277px;
  height: 208px;

  max-width: none;
  max-height: none;

  object-fit: cover;
  object-position: center center;

  margin: 0;
  padding: 0;

  border: 0;

  vertical-align: middle;

  user-select: none;
  -webkit-user-drag: none;

  transition: transform 0.35s ease;
}


/* =========================================================
   CATEGORY NAME
   BELOW IMAGE
   ========================================================= */

.custom-category-card__name {
  width: 100%;

  margin: 18px 0 0;
  padding: 0;

  font-family: Jost, sans-serif;

  font-size: 16px;
  line-height: 1.3;

  font-weight: 400;

  color: #111;

  text-align: center;

  letter-spacing: 0;

  white-space: normal;
}


/* =========================================================
   BOTTOM SLIDER CONTROLS
   ONLY CONTROLS REMAIN
   ========================================================= */

.custom-category-section__controls {
  display: flex;

  align-items: center;
  justify-content: center;

  gap: 14px;

  width: 100%;

  margin-top: 30px;
}


/* =========================================================
   SMALL PREVIOUS / NEXT ARROWS
   ========================================================= */

.custom-category-section__control-arrow {
  width: 18px;
  height: 18px;

  padding: 0;
  margin: 0;

  border: 0;

  background: transparent;

  display: flex;

  align-items: center;
  justify-content: center;

  cursor: pointer;

  appearance: none;
  -webkit-appearance: none;

  outline: none;
}


.custom-category-section__control-arrow:hover {
  background: transparent;
}


.custom-category-section__control-arrow svg {
  width: 15px;
  height: 15px;

  display: block;

  fill: none;

  stroke: #222;

  stroke-width: 1.5;

  stroke-linecap: round;
  stroke-linejoin: round;
}


/* =========================================================
   SLIDER INDICATOR
   ========================================================= */

.custom-category-section__pagination {
  display: flex;

  align-items: center;

  gap: 0;

  width: 90px;
  height: 8px;

  overflow: hidden;

  border-radius: 10px;

  background: #e8e8e8;
}


.custom-category-section__pagination-bar {
  display: block;

  width: 45px;
  height: 8px;

  border-radius: 10px;

  background: #000;

  transition:
    transform 0.55s cubic-bezier(.22, .61, .36, 1);
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  .custom-category-section {
    padding-top: 40px;
    padding-bottom: 40px;
  }


  .custom-category-section__inner {
    padding-left: 12px;
    padding-right: 12px;
  }


  .custom-category-section__heading {
    font-size: 32px;

    margin-bottom: 28px;
  }


  .custom-category-section__slider-wrapper {
    width: 100%;
  }


  .custom-category-section__track {
    gap: 12px;
  }


  /* =======================================================
     MOBILE CARD
     ======================================================= */

  .custom-category-card {
    flex: 0 0 calc((100vw - 36px) / 2);

    width: calc((100vw - 36px) / 2);

    min-width: calc((100vw - 36px) / 2);
  }


  /* =======================================================
     MOBILE IMAGE
     ======================================================= */

  .custom-category-card__image-wrapper {
    width: 100%;
    height: auto;

    aspect-ratio: 277 / 208;

    flex: 0 0 auto;
  }


  .custom-category-card__image {
    width: 100%;
    height: 100%;

    object-fit: cover;
  }


  /* =======================================================
     MOBILE CATEGORY NAME
     ======================================================= */

  .custom-category-card__name {
    margin-top: 13px;

    font-size: 16px;

    line-height: 1.3;
  }


  /* =======================================================
     BOTTOM CONTROLS
     ======================================================= */

  .custom-category-section__controls {
    margin-top: 27px;

    gap: 12px;
  }

}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media screen and (max-width: 380px) {

  .custom-category-section__inner {
    padding-left: 8px;
    padding-right: 8px;
  }


  .custom-category-section__heading {
    font-size: 30px;

    margin-bottom: 25px;
  }


  .custom-category-section__track {
    gap: 10px;
  }


  .custom-category-card {
    flex: 0 0 calc((100vw - 26px) / 2);

    width: calc((100vw - 26px) / 2);

    min-width: calc((100vw - 26px) / 2);
  }


  .custom-category-card__name {
    font-size: 16px;

    margin-top: 11px;
  }

}


/* =========================================================
   PREVENT OVERFLOW
   ========================================================= */

.custom-category-section {
  contain: layout paint;
}

</style>


<section
  class="custom-category-section"
  id="CustomCategorySection-{{ section.id }}"
>

  <div class="custom-category-section__inner">


    <!-- =====================================================
         HEADING
         ===================================================== -->

    <h2 class="custom-category-section__heading">
      {{ section.settings.heading }}
    </h2>


    <!-- =====================================================
         CATEGORY SLIDER
         ===================================================== -->

    <div class="custom-category-section__slider-wrapper">


      <!-- ===================================================
           TRACK
           LARGE LEFT / RIGHT ARROWS REMOVED
           =================================================== -->

      <div
        class="custom-category-section__track"
        data-category-track
      >

        {% for block in section.blocks %}

          {% if block.settings.image != blank %}

            <a
              href="{{ block.settings.link | default: '#' }}"
              class="custom-category-card"
              {{ block.shopify_attributes }}
            >

              <!-- =========================================
                   IMAGE
                   NO TEXT OVER IMAGE
                   ========================================= -->

              <div class="custom-category-card__image-wrapper">

                <img
                  class="custom-category-card__image"
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="277"
                  height="208"
                  draggable="false"
                >

              </div>


              <!-- =========================================
                   CATEGORY NAME BELOW IMAGE
                   ========================================= -->

              <div class="custom-category-card__name">
                {{ block.settings.title }}
              </div>

            </a>

          {% endif %}

        {% endfor %}

      </div>

    </div>


    <!-- =====================================================
         BOTTOM SLIDER CONTROLS
         ONLY LEFT / RIGHT ARROWS HERE
         ===================================================== -->

    <div class="custom-category-section__controls">


      <!-- PREVIOUS -->

      <button
        type="button"
        class="custom-category-section__control-arrow"
        data-category-prev-bottom
        aria-label="Previous categories"
      >

        <svg viewBox="0 0 24 24">
          <path d="M14 5L7 12L14 19"></path>
        </svg>

      </button>


      <!-- PAGINATION -->

      <div
        class="custom-category-section__pagination"
        aria-hidden="true"
      >

        <span
          class="custom-category-section__pagination-bar"
          data-category-pagination
        ></span>

      </div>


      <!-- NEXT -->

      <button
        type="button"
        class="custom-category-section__control-arrow"
        data-category-next-bottom
        aria-label="Next categories"
      >

        <svg viewBox="0 0 24 24">
          <path d="M10 5L17 12L10 19"></path>
        </svg>

      </button>


    </div>

  </div>

</section>


<script>

(function () {

  function initCategorySlider() {

    var sections =
      document.querySelectorAll(
        '.custom-category-section'
      );


    sections.forEach(function (section) {


      /* =====================================================
         PREVENT DUPLICATE INITIALIZATION
         ===================================================== */

      if (
        section.dataset.initialized === 'true'
      ) {
        return;
      }


      section.dataset.initialized = 'true';


      /* =====================================================
         ELEMENTS
         ===================================================== */

      var track =
        section.querySelector(
          '[data-category-track]'
        );


      var cards =
        Array.from(
          section.querySelectorAll(
            '.custom-category-card'
          )
        );


      var nextBottom =
        section.querySelector(
          '[data-category-next-bottom]'
        );


      var prevBottom =
        section.querySelector(
          '[data-category-prev-bottom]'
        );


      var pagination =
        section.querySelector(
          '[data-category-pagination]'
        );


      if (
        !track ||
        !cards.length
      ) {
        return;
      }


      /* =====================================================
         CURRENT SLIDE
         ===================================================== */

      var currentSlide = 0;


      /* =====================================================
         HOW MANY ITEMS ARE VISIBLE
         ===================================================== */

      function getVisibleItems() {

        if (
          window.innerWidth <= 749
        ) {

          return 2;

        }

        return 4;

      }


      /* =====================================================
         TOTAL SLIDES
         ===================================================== */

      function getTotalSlides() {

        var visible =
          getVisibleItems();


        return Math.max(
          1,
          Math.ceil(
            cards.length / visible
          )
        );

      }


      /* =====================================================
         GET GAP
         ===================================================== */

      function getGap() {

        if (
          window.innerWidth <= 749
        ) {

          return 12;

        }

        return 24;

      }


      /* =====================================================
         UPDATE SLIDER
         ===================================================== */

      function updateSlider(
        animate
      ) {

        var visible =
          getVisibleItems();


        var gap =
          getGap();


        var totalSlides =
          getTotalSlides();


        /* ===================================================
           KEEP CURRENT SLIDE IN RANGE
           =================================================== */

        if (
          currentSlide >= totalSlides
        ) {

          currentSlide =
            totalSlides - 1;

        }


        if (
          currentSlide < 0
        ) {

          currentSlide = 0;

        }


        /* ===================================================
           GET ACTUAL CARD WIDTH
           =================================================== */

        var cardWidth =
          cards[0].getBoundingClientRect().width;


        /* ===================================================
           CALCULATE MOVEMENT
           =================================================== */

        var moveAmount =
          currentSlide *
          visible *
          (cardWidth + gap);


        /* ===================================================
           LAST SLIDE ALIGNMENT
           =================================================== */

        var maxMove =
          track.scrollWidth -
          track.parentElement.clientWidth;


        if (
          moveAmount > maxMove
        ) {

          moveAmount =
            Math.max(
              0,
              maxMove
            );

        }


        /* ===================================================
           TRANSITION
           =================================================== */

        if (animate === false) {

          track.style.transition =
            'none';

        } else {

          track.style.transition =
            'transform 0.55s cubic-bezier(.22,.61,.36,1)';

        }


        /* ===================================================
           APPLY TRANSFORM
           =================================================== */

        track.style.transform =
          'translate3d(-' +
          moveAmount +
          'px, 0, 0)';


        /* ===================================================
           PAGINATION
           =================================================== */

        if (pagination) {

          if (
            currentSlide === 0
          ) {

            pagination.style.transform =
              'translateX(0)';

          } else {

            pagination.style.transform =
              'translateX(45px)';

          }

        }


        /* ===================================================
           DISABLE CONTROLS IF ONLY ONE SLIDE
           =================================================== */

        var disabled =
          totalSlides <= 1;


        [
          nextBottom,
          prevBottom
        ].forEach(
          function (button) {

            if (!button) {
              return;
            }

            button.disabled =
              disabled;

            button.style.opacity =
              disabled ? '0.35' : '1';

            button.style.pointerEvents =
              disabled ? 'none' : 'auto';

          }
        );

      }


      /* =====================================================
         GO TO SLIDE
         ===================================================== */

      function goToSlide(
        slide
      ) {

        var totalSlides =
          getTotalSlides();


        if (
          totalSlides <= 1
        ) {

          return;

        }


        if (
          slide < 0
        ) {

          slide =
            totalSlides - 1;

        }


        if (
          slide >= totalSlides
        ) {

          slide = 0;

        }


        currentSlide =
          slide;


        updateSlider(true);

      }


      /* =====================================================
         NEXT
         ===================================================== */

      function nextSlide() {

        goToSlide(
          currentSlide + 1
        );

      }


      /* =====================================================
         PREVIOUS
         ===================================================== */

      function previousSlide() {

        goToSlide(
          currentSlide - 1
        );

      }


      /* =====================================================
         BOTTOM NEXT BUTTON
         ===================================================== */

      if (nextBottom) {

        nextBottom.addEventListener(
          'click',
          function (event) {

            event.preventDefault();

            event.stopPropagation();

            nextSlide();

          }
        );

      }


      /* =====================================================
         BOTTOM PREVIOUS BUTTON
         ===================================================== */

      if (prevBottom) {

        prevBottom.addEventListener(
          'click',
          function (event) {

            event.preventDefault();

            event.stopPropagation();

            previousSlide();

          }
        );

      }


      /* =====================================================
         RESPONSIVE RESIZE
         ===================================================== */

      var resizeTimer = null;


      window.addEventListener(
        'resize',
        function () {

          clearTimeout(
            resizeTimer
          );


          resizeTimer =
            setTimeout(
              function () {

                var totalSlides =
                  getTotalSlides();


                if (
                  currentSlide >=
                  totalSlides
                ) {

                  currentSlide =
                    Math.max(
                      0,
                      totalSlides - 1
                    );

                }


                updateSlider(false);


                /* Restore transition */

                requestAnimationFrame(
                  function () {

                    track.style.transition =
                      'transform 0.55s cubic-bezier(.22,.61,.36,1)';

                  }
                );

              },
              100
            );

        }
      );


      /* =====================================================
         TOUCH SWIPE
         MOBILE FRIENDLY
         ===================================================== */

      var touchStartX = 0;
      var touchEndX = 0;


      track.addEventListener(
        'touchstart',
        function (event) {

          if (
            !event.touches ||
            !event.touches.length
          ) {
            return;
          }


          touchStartX =
            event.touches[0].clientX;

        },
        {
          passive: true
        }
      );


      track.addEventListener(
        'touchend',
        function (event) {

          if (
            !event.changedTouches ||
            !event.changedTouches.length
          ) {
            return;
          }


          touchEndX =
            event.changedTouches[0].clientX;


          var difference =
            touchStartX -
            touchEndX;


          /* Minimum swipe distance */

          if (
            Math.abs(difference) < 45
          ) {
            return;
          }


          if (
            difference > 0
          ) {

            nextSlide();

          } else {

            previousSlide();

          }

        },
        {
          passive: true
        }
      );


      /* =====================================================
         INITIAL POSITION
         ===================================================== */

      setTimeout(
        function () {

          updateSlider(false);

        },
        100
      );

    });

  }


  /* =========================================================
     INITIAL LOAD
     ========================================================= */

  if (
    document.readyState === 'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initCategorySlider
    );

  } else {

    initCategorySlider();

  }


  /* =========================================================
     SHOPIFY THEME EDITOR
     ========================================================= */

  document.addEventListener(
    'shopify:section:load',
    function () {

      var sections =
        document.querySelectorAll(
          '.custom-category-section'
        );


      sections.forEach(
        function (section) {

          section.dataset.initialized =
            'false';

        }
      );


      initCategorySlider();

    }
  );

})();

</script>


{% schema %}

{
  "name": "Shop by Category",
  "settings": [
    {
