{% comment %}
==========================================================================
  SHEENE - Cart rewards card (cart drawer + cart page)
==========================================================================

  Snippet ka naam:  sheene-cart-perks

  ISTEMAAL
  --------
  snippets/cart-summary.liquid mein, <div class="cart-totals"> ke theek
  neeche ek line:

      {% render 'sheene-cart-perks' %}

  layout/theme.liquid mein is snippet ki koi line NAHI honi chahiye.

  Ye Horizon ke cart summary ke andar hi render hota hai, is liye:
  - Cart drawer aur cart page dono mein, Estimated total ke upar aata hai.
  - Cart badalne par Horizon summary dobara render karta hai, card bhi
    naye subtotal ke saath khud update ho jata hai. Koi JavaScript nahi.
  - Cart khali ho to summary hi nahi banti, card bhi nahi.

  Hisaab cart ke subtotal par (discount se pehle), jaise Shopify discount
  ki minimum check karta hai. Thresholds product page wale hi rakhna.
{% endcomment %}

{% liquid
  # ---- thresholds PKR mein (product page jaise) ----
  assign FREE_DELIVERY_MIN = 2500
  assign TESTERS_MIN = 4000
  assign DISCOUNT_MIN = 2500

  assign FREE_DELIVERY_LABEL = 'Free Delivery'
  assign TESTERS_LABEL = 'Free 5 ml tester 2 bottles'
  assign DISCOUNT_LABEL = 'Extra 10% off'
  assign PERK_MET_TEXT = 'Unlocked'
  assign PERK_ALWAYS_TEXT = 'On all orders'
  assign PERKS_AWAY_TEXT = 'away from'
  assign PERKS_ALL_TEXT = 'All rewards unlocked on your order'

  assign sub = cart.items_subtotal_price | default: 0
  assign fd = FREE_DELIVERY_MIN | times: 100
  assign ts = TESTERS_MIN | times: 100
  assign dc = DISCOUNT_MIN | times: 100

  # agla reward jo abhi lock hai (sab se kam threshold)
  assign next_min = 0
  assign next_label = ''
  if fd > sub
    assign next_min = fd
    assign next_label = FREE_DELIVERY_LABEL
  endif
  if dc > sub
    if next_min == 0 or dc < next_min
      assign next_min = dc
      assign next_label = DISCOUNT_LABEL
    endif
  endif
  if ts > sub
    if next_min == 0 or ts < next_min
      assign next_min = ts
      assign next_label = TESTERS_LABEL
    endif
  endif

  assign progress = 100
  if next_min > 0
    assign progress = sub | times: 100 | divided_by: next_min
  endif

  assign perk_mins = fd | append: ',' | append: ts | append: ',' | append: dc | split: ','
  assign perk_labels = FREE_DELIVERY_LABEL | append: '|' | append: TESTERS_LABEL | append: '|' | append: DISCOUNT_LABEL | split: '|'
%}

<div class="sh-cp">
  <div class="sh-cp__head">
    <p class="sh-cp__msg">
      {%- if next_min == 0 -%}
        <strong>{{ PERKS_ALL_TEXT }}</strong>
      {%- else -%}
        {%- assign away = next_min | minus: sub -%}
        <strong>{{ away | money_without_trailing_zeros }}</strong> {{ PERKS_AWAY_TEXT }} <strong>{{ next_label }}</strong>
      {%- endif -%}
    </p>
    <div class="sh-cp__bar" aria-hidden="true">
      <span class="sh-cp__fill{% if next_min == 0 %} is-complete{% endif %}" style="width: {{ progress }}%;"></span>
    </div>
  </div>

  <ul class="sh-cp__list">
    {%- for m in perk_mins -%}
      {%- assign min = m | times: 1 -%}
      {%- assign label = perk_labels[forloop.index0] -%}
      <li class="sh-cp__perk{% if sub >= min %} is-met{% endif %}">
        <span class="sh-cp__icon" aria-hidden="true">
          {%- case forloop.index -%}
            {%- when 1 -%}<svg viewBox="0 0 24 24"><path d="M2.75 6.25h10.5v9.5H2.75z"/><path d="M13.25 9.75h3.4l3.6 3.4v2.6h-7z"/><circle cx="6.75" cy="17.75" r="1.6"/><circle cx="16.75" cy="17.75" r="1.6"/><path d="M8.35 17.75h6.8"/></svg>
            {%- when 2 -%}<svg viewBox="0 0 24 24"><path d="M9.5 3h5M10.5 3v3.5h3V3"/><path d="M9 6.5h6a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V7.5a1 1 0 0 1 1-1z"/><path d="M8 12h8"/></svg>
            {%- else -%}<svg viewBox="0 0 24 24"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="7" cy="7" r="2.5"/><circle cx="17" cy="17" r="2.5"/></svg>
          {%- endcase -%}
        </span>
        <span class="sh-cp__label">{{ label }}</span>
        <span class="sh-cp__status">
          {%- if min == 0 -%}
            {{ PERK_ALWAYS_TEXT }}
          {%- elsif sub >= min -%}
            {{ PERK_MET_TEXT }}
          {%- else -%}
            {%- assign gap = min | minus: sub -%}
            Add {{ gap | money_without_trailing_zeros }} more
          {%- endif -%}
        </span>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .sh-cp {
    --sh-cp-ok: #2E7D4F;
    --sh-cp-no: #C0392B;
    --sh-cp-hair: rgb(17 17 17 / 0.12);
    width: 100%;
    border: 1px solid var(--sh-cp-hair);
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    color: #111;
    font-family: var(--font-body--family, "Jost", sans-serif);
    text-align: left;
  }
  .sh-cp__head { padding: 12px 14px; background: #F7F7F5; }
  .sh-cp__msg { margin: 0 0 8px; font-size: 14px; line-height: 1.35; color: rgb(17 17 17 / 0.75); }
  .sh-cp__msg strong { color: #111; font-weight: 700; }
  .sh-cp__bar { height: 6px; border-radius: 999px; background: rgb(17 17 17 / 0.1); overflow: hidden; }
  .sh-cp__fill { display: block; height: 100%; border-radius: inherit; background: #111; transition: width .45s ease; }
  .sh-cp__fill.is-complete { background: var(--sh-cp-ok); }

  .sh-cp__list { list-style: none; margin: 0; padding: 0; }
  .sh-cp__perk {
    --c: var(--sh-cp-no);
    --bg: rgb(192 57 43 / 0.09);
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 14px;
    border-top: 1px solid var(--sh-cp-hair);
  }
  .sh-cp__perk.is-met { --c: var(--sh-cp-ok); --bg: rgb(46 125 79 / 0.1); }
  .sh-cp__icon {
    flex: 0 0 auto;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--bg);
    color: var(--c);
  }
  .sh-cp__icon svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .sh-cp__label { flex: 1 1 auto; min-width: 0; font-weight: 600; font-size: 14px; line-height: 1.25; }
  .sh-cp__status {
    flex: 0 0 auto;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--bg);
    color: var(--c);
    font-weight: 600;
    font-size: 12px;
    line-height: 1.2;
    white-space: nowrap;
  }

  /* drawer mein thoda compact, aur Horizon ke fade mask se bahar */
  .cart-drawer__summary .sh-cp { margin-top: 4px; }

  @media screen and (max-width: 400px) {
    .sh-cp__perk { padding: 8px 12px; gap: 8px; }
    .sh-cp__label { font-size: 13px; }
    .sh-cp__status { padding: 4px 8px; }
  }
{% endstylesheet %}
