{% comment %}
  ==========================================================
  SHEENE - Product Grid  (reusable)
  File: snippets/sheene-product-grid.liquid
  ==========================================================

  Ek hi snippet, jitni baar chaho use karo. Har jagah alag
  collection, alag title, alag View all link.

  ----------------------------------------------------------
  KAISE CALL KARO (Custom Liquid block mein)
  ----------------------------------------------------------

  Best Sellers (assets ke saath, yeh page par pehla hona chahiye):

    {% raw %}{% render 'sheene-product-grid',
      collection: 'best-sellers',
      heading: 'Our Best Sellers',
      badge_text: 'Best Seller'
    %}{% endraw %}

  Bundles (assets: false, kyunki CSS aur JS upar aa chuke hain):

    {% raw %}{% render 'sheene-product-grid',
      collection: 'bundles',
      heading: 'Shop Bundles',
      badge_text: 'Bundle',
      limit: 6,
      mobile_limit: 4,
      view_all_text: 'View all bundles',
      assets: false
    %}{% endraw %}

  New Arrivals, badge ke baghair:

    {% raw %}{% render 'sheene-product-grid',
      collection: 'new-arrivals',
      heading: 'New Arrivals',
      show_badge: false,
      assets: false
    %}{% endraw %}

  ----------------------------------------------------------
  SAARE PARAMETERS
  ----------------------------------------------------------

  collection       collection ka handle. Default 'best-sellers'.
                   Handle URL se milta hai: /collections/bundles -> 'bundles'

  heading          upar ka title. Default 'Our Best Sellers'.
                   heading: '' bhejo to title bilkul nahi aayega.

  limit            desktop par kitne products. Default 8.

  mobile_limit     mobile par kitne products. Default 4.
                   Ye Liquid se class lagti hai, is liye har instance
                   ka apna alag number ho sakta hai.

  badge_text       card ke corner ka badge. Default 'Best Seller'.
  show_badge       false bhejo to badge bilkul nahi aayega.

  view_all_url     View all button kahan jaye.
                   Default: usi collection ka page.
                   Koi bhi URL de sakte ho, jaise '/pages/shop-bundles'
  view_all_text    button ka text. Default 'View all products'.
  show_view_all    false bhejo to button hi nahi aayega.

  ratio            image box ka ratio. Default '1 / 1'.
                     1024x1024  ->  '1 / 1'
                     1200x1800  ->  '2 / 3'
                     1600x2000  ->  '4 / 5'

  columns          desktop par kitne per row. Default 4.

  assets           CSS aur JS include karna hai ya nahi. Default true.
                   IMPORTANT: ek page par sirf PEHLE render mein true
                   rakho, baaki sab mein assets: false. Warna wahi CSS
                   aur JS do teen baar load hoga.

  ----------------------------------------------------------
  NOTE
  ----------------------------------------------------------
  Rating asli hai. Jis product par Judge.me ya Loox ka rating
  metafield nahi, us card par stars nahi aati. Koi hardcoded
  stars nahi hain.
{% endcomment %}

{% liquid
  assign col_handle = collection | default: 'best-sellers'
  assign col = collections[col_handle]

  assign grid_limit = limit | default: 8
  assign grid_mobile_limit = mobile_limit | default: 4
  assign grid_columns = columns | default: 4
  assign grid_ratio = ratio | default: '1 / 1'

  assign badge_label = badge_text | default: 'Best Seller'
  assign badge_on = true
  if show_badge == false
    assign badge_on = false
  endif

  assign heading_text = 'Our Best Sellers'
  if heading != nil
    assign heading_text = heading
  endif

  assign va_url = view_all_url | default: col.url
  assign va_text = view_all_text | default: 'View all products'
  assign va_on = true
  if show_view_all == false
    assign va_on = false
  endif

  assign assets_on = true
  if assets == false
    assign assets_on = false
  endif

  assign uid = col_handle | handle
%}

{%- if assets_on -%}
<style>
/* =========================================================
   SHEENE PRODUCT GRID - shared styles
   Ye ek hi baar load hote hain. Doosre render mein
   assets: false bhejna.
   ========================================================= */
.custom-best-sellers {
  --bs-image-ratio: 1 / 1;
  --bs-columns: 4;
  --bs-col-gap: 24px;
  --bs-row-gap: 52px;

  width: 100%;
  max-width: 100%;
  margin: 0;
  padding: 40px 7px 8px;
  background: #fff;
  box-sizing: border-box;
}
.custom-best-sellers *,
.custom-best-sellers *::before,
.custom-best-sellers *::after {
  box-sizing: border-box;
}
/* ---------------- HEADING ---------------- */
.custom-best-sellers__heading {
  margin: 0 0 34px;
  padding: 0;
  font-size: 32px;
  line-height: 1.2;
  font-weight: 500;
  color: #111;
  text-align: left;
  letter-spacing: -0.5px;
}
/* ---------------- GRID ---------------- */
.custom-best-sellers__grid {
  display: grid;
  grid-template-columns: repeat(var(--bs-columns), minmax(0, 1fr));
  column-gap: var(--bs-col-gap);
  row-gap: var(--bs-row-gap);
  width: 100%;
  margin: 0;
  padding: 0;
  align-items: stretch;
}
/* ---------------- CARD ---------------- */
.custom-best-sellers__card {
  position: relative;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #fff;
}
/* ---------------- IMAGE BOX ---------------- */
.custom-best-sellers__image-box {
  position: relative;
  width: 100%;
  aspect-ratio: var(--bs-image-ratio);
  background: #e9edef;
  overflow: hidden;
}
.custom-best-sellers__image-link {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  text-decoration: none;
  overflow: hidden;
  z-index: 1;
}
.custom-best-sellers__image-track {
  display: flex;
  flex-wrap: nowrap;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  transform: translate3d(0, 0, 0);
  transition: transform 0.45s cubic-bezier(.22, .61, .36, 1);
  will-change: transform;
}
.custom-best-sellers__image-slide {
  position: relative;
  flex: 0 0 100%;
  width: 100%;
  height: 100%;
  min-width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.custom-best-sellers__image {
  display: block;
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  object-position: center center;
  margin: 0;
  padding: 0;
  border: 0;
  vertical-align: middle;
  user-select: none;
  -webkit-user-drag: none;
  transition: transform 0.38s ease;
}
.custom-best-sellers__image:hover {
  transform: scale(1.025);
}
/* ---------------- BADGE ---------------- */
.custom-best-sellers__badge {
  position: absolute;
  top: 11px;
  right: 11px;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 21px;
  padding: 4px 8px;
  background: #000;
  color: #fff;
  border-radius: 10px;
  font-size: 15px;
  line-height: 1;
  font-weight: 600;
  white-space: nowrap;
}
/* ---------------- IMAGE ARROWS ---------------- */
.custom-best-sellers__image-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 40;
  width: 20px;
  height: 20px;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, .94);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
  outline: none;
  box-shadow: 0 1px 4px rgba(0, 0, 0, .06);
  transition: transform .15s ease;
}
.custom-best-sellers__image-arrow:active {
  transform: translateY(-50%) scale(.92);
}
.custom-best-sellers__image-arrow--prev { left: 7px; }
.custom-best-sellers__image-arrow--next { right: 7px; }
.custom-best-sellers__image-arrow svg {
  width: 13px;
  height: 13px;
  display: block;
  fill: none;
  stroke: #777;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
  pointer-events: none;
}
/* ---------------- IMAGE DOTS ---------------- */
.custom-best-sellers__image-dots {
  position: absolute;
  left: 50%;
  bottom: 8px;
  transform: translateX(-50%);
  z-index: 35;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3px;
  height: 7px;
  pointer-events: none;
}
.custom-best-sellers__image-dot {
  width: 4px;
  height: 4px;
  min-width: 4px;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 50%;
  background: #b9b9b9;
}
.custom-best-sellers__image-dot.is-active { background: #000; }
/* ---------------- CONTENT ---------------- */
.custom-best-sellers__content {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  width: 100%;
  min-width: 0;
  padding-top: 17px;
}
.custom-best-sellers__title {
  margin: 0;
  padding: 0;
  font-size: 18px;
  line-height: 1.25;
  font-weight: 600;
  color: #111;
  letter-spacing: 0;
  white-space: normal;
}
.custom-best-sellers__title a {
  color: inherit;
  text-decoration: none;
}
.custom-best-sellers__description {
  margin-top: 7px;
  min-height: 20px;
  overflow: hidden;
  font-size: 15px;
  line-height: 1.35;
  font-weight: 400;
  color: #858585;
}
/* ---------------- RATING ---------------- */
.custom-best-sellers__rating {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-top: 7px;
  height: 17px;
  text-decoration: none;
  color: inherit;
}
.custom-best-sellers__stars {
  position: relative;
  display: inline-block;
  font-size: 16px;
  line-height: 1;
  letter-spacing: 1px;
  white-space: nowrap;
}
.custom-best-sellers__stars-bg { color: #c9c9c9; }
.custom-best-sellers__stars-fg {
  position: absolute;
  inset: 0;
  overflow: hidden;
  width: var(--bs-rating, 0%);
  color: #000;
}
.custom-best-sellers__rating-count {
  font-size: 13px;
  line-height: 1;
  color: #858585;
}
/* ---------------- PRICE ---------------- */
.custom-best-sellers__price-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 8px;
  min-height: 21px;
}
.custom-best-sellers__price {
  font-size: 15px;
  line-height: 1.35;
  font-weight: 500;
  color: #111;
}
.custom-best-sellers__compare {
  font-size: 15px;
  line-height: 1.35;
  font-weight: 400;
  color: #888;
  text-decoration: line-through;
}
/* ---------------- VARIANTS ---------------- */
.custom-best-sellers__variants {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 10px;
  min-height: 30px;
}
.custom-best-sellers__variant {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 22px;
  padding: 3px 12px;
  border: 1px solid #bdbdbd;
  border-radius: 15px;
  background: #fff;
  color: #222;
  font-size: 15px;
  line-height: 1.2;
  font-weight: 400;
  white-space: nowrap;
  cursor: pointer;
  font-family: inherit;
  appearance: none;
  -webkit-appearance: none;
  outline: none;
  transition:
    background .15s ease,
    color .15s ease,
    border-color .15s ease;
}
.custom-best-sellers__variant.is-selected {
  background: #000;
  border-color: #000;
  color: #fff;
  font-weight: 600;
}
.custom-best-sellers__variant:disabled {
  opacity: .4;
  cursor: not-allowed;
}
/* ---------------- CART ---------------- */
.custom-best-sellers__cart-form {
  width: 100%;
  margin: auto 0 0;
  padding: 0;
}
.custom-best-sellers__add {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 10px;
  padding: 14px 15px;
  min-height: 48px;
  border: 1px solid #000;
  border-radius: 0;
  background: #000;
  color: #fff;
  font-family: Jost, sans-serif;
  font-size: 16px;
  line-height: 1.2;
  font-weight: 500;
  text-align: center;
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
  outline: none;
  box-shadow: none;
  transition: none;
}
.custom-best-sellers__add:hover,
.custom-best-sellers__add:focus,
.custom-best-sellers__add:active {
  background: #000 !important;
  color: #fff !important;
  border-color: #000 !important;
  box-shadow: none !important;
}
/* ---------------- VIEW ALL ---------------- */
.custom-best-sellers__view-all-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 48px;
}
.custom-best-sellers__view-all {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 163px;
  min-height: 39px;
  padding: 14px 46px;
  border: 1px solid #111;
  background: #fff;
  color: #111;
  text-decoration: none;
  font-family: Jost, sans-serif;
  font-size: 18px;
  line-height: 1.2;
  font-weight: 400;
  transition: none;
}
.custom-best-sellers__view-all:hover,
.custom-best-sellers__view-all:focus,
.custom-best-sellers__view-all:active {
  background: #fff !important;
  color: #111 !important;
  border-color: #111 !important;
  box-shadow: none !important;
}
/* ---------------- EMPTY ---------------- */
.custom-best-sellers__empty {
  grid-column: 1 / -1;
  padding: 50px 20px;
  text-align: center;
  font-size: 16px;
}
/* ---------------- TABLET ---------------- */
@media screen and (max-width: 989px) {
  .custom-best-sellers {
    padding-left: 12px;
    padding-right: 12px;
    --bs-col-gap: 16px;
    --bs-row-gap: 42px;
  }
}
/* ---------------- MOBILE ---------------- */
@media screen and (max-width: 749px) {
  .custom-best-sellers {
    width: 100% !important;
    max-width: 100% !important;
    padding: 28px 7px 12px !important;
    margin: 0 !important;
    --bs-col-gap: 12px;
    --bs-row-gap: 34px;
  }
  .custom-best-sellers__heading {
    margin: 0 0 28px !important;
    padding: 0 !important;
    font-size: 32px !important;
    line-height: 1.2;
  }
  /* mobile par hamesha 2 per row */
  .custom-best-sellers__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  /* mobile_limit se zyada wale cards - class Liquid lagata hai */
  .custom-best-sellers__card--mobile-hide {
    display: none !important;
  }
  .custom-best-sellers__badge {
    top: 8px;
    right: 8px;
    min-height: 20px;
    padding: 4px 7px;
    font-size: 15px;
  }
  .custom-best-sellers__image-arrow { width: 20px; height: 20px; }
  .custom-best-sellers__image-arrow--prev { left: 6px; }
  .custom-best-sellers__image-arrow--next { right: 6px; }
  .custom-best-sellers__content { padding-top: 13px; }
  .custom-best-sellers__title {
    font-size: 18px !important;
    line-height: 1.25;
  }
  .custom-best-sellers__description {
    margin-top: 6px;
    min-height: 19px;
    font-size: 15px !important;
    line-height: 1.3;
  }
  .custom-best-sellers__rating { margin-top: 6px; }
  .custom-best-sellers__stars { font-size: 15px; }
  .custom-best-sellers__price-row { margin-top: 7px; gap: 5px; }
  .custom-best-sellers__price,
  .custom-best-sellers__compare { font-size: 15px !important; }
  .custom-best-sellers__variants { gap: 5px; margin-top: 9px; }
  .custom-best-sellers__variant {
    font-size: 15px !important;
    padding: 3px 9px;
  }
  .custom-best-sellers__add {
    margin-top: 9px;
    padding: 14px 15px !important;
    min-height: 0;
    font-size: 16px !important;
  }
  .custom-best-sellers__view-all-wrap { margin-top: 34px; }
  .custom-best-sellers__view-all {
    min-width: 163px;
    min-height: 39px;
    padding: 14px 30px;
    font-size: 18px;
  }
}
/* ---------------- SMALL MOBILE ---------------- */
@media screen and (max-width: 380px) {
  .custom-best-sellers {
    padding-left: 6px !important;
    padding-right: 6px !important;
    --bs-col-gap: 10px;
  }
  .custom-best-sellers__variant {
    padding-left: 7px;
    padding-right: 7px;
  }
}
/* ---------------- SAFETY ----------------
   overflow-x: clip use kiya hai, hidden nahi. hidden html/body
   par lagane se doosri jagah position: sticky toot jati hai.
   ---------------------------------------- */
html,
body {
  max-width: 100%;
  overflow-x: clip;
}
</style>
{%- endif -%}

<section
  class="custom-best-sellers"
  id="ShProductGrid-{{ uid }}"
  style="--bs-image-ratio: {{ grid_ratio }}; --bs-columns: {{ grid_columns }};"
>
  {%- if heading_text != blank -%}
    <h2 class="custom-best-sellers__heading">{{ heading_text }}</h2>
  {%- endif -%}

  <div class="custom-best-sellers__grid">
    {% if col != blank and col.products_count > 0 %}
      {% for product in col.products limit: grid_limit %}

        {% liquid
          assign rating_value = 0
          assign rating_count = 0
          if product.metafields.reviews.rating.value != blank
            assign rating_value = product.metafields.reviews.rating.value.rating | times: 1.0
            assign rating_count = product.metafields.reviews.rating_count.value | times: 1
          elsif product.metafields.loox.avg_rating != blank
            assign rating_value = product.metafields.loox.avg_rating.value | times: 1.0
            assign rating_count = product.metafields.loox.num_reviews.value | times: 1
          endif
          assign rating_percent = rating_value | times: 20.0

          assign mobile_hide = ''
          if forloop.index > grid_mobile_limit
            assign mobile_hide = ' custom-best-sellers__card--mobile-hide'
          endif
        %}

        <article class="custom-best-sellers__card{{ mobile_hide }}" data-product-card>

          <div class="custom-best-sellers__image-box" data-image-slider>

            {%- if badge_on and badge_label != blank -%}
              <span class="custom-best-sellers__badge">{{ badge_label }}</span>
            {%- endif -%}

            <a
              href="{{ product.url }}"
              class="custom-best-sellers__image-link"
              aria-label="{{ product.title | escape }}"
            >
              <div class="custom-best-sellers__image-track" data-image-track>
                {% if product.images.size > 0 %}
                  {% for image in product.images limit: 8 %}
                    <div class="custom-best-sellers__image-slide">
                      <img
                        class="custom-best-sellers__image"
                        src="{{ image | image_url: width: 800 }}"
                        srcset="
                          {{ image | image_url: width: 400 }} 400w,
                          {{ image | image_url: width: 600 }} 600w,
                          {{ image | image_url: width: 800 }} 800w,
                          {{ image | image_url: width: 1200 }} 1200w
                        "
                        sizes="(min-width: 750px) 23vw, 48vw"
                        alt="{{ image.alt | default: product.title | escape }}"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        width="{{ image.width }}"
                        height="{{ image.height }}"
                        draggable="false"
                      >
                    </div>
                  {% endfor %}
                {% elsif product.featured_image %}
                  <div class="custom-best-sellers__image-slide">
                    <img
                      class="custom-best-sellers__image"
                      src="{{ product.featured_image | image_url: width: 800 }}"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      loading="lazy"
                      width="{{ product.featured_image.width }}"
                      height="{{ product.featured_image.height }}"
                      draggable="false"
                    >
                  </div>
                {% endif %}
              </div>
            </a>

            <button
              type="button"
              class="custom-best-sellers__image-arrow custom-best-sellers__image-arrow--prev"
              aria-label="Previous product image"
              data-image-prev
            >
              <svg viewBox="0 0 24 24"><path d="M14.5 5L7.5 12L14.5 19"></path></svg>
            </button>

            <button
              type="button"
              class="custom-best-sellers__image-arrow custom-best-sellers__image-arrow--next"
              aria-label="Next product image"
              data-image-next
            >
              <svg viewBox="0 0 24 24"><path d="M9.5 5L16.5 12L9.5 19"></path></svg>
            </button>

            {% if product.images.size > 1 %}
              <div class="custom-best-sellers__image-dots" data-image-dots>
                {% for image in product.images limit: 8 %}
                  <span class="custom-best-sellers__image-dot{% if forloop.first %} is-active{% endif %}"></span>
                {% endfor %}
              </div>
            {% endif %}
          </div>

          <div class="custom-best-sellers__content">

            <h3 class="custom-best-sellers__title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>

            <div class="custom-best-sellers__description">
              {{ product.description | strip_html | truncate: 72 }}
            </div>

            {% if rating_count > 0 %}
              <a
                class="custom-best-sellers__rating"
                href="{{ product.url }}"
                aria-label="Rated {{ rating_value }} out of 5 from {{ rating_count }} reviews"
              >
                <span class="custom-best-sellers__stars" style="--bs-rating: {{ rating_percent }}%;" aria-hidden="true">
                  <span class="custom-best-sellers__stars-bg">★★★★★</span>
                  <span class="custom-best-sellers__stars-fg">★★★★★</span>
                </span>
                <span class="custom-best-sellers__rating-count">({{ rating_count }})</span>
              </a>
            {% endif %}

            <div class="custom-best-sellers__price-row">
              {% assign available_variant = product.selected_or_first_available_variant %}
              <span class="custom-best-sellers__price" data-product-price>
                {{ available_variant.price | money }}
              </span>
              <span
                class="custom-best-sellers__compare"
                data-product-compare
                {% unless available_variant.compare_at_price > available_variant.price %}style="display:none;"{% endunless %}
              >
                {%- if available_variant.compare_at_price > available_variant.price -%}
                  {{ available_variant.compare_at_price | money }}
                {%- endif -%}
              </span>
            </div>

            {% if product.variants.size > 1 %}
              <div class="custom-best-sellers__variants" data-variant-selector>
                {% for variant in product.variants %}
                  <button
                    type="button"
                    class="custom-best-sellers__variant{% if variant.id == available_variant.id %} is-selected{% endif %}"
                    data-variant-id="{{ variant.id }}"
                    data-variant-price="{{ variant.price | money | escape }}"
                    data-variant-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                    data-variant-available="{{ variant.available }}"
                    {% unless variant.available %}disabled{% endunless %}
                  >{{ variant.title }}</button>
                {% endfor %}
              </div>
            {% elsif product.variants.first.title != 'Default Title' %}
              <div class="custom-best-sellers__variants" data-variant-selector>
                <button
                  type="button"
                  class="custom-best-sellers__variant is-selected"
                  data-variant-id="{{ product.variants.first.id }}"
                  data-variant-price="{{ product.variants.first.price | money | escape }}"
                  data-variant-compare="{% if product.variants.first.compare_at_price > product.variants.first.price %}{{ product.variants.first.compare_at_price | money | escape }}{% endif %}"
                  data-variant-available="{{ product.variants.first.available }}"
                  {% unless product.variants.first.available %}disabled{% endunless %}
                >{{ product.variants.first.title }}</button>
              </div>
            {% endif %}

            <form
              action="{{ routes.cart_add_url }}"
              method="post"
              class="custom-best-sellers__cart-form"
              data-cart-form
            >
              <input
                type="hidden"
                name="id"
                value="{{ available_variant.id }}"
                data-selected-variant
              >
              <button
                type="submit"
                class="custom-best-sellers__add"
                {% unless available_variant.available %}disabled{% endunless %}
              >
                {% if available_variant.available %}Add to cart{% else %}Sold out{% endif %}
              </button>
            </form>

          </div>
        </article>
      {% endfor %}
    {% else %}
      <div class="custom-best-sellers__empty">
        Collection <strong>{{ col_handle }}</strong> nahi mili ya khaali hai.
      </div>
    {% endif %}
  </div>

  {% if va_on and col != blank and va_url != blank %}
    <div class="custom-best-sellers__view-all-wrap">
      <a href="{{ va_url }}" class="custom-best-sellers__view-all">{{ va_text }}</a>
    </div>
  {% endif %}
</section>

{%- if assets_on -%}
<script>
(function () {
  'use strict';

  function initShProductGrid() {
    document.querySelectorAll('.custom-best-sellers').forEach(function (section) {
      if (section.dataset.initialized === 'true') return;
      section.dataset.initialized = 'true';

      var cards = Array.from(section.querySelectorAll('.custom-best-sellers__card'));
      if (!cards.length) return;

      /* ---------- per card image slider ---------- */
      cards.forEach(function (card) {
        var imageBox = card.querySelector('[data-image-slider]');
        if (!imageBox) return;

        var imageTrack = imageBox.querySelector('[data-image-track]');
        var slides = Array.from(imageBox.querySelectorAll('.custom-best-sellers__image-slide'));
        var prevButton = imageBox.querySelector('[data-image-prev]');
        var nextButton = imageBox.querySelector('[data-image-next]');
        var dots = Array.from(imageBox.querySelectorAll('.custom-best-sellers__image-dot'));

        if (slides.length <= 1) {
          if (prevButton) prevButton.style.display = 'none';
          if (nextButton) nextButton.style.display = 'none';
          dots.forEach(function (dot) { dot.style.display = 'none'; });
          return;
        }

        var currentImage = 0;

        function updateImageSlider(direction) {
          if (direction === 'next') {
            currentImage = (currentImage + 1) % slides.length;
          } else if (direction === 'prev') {
            currentImage = (currentImage - 1 + slides.length) % slides.length;
          }
          imageTrack.style.transform = 'translate3d(-' + (currentImage * 100) + '%, 0, 0)';
          dots.forEach(function (dot, index) {
            dot.classList.toggle('is-active', index === currentImage);
          });
        }

        if (nextButton) {
          nextButton.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();
            updateImageSlider('next');
          });
        }
        if (prevButton) {
          prevButton.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();
            updateImageSlider('prev');
          });
        }
        [prevButton, nextButton].forEach(function (button) {
          if (!button) return;
          button.addEventListener('mousedown', function (event) {
            event.preventDefault();
          });
        });

        var startX = 0;
        imageBox.addEventListener('touchstart', function (e) {
          startX = e.touches[0].clientX;
        }, { passive: true });
        imageBox.addEventListener('touchend', function (e) {
          var dx = startX - e.changedTouches[0].clientX;
          if (Math.abs(dx) > 40) updateImageSlider(dx > 0 ? 'next' : 'prev');
        }, { passive: true });
      });

      /* ---------- variant selector ---------- */
      cards.forEach(function (card) {
        var selector = card.querySelector('[data-variant-selector]');
        var hiddenInput = card.querySelector('[data-selected-variant]');
        var addButton = card.querySelector('.custom-best-sellers__add');
        var priceElement = card.querySelector('[data-product-price]');
        var compareElement = card.querySelector('[data-product-compare]');

        if (!selector || !hiddenInput) return;

        var variants = Array.from(selector.querySelectorAll('.custom-best-sellers__variant'));

        variants.forEach(function (variant) {
          variant.addEventListener('click', function (event) {
            event.preventDefault();
            if (variant.disabled) return;

            variants.forEach(function (item) { item.classList.remove('is-selected'); });
            variant.classList.add('is-selected');

            var variantId = variant.getAttribute('data-variant-id');
            if (variantId) hiddenInput.value = variantId;

            var variantPrice = variant.getAttribute('data-variant-price');
            if (priceElement && variantPrice) priceElement.textContent = variantPrice;

            var variantCompare = variant.getAttribute('data-variant-compare');
            if (compareElement) {
              if (variantCompare) {
                compareElement.textContent = variantCompare;
                compareElement.style.display = '';
              } else {
                compareElement.textContent = '';
                compareElement.style.display = 'none';
              }
            }

            if (addButton) {
              addButton.disabled = false;
              addButton.textContent = 'Add to cart';
            }
          });
        });
      });

      /* ---------- cart form ---------- */
      section.querySelectorAll('[data-cart-form]').forEach(function (form) {
        form.addEventListener('submit', function (event) {
          var selectedVariant = form.querySelector('[data-selected-variant]');
          if (!selectedVariant || !selectedVariant.value) {
            event.preventDefault();
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShProductGrid);
  } else {
    initShProductGrid();
  }

  /* theme editor mein section reload hone par dobara bind karo */
  document.addEventListener('shopify:section:load', function (event) {
    if (event.target && event.target.querySelectorAll) {
      event.target.querySelectorAll('.custom-best-sellers').forEach(function (s) {
        s.dataset.initialized = 'false';
      });
    }
    initShProductGrid();
  });
})();
</script>
{%- endif -%}