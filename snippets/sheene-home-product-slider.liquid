{% comment %}
  ==========================================================
  SHEENE - Product Grid  (reusable)
  File: snippets/sheene-product-grid.liquid
  ==========================================================

  Ek hi snippet, jitni baar chaho use karo. Har jagah alag
  collection, alag title, alag View all link.

  ----------------------------------------------------------
  IS VERSION MEIN NAYA KYA HAI
  ----------------------------------------------------------
  Card se lambi variant pills hata di gayi hain. Ab:

    Ek hi variant           ->  seedha "Add to cart"
    Ek se zyada variants    ->  "Choose options" button, jo ek
                                popup kholta hai. Popup mein
                                image, title, price, options,
                                quantity aur Add to cart hai.

  Popup har product ke liye pehle se render hota hai (hidden),
  is liye khulne mein koi delay ya loading nahi hai. Koi
  external library nahi, native <dialog> use hua hai.

  ----------------------------------------------------------
  KAISE CALL KARO (Custom Liquid block mein)
  ----------------------------------------------------------

  Best Sellers (assets ke saath, page par pehla hona chahiye):

    {% raw %}{% render 'sheene-product-grid',
      collection: 'best-sellers',
      heading: 'Our Best Sellers',
      badge_text: 'Best Seller'
    %}{% endraw %}

  Bundles (assets: false, kyunki CSS aur JS upar aa chuke hain):

    {% raw %}{% render 'sheene-product-grid',
      collection: 'bundles',
      heading: 'Shop Bundles',
      badge_text: 'Bundle',
      limit: 6,
      mobile_limit: 4,
      view_all_text: 'View all bundles',
      assets: false
    %}{% endraw %}

  New Arrivals, badge ke baghair:

    {% raw %}{% render 'sheene-product-grid',
      collection: 'new-arrivals',
      heading: 'New Arrivals',
      show_badge: false,
      assets: false
    %}{% endraw %}

  ----------------------------------------------------------
  SAARE PARAMETERS
  ----------------------------------------------------------

  collection       collection ka handle. Default 'best-sellers'.
                   Handle URL se milta hai: /collections/bundles -> 'bundles'

  heading          upar ka title. Default 'Our Best Sellers'.
                   heading: '' bhejo to title bilkul nahi aayega.

  limit            desktop par kitne products. Default 8.

  mobile_limit     mobile par kitne products. Default 4.

  badge_text       card ke corner ka badge. Default 'Best Seller'.
  show_badge       false bhejo to badge bilkul nahi aayega.

  view_all_url     View all button kahan jaye.
                   Default: usi collection ka page.
  view_all_text    button ka text. Default 'View all products'.
  show_view_all    false bhejo to button hi nahi aayega.

  ratio            image box ka ratio. Default '1 / 1'.
                     1024x1024  ->  '1 / 1'
                     1200x1800  ->  '2 / 3'
                     1600x2000  ->  '4 / 5'

  columns          desktop par kitne per row. Default 4.

  choose_text      multi variant button ka text. Default 'Choose options'.
  add_text         single variant button ka text. Default 'Add to cart'.

  variant_box_title    popup ke variant box ka legend.
                       Default 'Choose variants'.
  option_label_prefix  option ke label ka pehla lafz.
                       Default 'Select', to label banta hai
                       "Select sizes", "Select colour" wagera.
  show_buy_now         popup mein Buy it now button.
                       Default true. false bhejo to hat jayega.

  assets           CSS aur JS include karna hai ya nahi. Default true.
                   IMPORTANT: ek page par sirf PEHLE render mein true
                   rakho, baaki sab mein assets: false.

  ----------------------------------------------------------
  NOTE
  ----------------------------------------------------------
  Rating asli hai. Jis product par Judge.me ya Loox ka rating
  metafield nahi, us card par stars nahi aati.
{% endcomment %}

{% liquid
  assign col_handle = collection | default: 'best-sellers'
  assign col = collections[col_handle]

  assign grid_limit = limit | default: 8
  assign grid_mobile_limit = mobile_limit | default: 4
  assign grid_columns = columns | default: 4
  assign grid_ratio = ratio | default: '1 / 1'

  assign badge_label = badge_text | default: 'Best Seller'
  assign badge_on = true
  if show_badge == false
    assign badge_on = false
  endif

  assign heading_text = 'Our Best Sellers'
  if heading != nil
    assign heading_text = heading
  endif

  assign va_url = view_all_url | default: col.url
  assign va_text = view_all_text | default: 'View all products'
  assign va_on = true
  if show_view_all == false
    assign va_on = false
  endif

  assign btn_choose = choose_text | default: 'Choose options'
  assign btn_add = add_text | default: 'Add to cart'

  assign vbox_legend = variant_box_title | default: 'Choose variants'
  assign vbox_prefix = option_label_prefix | default: 'Select'

  assign buy_now_on = true
  if show_buy_now == false
    assign buy_now_on = false
  endif

  assign assets_on = true
  if assets == false
    assign assets_on = false
  endif

  assign uid = col_handle | handle
%}

{%- if assets_on -%}
<style>
/* =========================================================
   SHEENE PRODUCT GRID - shared styles
   Ye ek hi baar load hote hain. Doosre render mein
   assets: false bhejna.
   ========================================================= */
.custom-best-sellers {
  --bs-image-ratio: 1 / 1;
  --bs-columns: 4;
  --bs-col-gap: 24px;
  --bs-row-gap: 52px;

  width: 100%;
  max-width: 100%;
  margin: 0;
  padding: 40px 7px 8px;
  background: #fff;
  box-sizing: border-box;
}
.custom-best-sellers *,
.custom-best-sellers *::before,
.custom-best-sellers *::after {
  box-sizing: border-box;
}
/* ---------------- HEADING ---------------- */
.custom-best-sellers__heading {
  margin: 0 0 34px;
  padding: 0;
  font-size: 32px;
  line-height: 1.2;
  font-weight: 500;
  color: #111;
  text-align: left;
  letter-spacing: -0.5px;
}
/* ---------------- GRID ---------------- */
.custom-best-sellers__grid {
  display: grid;
  grid-template-columns: repeat(var(--bs-columns), minmax(0, 1fr));
  column-gap: var(--bs-col-gap);
  row-gap: var(--bs-row-gap);
  width: 100%;
  margin: 0;
  padding: 0;
  align-items: stretch;
}
/* ---------------- CARD ---------------- */
.custom-best-sellers__card {
  position: relative;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #fff;
}
/* ---------------- IMAGE BOX ---------------- */
.custom-best-sellers__image-box {
  position: relative;
  width: 100%;
  aspect-ratio: var(--bs-image-ratio);
  background: #e9edef;
  overflow: hidden;
}
.custom-best-sellers__image-link {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  text-decoration: none;
  overflow: hidden;
  z-index: 1;
}
.custom-best-sellers__image-track {
  display: flex;
  flex-wrap: nowrap;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  transform: translate3d(0, 0, 0);
  transition: transform 0.45s cubic-bezier(.22, .61, .36, 1);
  will-change: transform;
}
.custom-best-sellers__image-slide {
  position: relative;
  flex: 0 0 100%;
  width: 100%;
  height: 100%;
  min-width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.custom-best-sellers__image {
  display: block;
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  object-position: center center;
  margin: 0;
  padding: 0;
  border: 0;
  vertical-align: middle;
  user-select: none;
  -webkit-user-drag: none;
  transition: transform 0.38s ease;
}
.custom-best-sellers__image:hover {
  transform: scale(1.025);
}
/* ---------------- BADGE ---------------- */
.custom-best-sellers__badge {
  position: absolute;
  top: 11px;
  right: 11px;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 21px;
  padding: 4px 8px;
  background: #000;
  color: #fff;
  border-radius: 10px;
  font-size: 15px;
  line-height: 1;
  font-weight: 600;
  white-space: nowrap;
}
/* ---------------- IMAGE ARROWS ---------------- */
.custom-best-sellers__image-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 40;
  width: 20px;
  height: 20px;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, .94);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
  outline: none;
  box-shadow: 0 1px 4px rgba(0, 0, 0, .06);
  transition: transform .15s ease;
}
.custom-best-sellers__image-arrow:active {
  transform: translateY(-50%) scale(.92);
}
.custom-best-sellers__image-arrow--prev { left: 7px; }
.custom-best-sellers__image-arrow--next { right: 7px; }
.custom-best-sellers__image-arrow svg {
  width: 13px;
  height: 13px;
  display: block;
  fill: none;
  stroke: #777;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
  pointer-events: none;
}
/* ---------------- IMAGE DOTS ---------------- */
.custom-best-sellers__image-dots {
  position: absolute;
  left: 50%;
  bottom: 8px;
  transform: translateX(-50%);
  z-index: 35;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3px;
  height: 7px;
  pointer-events: none;
}
.custom-best-sellers__image-dot {
  width: 4px;
  height: 4px;
  min-width: 4px;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 50%;
  background: #b9b9b9;
}
.custom-best-sellers__image-dot.is-active { background: #000; }
/* ---------------- CONTENT ---------------- */
.custom-best-sellers__content {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  width: 100%;
  min-width: 0;
  padding-top: 17px;
}
.custom-best-sellers__title {
  margin: 0;
  padding: 0;
  font-size: 18px;
  line-height: 1.25;
  font-weight: 600;
  color: #111;
  letter-spacing: 0;
  white-space: normal;
}
.custom-best-sellers__title a {
  color: inherit;
  text-decoration: none;
}
.custom-best-sellers__description {
  margin-top: 7px;
  min-height: 20px;
  overflow: hidden;
  font-size: 15px;
  line-height: 1.35;
  font-weight: 400;
  color: #858585;
}
/* ---------------- RATING ---------------- */
.custom-best-sellers__rating {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-top: 7px;
  height: 17px;
  text-decoration: none;
  color: inherit;
}
.custom-best-sellers__stars {
  position: relative;
  display: inline-block;
  font-size: 16px;
  line-height: 1;
  letter-spacing: 1px;
  white-space: nowrap;
}
.custom-best-sellers__stars-bg { color: #c9c9c9; }
.custom-best-sellers__stars-fg {
  position: absolute;
  inset: 0;
  overflow: hidden;
  width: var(--bs-rating, 0%);
  color: #000;
}
.custom-best-sellers__rating-count {
  font-size: 13px;
  line-height: 1;
  color: #858585;
}
/* ---------------- PRICE ---------------- */
.custom-best-sellers__price-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 8px;
  min-height: 21px;
}
.custom-best-sellers__price {
  font-size: 15px;
  line-height: 1.35;
  font-weight: 500;
  color: #111;
}
.custom-best-sellers__compare {
  font-size: 15px;
  line-height: 1.35;
  font-weight: 400;
  color: #888;
  text-decoration: line-through;
}
.custom-best-sellers__from {
  font-size: 15px;
  line-height: 1.35;
  font-weight: 400;
  color: #858585;
}
/* ---------------- CART / BUTTON ---------------- */
.custom-best-sellers__cart-form {
  width: 100%;
  margin: auto 0 0;
  padding: 0;
}
.custom-best-sellers__add {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 14px;
  padding: 14px 15px;
  min-height: 48px;
  border: 1px solid #000;
  border-radius: 0;
  background: #000;
  color: #fff;
  font-family: Jost, sans-serif;
  font-size: 16px;
  line-height: 1.2;
  font-weight: 500;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
  outline: none;
  box-shadow: none;
  transition: none;
}
.custom-best-sellers__add:hover,
.custom-best-sellers__add:focus,
.custom-best-sellers__add:active,
.custom-best-sellers__add:visited {
  background: #000 !important;
  color: #fff !important;
  border-color: #000 !important;
  text-decoration: none !important;
  box-shadow: none !important;
}
.custom-best-sellers__add:disabled {
  background: #8d8d8d !important;
  border-color: #8d8d8d !important;
  cursor: not-allowed;
}
/* ---------------- VIEW ALL ---------------- */
.custom-best-sellers__view-all-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 48px;
}
.custom-best-sellers__view-all {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 163px;
  min-height: 39px;
  padding: 14px 46px;
  border: 1px solid #111;
  background: #fff;
  color: #111;
  text-decoration: none;
  font-family: Jost, sans-serif;
  font-size: 18px;
  line-height: 1.2;
  font-weight: 400;
  transition: none;
}
.custom-best-sellers__view-all:hover,
.custom-best-sellers__view-all:focus,
.custom-best-sellers__view-all:active {
  background: #fff !important;
  color: #111 !important;
  border-color: #111 !important;
  box-shadow: none !important;
}
/* ---------------- EMPTY ---------------- */
.custom-best-sellers__empty {
  grid-column: 1 / -1;
  padding: 50px 20px;
  text-align: center;
  font-size: 16px;
}

/* =========================================================
   CHOOSE OPTIONS POPUP
   Native <dialog>, koi library nahi.
   ========================================================= */
.shpg-modal {
  width: min(940px, calc(100vw - 40px));
  max-width: 940px;
  max-height: min(86vh, 720px);
  padding: 0;
  border: 0;
  border-radius: 6px;
  background: #fff;
  color: #111;
  font-family: Jost, sans-serif;
  overflow: visible;
}
.shpg-modal::backdrop {
  background: rgba(0, 0, 0, 0.45);
}
.shpg-modal__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  align-items: stretch;
  max-height: min(82vh, 660px);
  min-height: 440px;
  overflow: hidden;
  border-radius: 6px;
}
/* Image edge to edge bharti hai, koi padding nahi aur koi
   alag background nahi. Pehle padding + contain ki wajah se
   image ke apne grey backdrop ke peeche ek aur grey box
   nazar aata tha, jo "box ke andar box" lagta tha.
   cover use kiya hai kyunki product shots mein upar neeche
   kaafi khali jagah hai, crop hone par product nahi katta. */
.shpg-modal__media {
  position: relative;
  height: 100%;
  min-height: 0;
  padding: 0;
  background: #efefef;
  overflow: hidden;
}
.shpg-modal__media img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center center;
}
.shpg-modal__info {
  padding: 30px 30px 30px 28px;
  min-height: 0;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}
.shpg-modal__title {
  margin: 0;
  font-size: 26px;
  line-height: 1.18;
  font-weight: 600;
  letter-spacing: -0.4px;
  color: #111;
}
.shpg-modal__title a {
  color: inherit;
  text-decoration: none;
}
.shpg-modal__price-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 14px;
  min-height: 24px;
}
.shpg-modal__price {
  font-size: 19px;
  font-weight: 500;
  color: #111;
}
.shpg-modal__compare {
  font-size: 17px;
  font-weight: 400;
  color: #8a8a8a;
  text-decoration: line-through;
}
/* ---- VARIANT BOX (product page jaisa) ---- */
.shpg-vbox {
  margin: 26px 0 0;
  padding: 6px 20px 22px;
  border: 1px solid rgba(17, 17, 17, 0.14);
  border-radius: 12px;
  min-width: 0;
}
.shpg-vbox__legend {
  padding: 0 8px;
  font-family: inherit;
  font-size: 12px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(17, 17, 17, 0.55);
}
.shpg-vgroup + .shpg-vgroup {
  margin-top: 22px;
}
.shpg-vgroup__label {
  margin: 6px 0 14px;
  font-size: 17px;
  line-height: 1.3;
  font-weight: 600;
  color: #111;
}
.shpg-vgroup__pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.shpg-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  min-width: 0;
  min-height: 52px;
  padding: 13px 18px;
  border: 1px solid rgba(17, 17, 17, 0.16);
  border-radius: 4px;
  background: #fff;
  color: #111;
  font-family: inherit;
  font-size: 16px;
  line-height: 1.3;
  font-weight: 500;
  text-align: center;
  white-space: normal;
  overflow-wrap: anywhere;
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
  transition: border-color .15s ease, box-shadow .15s ease;
}
/* selected par border motti dikhti hai lekin layout hilta nahi,
   kyunki inset shadow use ki hai extra border ki jagah */
.shpg-pill.is-selected {
  border-color: #111;
  box-shadow: inset 0 0 0 1px #111;
}
.shpg-pill.is-unavailable {
  opacity: .42;
  text-decoration: line-through;
}
/* ---- QUANTITY + ADD TO CART EK ROW MEIN ---- */
.shpg-actions {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 10px;
  margin-top: 20px;
  align-items: stretch;
}
.shpg-qty {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  border: 1px solid rgba(17, 17, 17, 0.14);
  border-radius: 0;
  overflow: hidden;
  height: 56px;
  min-width: 128px;
}
.shpg-qty button {
  width: 42px;
  height: 100%;
  border: 0;
  background: transparent;
  color: #111;
  font-family: inherit;
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
}
.shpg-qty input {
  width: 44px;
  height: 100%;
  border: 0;
  background: transparent;
  color: #111;
  font-family: inherit;
  font-size: 17px;
  text-align: center;
  appearance: textfield;
  -moz-appearance: textfield;
}
.shpg-qty input::-webkit-outer-spin-button,
.shpg-qty input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}
.shpg-modal__submit {
  width: 100%;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 14px;
  border: 1px solid #111;
  border-radius: 0;
  background: #fff;
  color: #111;
  font-family: inherit;
  font-size: 17px;
  font-weight: 500;
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
}
.shpg-modal__submit svg {
  width: 19px;
  height: 19px;
  flex: 0 0 auto;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.shpg-modal__submit:disabled {
  border-color: rgba(17, 17, 17, 0.25);
  color: rgba(17, 17, 17, 0.4);
  cursor: not-allowed;
}
/* ---- BUY IT NOW (Shopify dynamic checkout) ---- */
.shpg-modal .shopify-payment-button {
  display: block;
  margin-top: 10px;
}
.shpg-modal .shopify-payment-button__button {
  width: 100%;
  min-height: 56px;
  border-radius: 0 !important;
  background: #111 !important;
  color: #fff !important;
  font-family: inherit !important;
  font-size: 17px !important;
  font-weight: 500 !important;
}
.shpg-modal .shopify-payment-button__more-options {
  display: none;
}
.shpg-modal__details {
  margin-top: 16px;
  font-size: 15px;
  color: #6e6e6e;
  text-decoration: underline;
  text-underline-offset: 3px;
  align-self: flex-start;
}
.shpg-modal__close {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 5;
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #dcdcdc;
  border-radius: 50%;
  background: #fff;
  color: #111;
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
}
.shpg-modal__close svg {
  width: 15px;
  height: 15px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
}
/* popup khulne par background scroll band */
body.shpg-modal-open {
  overflow: hidden;
}
/* ---------------- TABLET ---------------- */
@media screen and (max-width: 989px) {
  .custom-best-sellers {
    padding-left: 12px;
    padding-right: 12px;
    --bs-col-gap: 16px;
    --bs-row-gap: 42px;
  }
}
/* ---------------- MOBILE ---------------- */
@media screen and (max-width: 749px) {
  .custom-best-sellers {
    width: 100% !important;
    max-width: 100% !important;
    padding: 28px 7px 12px !important;
    margin: 0 !important;
    --bs-col-gap: 12px;
    --bs-row-gap: 34px;
  }
  .custom-best-sellers__heading {
    margin: 0 0 28px !important;
    padding: 0 !important;
    font-size: 32px !important;
    line-height: 1.2;
  }
  /* mobile par hamesha 2 per row */
  .custom-best-sellers__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  /* mobile_limit se zyada wale cards - class Liquid lagata hai */
  .custom-best-sellers__card--mobile-hide {
    display: none !important;
  }
  .custom-best-sellers__badge {
    top: 8px;
    right: 8px;
    min-height: 20px;
    padding: 4px 7px;
    font-size: 15px;
  }
  .custom-best-sellers__image-arrow { width: 20px; height: 20px; }
  .custom-best-sellers__image-arrow--prev { left: 6px; }
  .custom-best-sellers__image-arrow--next { right: 6px; }
  .custom-best-sellers__content { padding-top: 13px; }
  .custom-best-sellers__title {
    font-size: 18px !important;
    line-height: 1.25;
  }
  .custom-best-sellers__description {
    margin-top: 6px;
    min-height: 19px;
    font-size: 15px !important;
    line-height: 1.3;
  }
  .custom-best-sellers__rating { margin-top: 6px; }
  .custom-best-sellers__stars { font-size: 15px; }
  .custom-best-sellers__price-row { margin-top: 7px; gap: 5px; }
  .custom-best-sellers__price,
  .custom-best-sellers__compare,
  .custom-best-sellers__from { font-size: 15px !important; }
  .custom-best-sellers__add {
    margin-top: 12px;
    padding: 13px 10px !important;
    min-height: 46px;
    font-size: 15px !important;
  }
  .custom-best-sellers__view-all-wrap { margin-top: 34px; }
  .custom-best-sellers__view-all {
    min-width: 163px;
    min-height: 39px;
    padding: 14px 30px;
    font-size: 18px;
  }
  /* popup mobile par: image upar, details neeche */
  .shpg-modal {
    width: calc(100vw - 24px);
    max-height: 88vh;
  }
  .shpg-modal__close {
    top: 10px;
    right: 10px;
    width: 34px;
    height: 34px;
  }
  .shpg-modal__inner {
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr;
    max-height: 88vh;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  /* Mobile par image screen ka teesra hissa se zyada na le,
     warna variants aur button fold ke neeche chale jate hain. */
  .shpg-modal__media {
    height: 30vh;
    max-height: 30vh;
    min-height: 170px;
    padding: 0;
  }
  .shpg-modal__info {
    padding: 20px 18px 24px;
    overflow: visible;
  }
  .shpg-modal__title { font-size: 22px; }
  .shpg-modal__price { font-size: 18px; }
  .shpg-vbox { padding: 6px 14px 18px; margin-top: 22px; }
  .shpg-vgroup__label { font-size: 16px; }
  .shpg-pill {
    padding: 12px 14px;
    min-height: 48px;
    font-size: 15px;
  }
  .shpg-qty { height: 52px; min-width: 116px; }
  .shpg-qty button { width: 36px; }
  .shpg-qty input { width: 40px; }
  .shpg-modal__submit { height: 52px; font-size: 16px; }
  .shpg-modal .shopify-payment-button__button {
    min-height: 52px;
    font-size: 16px !important;
  }
}
/* bohot chhoti screen par qty aur button alag alag line par */
@media screen and (max-width: 400px) {
  .shpg-actions { grid-template-columns: 1fr; }
  .shpg-qty { width: 100%; justify-content: space-between; }
}
/* ---------------- SMALL MOBILE ---------------- */
@media screen and (max-width: 380px) {
  .custom-best-sellers {
    padding-left: 6px !important;
    padding-right: 6px !important;
    --bs-col-gap: 10px;
  }
  .custom-best-sellers__add { font-size: 14px !important; }
}
/* ---------------- SAFETY ----------------
   overflow-x: clip use kiya hai, hidden nahi. hidden html/body
   par lagane se doosri jagah position: sticky toot jati hai.
   ---------------------------------------- */
html,
body {
  max-width: 100%;
  overflow-x: clip;
}
</style>
{%- endif -%}

<section
  class="custom-best-sellers"
  id="ShProductGrid-{{ uid }}"
  style="--bs-image-ratio: {{ grid_ratio }}; --bs-columns: {{ grid_columns }};"
>
  {%- if heading_text != blank -%}
    <h2 class="custom-best-sellers__heading">{{ heading_text }}</h2>
  {%- endif -%}

  <div class="custom-best-sellers__grid">
    {% if col != blank and col.products_count > 0 %}
      {% for product in col.products limit: grid_limit %}

        {% liquid
          assign rating_value = 0
          assign rating_count = 0
          if product.metafields.reviews.rating.value != blank
            assign rating_value = product.metafields.reviews.rating.value.rating | times: 1.0
            assign rating_count = product.metafields.reviews.rating_count.value | times: 1
          elsif product.metafields.loox.avg_rating != blank
            assign rating_value = product.metafields.loox.avg_rating.value | times: 1.0
            assign rating_count = product.metafields.loox.num_reviews.value | times: 1
          endif
          assign rating_percent = rating_value | times: 20.0

          assign mobile_hide = ''
          if forloop.index > grid_mobile_limit
            assign mobile_hide = ' custom-best-sellers__card--mobile-hide'
          endif

          assign available_variant = product.selected_or_first_available_variant
          assign has_options = false
          if product.variants.size > 1
            assign has_options = true
          endif
          assign modal_id = 'ShPgModal-' | append: uid | append: '-' | append: product.id
          assign modal_form_id = modal_id | append: '-form'
        %}

        <article class="custom-best-sellers__card{{ mobile_hide }}" data-product-card>

          <div class="custom-best-sellers__image-box" data-image-slider>

            {%- if badge_on and badge_label != blank -%}
              <span class="custom-best-sellers__badge">{{ badge_label }}</span>
            {%- endif -%}

            <a
              href="{{ product.url }}"
              class="custom-best-sellers__image-link"
              aria-label="{{ product.title | escape }}"
            >
              <div class="custom-best-sellers__image-track" data-image-track>
                {% if product.images.size > 0 %}
                  {% for image in product.images limit: 8 %}
                    <div class="custom-best-sellers__image-slide">
                      <img
                        class="custom-best-sellers__image"
                        src="{{ image | image_url: width: 800 }}"
                        srcset="
                          {{ image | image_url: width: 400 }} 400w,
                          {{ image | image_url: width: 600 }} 600w,
                          {{ image | image_url: width: 800 }} 800w,
                          {{ image | image_url: width: 1200 }} 1200w
                        "
                        sizes="(min-width: 750px) 23vw, 48vw"
                        alt="{{ image.alt | default: product.title | escape }}"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        width="{{ image.width }}"
                        height="{{ image.height }}"
                        draggable="false"
                      >
                    </div>
                  {% endfor %}
                {% elsif product.featured_image %}
                  <div class="custom-best-sellers__image-slide">
                    <img
                      class="custom-best-sellers__image"
                      src="{{ product.featured_image | image_url: width: 800 }}"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      loading="lazy"
                      width="{{ product.featured_image.width }}"
                      height="{{ product.featured_image.height }}"
                      draggable="false"
                    >
                  </div>
                {% endif %}
              </div>
            </a>

            <button
              type="button"
              class="custom-best-sellers__image-arrow custom-best-sellers__image-arrow--prev"
              aria-label="Previous product image"
              data-image-prev
            >
              <svg viewBox="0 0 24 24"><path d="M14.5 5L7.5 12L14.5 19"></path></svg>
            </button>

            <button
              type="button"
              class="custom-best-sellers__image-arrow custom-best-sellers__image-arrow--next"
              aria-label="Next product image"
              data-image-next
            >
              <svg viewBox="0 0 24 24"><path d="M9.5 5L16.5 12L9.5 19"></path></svg>
            </button>

            {% if product.images.size > 1 %}
              <div class="custom-best-sellers__image-dots" data-image-dots>
                {% for image in product.images limit: 8 %}
                  <span class="custom-best-sellers__image-dot{% if forloop.first %} is-active{% endif %}"></span>
                {% endfor %}
              </div>
            {% endif %}
          </div>

          <div class="custom-best-sellers__content">

            <h3 class="custom-best-sellers__title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>

            <div class="custom-best-sellers__description">
              {{ product.description | strip_html | truncate: 72 }}
            </div>

            {% if rating_count > 0 %}
              <a
                class="custom-best-sellers__rating"
                href="{{ product.url }}"
                aria-label="Rated {{ rating_value }} out of 5 from {{ rating_count }} reviews"
              >
                <span class="custom-best-sellers__stars" style="--bs-rating: {{ rating_percent }}%;" aria-hidden="true">
                  <span class="custom-best-sellers__stars-bg">★★★★★</span>
                  <span class="custom-best-sellers__stars-fg">★★★★★</span>
                </span>
                <span class="custom-best-sellers__rating-count">({{ rating_count }})</span>
              </a>
            {% endif %}

            <div class="custom-best-sellers__price-row">
              {%- if has_options and product.price_varies -%}
                <span class="custom-best-sellers__from">From</span>
              {%- endif -%}
              <span class="custom-best-sellers__price">
                {{ product.price_min | money }}
              </span>
              {%- if product.compare_at_price_max > product.price_min -%}
                <span class="custom-best-sellers__compare">
                  {{ product.compare_at_price_max | money }}
                </span>
              {%- endif -%}
            </div>

            {% if has_options %}
              {% comment %}
                Ek se zyada variant.
                Ye asli link hai product page ka. Desktop par click
                seedha product page kholta hai. Mobile par JS link
                rok kar popup kholta hai.
              {% endcomment %}
              <div class="custom-best-sellers__cart-form">
                {% if product.available %}
                  <a
                    href="{{ product.url }}"
                    class="custom-best-sellers__add"
                    data-shpg-open="{{ modal_id }}"
                  >{{ btn_choose }}</a>
                {% else %}
                  <button type="button" class="custom-best-sellers__add" disabled>Sold out</button>
                {% endif %}
              </div>
            {% else %}
              {% comment %} Ek hi variant: seedha add to cart {% endcomment %}
              <form
                action="{{ routes.cart_add_url }}"
                method="post"
                class="custom-best-sellers__cart-form"
                data-cart-form
              >
                <input type="hidden" name="id" value="{{ available_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button
                  type="submit"
                  class="custom-best-sellers__add"
                  {% unless available_variant.available %}disabled{% endunless %}
                >
                  {% if available_variant.available %}{{ btn_add }}{% else %}Sold out{% endif %}
                </button>
              </form>
            {% endif %}

          </div>
        </article>

        {%- comment -%}
          ==========================================================
          CHOOSE OPTIONS POPUP (sirf multi variant products ke liye)
          ==========================================================
        {%- endcomment -%}
        {% if has_options %}
          <dialog class="shpg-modal" id="{{ modal_id }}" data-shpg-modal aria-label="{{ product.title | escape }}">
            <button type="button" class="shpg-modal__close" data-shpg-close aria-label="Close">
              <svg viewBox="0 0 24 24"><path d="M5 5L19 19M19 5L5 19"></path></svg>
            </button>

            <div class="shpg-modal__inner">
              <div class="shpg-modal__media">
                <img
                  data-shpg-image
                  src="{{ product.featured_image | image_url: width: 900 }}"
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                >
              </div>

              <div class="shpg-modal__info">
                <h3 class="shpg-modal__title">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>

                <div class="shpg-modal__price-row">
                  <span class="shpg-modal__price" data-shpg-price>{{ available_variant.price | money }}</span>
                  <span
                    class="shpg-modal__compare"
                    data-shpg-compare
                    {% unless available_variant.compare_at_price > available_variant.price %}style="display:none;"{% endunless %}
                  >
                    {%- if available_variant.compare_at_price > available_variant.price -%}
                      {{ available_variant.compare_at_price | money }}
                    {%- endif -%}
                  </span>
                </div>

                {%- form 'product', product, id: modal_form_id, novalidate: 'novalidate' -%}
                  <input type="hidden" name="id" value="{{ available_variant.id }}" data-shpg-variant-id>

                  <fieldset class="shpg-vbox">
                    <legend class="shpg-vbox__legend">{{ vbox_legend }}</legend>

                    {% for option in product.options_with_values %}
                      <div class="shpg-vgroup">
                        <div class="shpg-vgroup__label">
                          {{ vbox_prefix }} {{ option.name | downcase }}
                        </div>
                        <div class="shpg-vgroup__pills">
                          {% for value in option.values %}
                            <button
                              type="button"
                              class="shpg-pill{% if available_variant.options[forloop.parentloop.index0] == value %} is-selected{% endif %}"
                              data-shpg-option-index="{{ forloop.parentloop.index0 }}"
                              data-shpg-value="{{ value | escape }}"
                            >{{ value }}</button>
                          {% endfor %}
                        </div>
                      </div>
                    {% endfor %}
                  </fieldset>

                  <div class="shpg-actions">
                    <div class="shpg-qty">
                      <button type="button" data-shpg-qty="-" aria-label="Decrease quantity">&minus;</button>
                      <input type="number" name="quantity" value="1" min="1" inputmode="numeric" data-shpg-qty-input>
                      <button type="button" data-shpg-qty="+" aria-label="Increase quantity">+</button>
                    </div>

                    <button type="submit" class="shpg-modal__submit" data-shpg-submit>
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6.5 8.5h11l-1 10.5h-9l-1-10.5Z"></path>
                        <path d="M9.25 8.5V6.75a2.75 2.75 0 0 1 5.5 0V8.5"></path>
                      </svg>
                      <span data-shpg-submit-text>{% if available_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
                    </button>
                  </div>

                  {%- if buy_now_on -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                {%- endform -%}

                <a class="shpg-modal__details" href="{{ product.url }}">View full details</a>
              </div>
            </div>

            <script type="application/json" data-shpg-variants>
              [
                {%- for v in product.variants -%}
                {
                  "id": {{ v.id }},
                  "options": {{ v.options | json }},
                  "available": {{ v.available }},
                  "price": {{ v.price | money | json }},
                  "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
                  "image": {% if v.featured_image %}{{ v.featured_image | image_url: width: 900 | json }}{% else %}null{% endif %}
                }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            </script>
          </dialog>
        {% endif %}

      {% endfor %}
    {% else %}
      <div class="custom-best-sellers__empty">
        Collection <strong>{{ col_handle }}</strong> nahi mili ya khaali hai.
      </div>
    {% endif %}
  </div>

  {% if va_on and col != blank and va_url != blank %}
    <div class="custom-best-sellers__view-all-wrap">
      <a href="{{ va_url }}" class="custom-best-sellers__view-all">{{ va_text }}</a>
    </div>
  {% endif %}
</section>

{%- if assets_on -%}
<script>
(function () {
  'use strict';

  /* Is width tak popup chalta hai. Isse upar "Choose options"
     seedha product page par le jata hai.
     CSS ke mobile breakpoint (749px) se match hona chahiye. */
  var SHPG_MOBILE_MAX = 749;

  /* =======================================================
     CARD IMAGE SLIDER + CHOOSE OPTIONS POPUP
     ======================================================= */

  function initShProductGrid() {
    document.querySelectorAll('.custom-best-sellers').forEach(function (section) {
      if (section.dataset.initialized === 'true') return;
      section.dataset.initialized = 'true';

      var cards = Array.from(section.querySelectorAll('.custom-best-sellers__card'));

      /* ---------- per card image slider ---------- */
      cards.forEach(function (card) {
        var imageBox = card.querySelector('[data-image-slider]');
        if (!imageBox) return;

        var imageTrack = imageBox.querySelector('[data-image-track]');
        var slides = Array.from(imageBox.querySelectorAll('.custom-best-sellers__image-slide'));
        var prevButton = imageBox.querySelector('[data-image-prev]');
        var nextButton = imageBox.querySelector('[data-image-next]');
        var dots = Array.from(imageBox.querySelectorAll('.custom-best-sellers__image-dot'));

        if (slides.length <= 1) {
          if (prevButton) prevButton.style.display = 'none';
          if (nextButton) nextButton.style.display = 'none';
          dots.forEach(function (dot) { dot.style.display = 'none'; });
          return;
        }

        var currentImage = 0;

        function updateImageSlider(direction) {
          if (direction === 'next') {
            currentImage = (currentImage + 1) % slides.length;
          } else if (direction === 'prev') {
            currentImage = (currentImage - 1 + slides.length) % slides.length;
          }
          imageTrack.style.transform = 'translate3d(-' + (currentImage * 100) + '%, 0, 0)';
          dots.forEach(function (dot, index) {
            dot.classList.toggle('is-active', index === currentImage);
          });
        }

        if (nextButton) {
          nextButton.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();
            updateImageSlider('next');
          });
        }
        if (prevButton) {
          prevButton.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();
            updateImageSlider('prev');
          });
        }
        [prevButton, nextButton].forEach(function (button) {
          if (!button) return;
          button.addEventListener('mousedown', function (event) { event.preventDefault(); });
        });

        var startX = 0;
        imageBox.addEventListener('touchstart', function (e) {
          startX = e.touches[0].clientX;
        }, { passive: true });
        imageBox.addEventListener('touchend', function (e) {
          var dx = startX - e.changedTouches[0].clientX;
          if (Math.abs(dx) > 40) updateImageSlider(dx > 0 ? 'next' : 'prev');
        }, { passive: true });
      });

      /* ---------- Choose options ----------
         Desktop (750px se upar): link apna kaam kare, yani
         seedha product page khul jaye.
         Mobile: link rok kar popup kholo. */
      section.querySelectorAll('[data-shpg-open]').forEach(function (trigger) {
        trigger.addEventListener('click', function (event) {
          if (window.innerWidth > SHPG_MOBILE_MAX) return;

          var modal = document.getElementById(trigger.getAttribute('data-shpg-open'));
          if (!modal) return;

          event.preventDefault();
          if (typeof modal.showModal === 'function') {
            modal.showModal();
          } else {
            modal.setAttribute('open', '');
          }
          document.body.classList.add('shpg-modal-open');
        });
      });

      /* ---------- popups ---------- */
      section.querySelectorAll('[data-shpg-modal]').forEach(initModal);
    });
  }

  /* =======================================================
     POPUP LOGIC
     ======================================================= */
  function initModal(modal) {
    if (modal.dataset.shpgReady === 'true') return;
    modal.dataset.shpgReady = 'true';

    var dataTag = modal.querySelector('[data-shpg-variants]');
    var variants = [];
    try {
      variants = JSON.parse(dataTag.textContent);
    } catch (e) {
      variants = [];
    }

    var pills = Array.from(modal.querySelectorAll('.shpg-pill'));
    var priceEl = modal.querySelector('[data-shpg-price]');
    var compareEl = modal.querySelector('[data-shpg-compare]');
    var imageEl = modal.querySelector('[data-shpg-image]');
    var idInput = modal.querySelector('[data-shpg-variant-id]');
    var submit = modal.querySelector('[data-shpg-submit]');
    var submitText = modal.querySelector('[data-shpg-submit-text]');
    var qtyInput = modal.querySelector('[data-shpg-qty-input]');
    var form = modal.querySelector('form');

    /* button ke andar icon hai, is liye sirf span ka text badalte hain */
    function setSubmit(text, disabled) {
      if (!submit) return;
      submit.disabled = disabled;
      if (submitText) {
        submitText.textContent = text;
      } else {
        submit.textContent = text;
      }
    }

    /* har option index ke liye abhi kya selected hai */
    var selected = [];
    pills.forEach(function (pill) {
      var index = parseInt(pill.getAttribute('data-shpg-option-index'), 10);
      if (pill.classList.contains('is-selected')) {
        selected[index] = pill.getAttribute('data-shpg-value');
      }
    });
    /* jo option abhi tak khaali hai, uski pehli value le lo */
    pills.forEach(function (pill) {
      var index = parseInt(pill.getAttribute('data-shpg-option-index'), 10);
      if (selected[index] === undefined) {
        selected[index] = pill.getAttribute('data-shpg-value');
        pill.classList.add('is-selected');
      }
    });

    function findVariant() {
      return variants.find(function (v) {
        return v.options.every(function (value, index) {
          return value === selected[index];
        });
      });
    }

    /* jo combination kisi available variant se nahi banta,
       us pill par line laga do */
    function markUnavailable() {
      pills.forEach(function (pill) {
        var index = parseInt(pill.getAttribute('data-shpg-option-index'), 10);
        var value = pill.getAttribute('data-shpg-value');
        var possible = variants.some(function (v) {
          if (v.options[index] !== value) return false;
          return v.options.every(function (optionValue, i) {
            if (i === index) return true;
            return optionValue === selected[i];
          }) && v.available;
        });
        pill.classList.toggle('is-unavailable', !possible);
      });
    }

    function refresh() {
      var variant = findVariant();

      pills.forEach(function (pill) {
        var index = parseInt(pill.getAttribute('data-shpg-option-index'), 10);
        pill.classList.toggle(
          'is-selected',
          pill.getAttribute('data-shpg-value') === selected[index]
        );
      });

      markUnavailable();

      if (!variant) {
        setSubmit('Unavailable', true);
        return;
      }

      if (idInput) idInput.value = variant.id;
      if (priceEl) priceEl.textContent = variant.price;

      if (compareEl) {
        if (variant.compare) {
          compareEl.textContent = variant.compare;
          compareEl.style.display = '';
        } else {
          compareEl.textContent = '';
          compareEl.style.display = 'none';
        }
      }

      if (imageEl && variant.image) imageEl.src = variant.image;

      setSubmit(variant.available ? 'Add to cart' : 'Sold out', !variant.available);
    }

    pills.forEach(function (pill) {
      pill.addEventListener('click', function () {
        var index = parseInt(pill.getAttribute('data-shpg-option-index'), 10);
        selected[index] = pill.getAttribute('data-shpg-value');
        refresh();
      });
    });

    /* quantity */
    modal.querySelectorAll('[data-shpg-qty]').forEach(function (button) {
      button.addEventListener('click', function () {
        if (!qtyInput) return;
        var current = parseInt(qtyInput.value, 10) || 1;
        var next = button.getAttribute('data-shpg-qty') === '+' ? current + 1 : current - 1;
        qtyInput.value = Math.max(1, next);
      });
    });

    /* close */
    modal.querySelectorAll('[data-shpg-close]').forEach(function (button) {
      button.addEventListener('click', function () {
        if (typeof modal.close === 'function') {
          modal.close();
        } else {
          modal.removeAttribute('open');
        }
      });
    });

    /* backdrop par click se band */
    modal.addEventListener('click', function (event) {
      if (event.target === modal && typeof modal.close === 'function') modal.close();
    });

    /* band hone par body scroll wapas */
    modal.addEventListener('close', function () {
      document.body.classList.remove('shpg-modal-open');
    });

    /* variant resolve na ho to submit rok do */
    if (form) {
      form.addEventListener('submit', function (event) {
        if (!idInput || !idInput.value) event.preventDefault();
      });
    }

    refresh();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShProductGrid);
  } else {
    initShProductGrid();
  }

  /* theme editor mein section reload hone par dobara bind karo */
  document.addEventListener('shopify:section:load', function (event) {
    if (event.target && event.target.querySelectorAll) {
      event.target.querySelectorAll('.custom-best-sellers').forEach(function (s) {
        s.dataset.initialized = 'false';
      });
    }
    initShProductGrid();
  });
})();
</script>
{%- endif -%}
