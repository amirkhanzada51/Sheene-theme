{% comment %}
==========================================================================
  SHEENE - Mobile menu drawer + stacking fix
==========================================================================

  Snippet ka naam:  sheene-mobile-menu

  ISTEMAAL
  --------
  layout/theme.liquid mein </body> se pehle:

      {%- render 'sheene-drawer-fix' -%}
      {%- render 'sheene-mobile-menu' -%}

  KYA KARTA HAI
  -------------
  1. Har page section ko apna stacking context: product badges aur slider
     arrows kabhi menu ke upar nahi aate.
  2. Mobile drawer ka naya design:
       - Upar logo aur close button, neeche hairline
       - "SHOP" chhota label, phir saaf rows, har row par arrow
       - Current page par left mein ink line
       - Promo card (knobs se text / link)
       - Trust line + footer links (account, contact, WhatsApp)
  3. Horizon ki "Featured products" images drawer se chhupa deta hai.

  Desktop menu ko nahi chherta. Links khud Shopify menu (Navigation) se
  aate hain, yahan sirf design hai.

  KNOBS neeche. Kisi text ko '' kar do to woh hissa hide.
  Trust line mein wahi likho jo store ki asli settings hain.
{% endcomment %}

{% liquid
  assign DRAWER_WIDTH = '88vw'
  assign DRAWER_MAX = '390px'
  assign HIDE_MENU_PRODUCTS = true

  assign MENU_LABEL = 'Shop'

  assign PROMO_TITLE = 'Build your routine'
  assign PROMO_TEXT = 'Complete kits for one concern, in one box.'
  assign PROMO_CTA = 'Shop bundles'
  assign PROMO_URL = '/collections/bundles'

  assign TRUST_LINE = 'Free delivery  ·  Cash on delivery  ·  3 day returns'

  # Format: Label|/url  (comma se alag)
  assign FOOT_LINKS = 'My account|/account,Contact us|/pages/contact'
  # Sirf digits, country code ke saath, jaise 923001234567. Khali = hide
  assign WHATSAPP_NUMBER = ''
%}

<template id="ShMenuExtras">
  <div class="sh-md-top">
    <a class="sh-md-brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if shop.brand.logo -%}
        {{ shop.brand.logo | image_url: height: 64 | image_tag: alt: shop.name, class: 'sh-md-brand__img', loading: 'lazy' }}
      {%- else -%}
        <span class="sh-md-brand__text">{{ shop.name | escape }}</span>
      {%- endif -%}
    </a>
  </div>
  {%- if MENU_LABEL != blank -%}
    <p class="sh-md-label">{{ MENU_LABEL }}</p>
  {%- endif -%}
</template>

<template id="ShMenuFooter">
  <div class="sh-md-bottom">
    {%- if PROMO_TITLE != blank -%}
      <a class="sh-md-promo" href="{{ PROMO_URL }}">
        <span class="sh-md-promo__body">
          <span class="sh-md-promo__title">{{ PROMO_TITLE }}</span>
          {%- if PROMO_TEXT != blank -%}<span class="sh-md-promo__text">{{ PROMO_TEXT }}</span>{%- endif -%}
          {%- if PROMO_CTA != blank -%}<span class="sh-md-promo__cta">{{ PROMO_CTA }}</span>{%- endif -%}
        </span>
        <span class="sh-md-promo__arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
        </span>
      </a>
    {%- endif -%}

    {%- if TRUST_LINE != blank -%}
      <p class="sh-md-trust">{{ TRUST_LINE }}</p>
    {%- endif -%}

    <div class="sh-md-foot">
      {%- assign foot = FOOT_LINKS | split: ',' -%}
      {%- for item in foot -%}
        {%- assign bits = item | split: '|' -%}
        {%- assign f_label = bits[0] | strip -%}
        {%- assign f_url = bits[1] | strip -%}
        {%- if f_label != blank and f_url != blank -%}
          <a class="sh-md-foot__link" href="{{ f_url }}">{{ f_label }}</a>
        {%- endif -%}
      {%- endfor -%}
      {%- if WHATSAPP_NUMBER != blank -%}
        <a class="sh-md-foot__link sh-md-foot__link--wa" href="https://wa.me/{{ WHATSAPP_NUMBER }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.2-3.6A8 8 0 1 1 8 19.1L4 20z"/><path d="M9 9.5c.3 1.8 2.2 4 4.5 4.8l1.2-1.1 1.8.9c-.2 1-1 1.6-2 1.6C11.4 15.4 8.6 12.6 8.3 9.5c0-1 .6-1.8 1.6-2l.9 1.8L9 9.5z"/></svg>
          WhatsApp
        </a>
      {%- endif -%}
    </div>
  </div>
</template>

<style>
  /* ---------- 1. badges / arrows menu ke upar na aayen ---------- */
  #MainContent > .shopify-section,
  main > .shopify-section {
    isolation: isolate;
  }

  .sh-md-top, .sh-md-label, .sh-md-bottom { display: none; }

  /* ---------- 2. mobile drawer ---------- */
  @media screen and (max-width: 749px) {
    .menu-drawer {
      --sh-md-pad: 1.5rem;
      --sh-md-line: rgb(var(--color-foreground-rgb, 17 17 17) / 0.09);
      --sh-md-muted: rgb(var(--color-foreground-rgb, 17 17 17) / 0.55);
      width: min({{ DRAWER_WIDTH }}, {{ DRAWER_MAX }}) !important;
      max-width: {{ DRAWER_MAX }} !important;
      box-shadow: 0 0 48px rgb(0 0 0 / 0.16);
      font-family: var(--font-body--family, system-ui, sans-serif);
      color: var(--color-foreground, #111111);
      background: var(--color-background, #FFFFFF);
    }

    /* top bar */
    .menu-drawer .sh-md-top {
      display: flex;
      align-items: center;
      min-height: 64px;
      padding: 0 4rem 0 var(--sh-md-pad);
      border-bottom: 1px solid var(--sh-md-line);
      flex: 0 0 auto;
    }
    .sh-md-brand { display: inline-flex; align-items: center; text-decoration: none; color: inherit; }
    .sh-md-brand__img { height: 26px; width: auto; display: block; }
    .sh-md-brand__text { font-weight: 700; font-size: 1.5rem; letter-spacing: -0.035em; line-height: 1; }

    .menu-drawer > .menu-drawer__close-button {
      position: absolute !important;
      top: 10px;
      right: 10px;
      z-index: 2;
      width: 44px !important;
      height: 44px !important;
      padding: 0 !important;
      display: grid !important;
      place-items: center;
      border-radius: 50% !important;
      background: #F7F7F5 !important;
    }
    .menu-drawer > .menu-drawer__close-button svg { width: 16px; height: 16px; }

    .menu-drawer .sh-md-label {
      display: block;
      margin: 1.4rem var(--sh-md-pad) 0.35rem;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.17em;
      text-transform: uppercase;
      color: var(--sh-md-muted);
    }

    /* links */
    .menu-drawer__menu.has-submenu {
      padding-inline: 0 !important;
      margin-block-end: 0 !important;
    }
    .menu-drawer__menu.has-submenu > .menu-drawer__list-item {
      min-height: 0 !important;
      margin: 0 !important;
      border-bottom: 1px solid var(--sh-md-line);
    }
    .menu-drawer__menu.has-submenu > .menu-drawer__list-item:last-child { border-bottom: 0; }

    .menu-drawer .menu-drawer__menu-item--mainlist {
      position: relative;
      min-height: 56px !important;
      padding: 0.9rem var(--sh-md-pad) !important;
      font-family: var(--font-body--family, system-ui, sans-serif) !important;
      font-size: 1.12rem !important;
      font-weight: 600 !important;
      line-height: 1.25 !important;
      letter-spacing: -0.005em;
      text-transform: none !important;
      color: var(--color-foreground, #111111) !important;
      transition: background-color 0.15s ease;
    }
    .menu-drawer a.menu-drawer__menu-item--mainlist::after {
      content: '';
      flex: 0 0 auto;
      width: 7px;
      height: 7px;
      margin-inline: 1rem 0.2rem;
      border-top: 1.6px solid currentColor;
      border-right: 1.6px solid currentColor;
      transform: rotate(45deg);
      opacity: 0.35;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .menu-drawer a.menu-drawer__menu-item--mainlist:active::after { transform: translateX(3px) rotate(45deg); opacity: 0.8; }
    .menu-drawer .menu-drawer__menu-item--mainlist:active { background: #F7F7F5; }

    .menu-drawer .menu-drawer__menu-item--mainlist[aria-current='page'],
    .menu-drawer .menu-drawer__menu-item--mainlist.menu-drawer__menu-item--active {
      background: #F7F7F5;
    }
    .menu-drawer .menu-drawer__menu-item--mainlist[aria-current='page']::before,
    .menu-drawer .menu-drawer__menu-item--mainlist.menu-drawer__menu-item--active::before {
      content: '';
      position: absolute;
      left: 0;
      top: 12px;
      bottom: 12px;
      width: 3px;
      border-radius: 0 3px 3px 0;
      background: var(--color-foreground, #111111);
    }

    .menu-drawer .menu-drawer__menu-item--mainlist > .svg-wrapper {
      padding-block: 0 !important;
      opacity: 0.45;
    }

    /* submenu rows */
    .menu-drawer .menu-drawer__menu-item--child,
    .menu-drawer .menu-drawer__menu-item--parent {
      padding: 0.75rem var(--sh-md-pad) !important;
      font-size: 0.98rem !important;
      font-weight: 500 !important;
      color: rgb(var(--color-foreground-rgb, 17 17 17) / 0.8) !important;
    }

    /* bottom area */
    .menu-drawer .sh-md-bottom {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-top: auto;
      padding: 1.25rem var(--sh-md-pad) calc(1.25rem + env(safe-area-inset-bottom, 0px));
    }

    .sh-md-promo {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1.1rem 1.15rem;
      border-radius: 16px;
      background: var(--color-foreground, #111111);
      color: var(--color-background, #FFFFFF);
      text-decoration: none;
    }
    .sh-md-promo__body { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; flex: 1 1 auto; }
    .sh-md-promo__title { font-weight: 700; font-size: 1.05rem; line-height: 1.2; }
    .sh-md-promo__text { font-size: 0.86rem; line-height: 1.4; opacity: 0.75; }
    .sh-md-promo__cta {
      margin-top: 0.35rem;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }
    .sh-md-promo__arrow {
      flex: 0 0 auto;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: rgb(255 255 255 / 0.14);
    }
    .sh-md-promo__arrow svg,
    .sh-md-foot__link svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8px;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .sh-md-trust {
      margin: 0;
      font-size: 0.78rem;
      line-height: 1.4;
      text-align: center;
      white-space: pre-wrap;
      color: var(--sh-md-muted);
    }

    .sh-md-foot {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding-top: 1rem;
      border-top: 1px solid var(--sh-md-line);
    }
    .sh-md-foot__link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      min-height: 40px;
      padding: 0 1rem;
      border: 1px solid var(--sh-md-line);
      border-radius: 999px;
      font-size: 0.86rem;
      font-weight: 500;
      color: inherit;
      text-decoration: none;
    }
    .sh-md-foot__link:active { background: #F7F7F5; }

    .menu-drawer__utility-links { margin-inline-start: var(--sh-md-pad) !important; }

    /* animation: bottom area bhi baqi rows ke saath aaye */
    .menu-drawer-container[open] .sh-md-bottom {
      animation: menu-drawer-nav-open var(--drawer-animation-speed, 0.2s) ease-in-out;
      animation-delay: calc(var(--drawer-animation-speed, 0.2s) + 0.35s);
      animation-fill-mode: backwards;
    }

    {% if HIDE_MENU_PRODUCTS %}
    .menu-drawer__featured-content { display: none !important; }
    {% endif %}
  }
</style>

<script>
  (function () {
    function inject() {
      var top = document.getElementById('ShMenuExtras');
      var bottom = document.getElementById('ShMenuFooter');
      if (!top || !bottom) return;
      document.querySelectorAll('header-drawer .menu-drawer').forEach(function (drawer) {
        if (drawer.dataset.shMenu) return;
        drawer.dataset.shMenu = '1';
        var nav = drawer.querySelector('.menu-drawer__navigation');
        if (!nav) return;
        nav.parentNode.insertBefore(top.content.cloneNode(true), nav);
        drawer.appendChild(bottom.content.cloneNode(true));
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', inject);
    else inject();
    document.addEventListener('shopify:section:load', inject);
  })();
</script>
