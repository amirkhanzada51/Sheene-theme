{% comment %}
  ==========================================================
  SHEENE - Product accordion (dynamic)
  ==========================================================

  Data product metafields se aata hai:
    custom.pp_accordian_1 ... custom.pp_accordian_5
    (type: multi-line text)

  Jo field khaali hai, uski row render hi nahi hoti.
  Sab khaali hon to poora accordion gayab, koi khaali border nahi.

  ISTEMAAL
    Custom Liquid block mein bas ek line:
    {% render 'sheene-product-accordion' %}

  ----------------------------------------------------------
  FIELD MEIN LIKHNE KA TAREEQA
  ----------------------------------------------------------

  Tareeqa 1 (recommended) - pehli line title, baqi description:

      What Makes It Potent?
      <p>Zinc PCA 1% plus Alpha Arbutin. Oil control ke
      saath dark spots par kaam karta hai.</p>

  Tareeqa 2 - labels ke saath, agar tumhe yahi pasand hai:

      title: What Makes It Potent?
      description: <p>Zinc PCA 1% plus Alpha Arbutin.</p>

  Dono chalte hain. HTML likho to waisa hi render hoga.
  Plain text likho to line breaks khud <br> ban jayenge,
  yani HTML tags likhna zaroori nahi.

  ----------------------------------------------------------
  KNOBS
  ----------------------------------------------------------
    TOTAL_ROWS   kitne metafields check karne hain
    OPEN_FIRST   pehli row khuli hui load ho ya nahi
    ONE_AT_A_TIME  ek waqt mein sirf ek row khuli rahe
{% endcomment %}

{% liquid
  assign product = product | default: closest.product

  assign TOTAL_ROWS = 5
  assign OPEN_FIRST = false
  assign ONE_AT_A_TIME = true

  assign key_prefix = 'pp_accordian_'
%}

{% comment %} pehle ginti, taake khaali hone par wrapper bhi na aaye {% endcomment %}
{% assign visible_count = 0 %}
{% for i in (1..TOTAL_ROWS) %}
  {% assign key = key_prefix | append: i %}
  {% if product.metafields.custom[key].value != blank %}
    {% assign visible_count = visible_count | plus: 1 %}
  {% endif %}
{% endfor %}

{% if visible_count > 0 %}
  <div class="sh-acc" id="ShAcc-{{ product.id }}" data-one-at-a-time="{{ ONE_AT_A_TIME }}">

    {% assign shown = 0 %}

    {% for i in (1..TOTAL_ROWS) %}
      {% assign key = key_prefix | append: i %}
      {% assign raw = product.metafields.custom[key].value | strip %}

      {% if raw != blank %}

        {% comment %} ---- title aur description alag karo ---- {% endcomment %}
        {% assign acc_title = '' %}
        {% assign acc_body = '' %}

        {% if raw contains 'description:' %}
          {% comment %} Tareeqa 2: labels wala format {% endcomment %}
          {% assign before_desc = raw | split: 'description:' | first %}
          {% assign acc_body = raw | split: 'description:' | last | strip %}

          {% if before_desc contains 'title:' %}
            {% assign acc_title = before_desc | split: 'title:' | last %}
          {% else %}
            {% assign acc_title = before_desc %}
          {% endif %}

          {% comment %} agar galti se braces ya quotes likh diye hon to saaf kar do {% endcomment %}
          {% assign acc_title = acc_title | remove: '{' | remove: '}' | remove: '"' | replace: "'", '' | remove: ',' | strip %}
          {% assign acc_body = acc_body | remove: '}' | strip %}
        {% else %}
          {% comment %} Tareeqa 1: pehli line title, baqi body {% endcomment %}
          {% assign lines = raw | newline_to_br | split: '<br />' %}
          {% assign acc_title = lines[0] | strip_newlines | strip %}
          {% assign acc_body = raw | remove_first: acc_title | strip %}
        {% endif %}

        {% if acc_title != blank %}
          {% assign shown = shown | plus: 1 %}

          <details class="sh-acc__row"{% if OPEN_FIRST and shown == 1 %} open{% endif %}>
            <summary class="sh-acc__head">
              <span class="sh-acc__label">{{ acc_title }}</span>
              <span class="sh-acc__icon" aria-hidden="true"></span>
            </summary>
            <div class="sh-acc__body rte">
              {%- if acc_body contains '<' -%}
                {{ acc_body }}
              {%- else -%}
                {{ acc_body | newline_to_br }}
              {%- endif -%}
            </div>
          </details>
        {% endif %}

      {% endif %}
    {% endfor %}

  </div>

  <style>
    .sh-acc {
      width: 100%;
      border-top: 1px solid rgb(var(--color-border-rgb, 17 17 17) / 0.14);
    }

    .sh-acc__row {
      border-bottom: 1px solid rgb(var(--color-border-rgb, 17 17 17) / 0.14);
    }

    .sh-acc__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      list-style: none;
      cursor: pointer;
      padding: 1.15rem 0;
      min-height: var(--minimum-touch-target, 44px);
    }
    .sh-acc__head::-webkit-details-marker { display: none; }
    .sh-acc__head::marker { content: ''; }
    .sh-acc__head:focus-visible {
      outline: var(--focus-outline-width, 2px) solid var(--color-foreground, #111111);
      outline-offset: 2px;
    }

    .sh-acc__label {
      font-family: var(--font-body--family, system-ui, sans-serif);
      font-style: var(--font-body--style, normal);
      font-weight: 500;
      font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.1rem);
      line-height: 1.3;
      color: var(--color-foreground, #111111);
    }

    /* plus se minus, bina kisi icon file ke */
    .sh-acc__icon {
      position: relative;
      flex: 0 0 auto;
      width: 14px;
      height: 14px;
    }
    .sh-acc__icon::before,
    .sh-acc__icon::after {
      content: '';
      position: absolute;
      inset: 0;
      margin: auto;
      background: var(--color-foreground, #111111);
      transition: transform var(--animation-speed, 0.15s) ease,
                  opacity var(--animation-speed, 0.15s) ease;
    }
    .sh-acc__icon::before { width: 100%; height: 1.5px; }
    .sh-acc__icon::after  { width: 1.5px; height: 100%; }

    .sh-acc__row[open] .sh-acc__icon::after {
      transform: rotate(90deg);
      opacity: 0;
    }

    .sh-acc__body {
      padding: 0 0 1.35rem;
      font-family: var(--font-body--family, system-ui, sans-serif);
      font-weight: 400;
      font-size: var(--font-size--md, 1rem);
      line-height: 1.55;
      color: rgb(var(--color-foreground-rgb, 17 17 17) / 0.75);
    }
    .sh-acc__body > *:first-child { margin-top: 0; }
    .sh-acc__body > *:last-child { margin-bottom: 0; }
    .sh-acc__body ul,
    .sh-acc__body ol { padding-inline-start: 1.15rem; }
    .sh-acc__body li { margin-block: 0.25rem; }
  </style>

  <script>
    (function () {
      var root = document.getElementById('ShAcc-{{ product.id }}');
      if (!root || root.dataset.shInit) return;
      root.dataset.shInit = '1';

      if (root.dataset.oneAtATime !== 'true') return;

      root.querySelectorAll('.sh-acc__row').forEach(function (row) {
        row.addEventListener('toggle', function () {
          if (!row.open) return;
          root.querySelectorAll('.sh-acc__row[open]').forEach(function (other) {
            if (other !== row) other.open = false;
          });
        });
      });
    })();
  </script>
{% endif %}
