{% comment %}
==========================================================================
  SHEENE - Product info column
  Title -> Review stars -> Price -> Variant picker
  File 2 of 2. Paste into a "Custom Liquid" block on the INFO side of the
  product page (right column), above your quantity / add to cart blocks.

  The matching gallery block lives in: sheene-product-gallery.liquid
  If that block is on the page, picking a variant also moves the gallery to
  that variant's image. If it is not there, everything else still works.

  FONTS AND COLORS
  Nothing is hardcoded. Uses Horizon's own variables, so this inherits
  whatever you set in Theme settings > Typography and Colors:
    --font-h1--family / --font-body--family
    --color-foreground / --color-background / --color-foreground-rgb
    --variant-picker-button-radius (your pill radius setting)

  SPACING
  Every gap in this block comes from --sh-gap in the CSS below.
  Change that one value to tighten or loosen the whole column.

  REVIEW STARS
  Reads real review data, in this order:
    1. product.metafields.reviews.rating    (Judge.me, Okendo, Stamped,
                                             Shopify Product Reviews)
    2. product.metafields.loox.avg_rating   (Loox)
  No review app is installed on this store right now, so the stars stay
  hidden until you install one. Install Judge.me and they appear on their
  own, no code change needed.

  Want a neutral placeholder in the meantime? Set SHOW_EMPTY_STATE to true
  just below. It renders empty stars and a "Be the first to review" link.

  VARIANT PICKER
  Auto-hides on products that only have "Default Title". Sold out options
  show struck through. Clicking a pill updates the price, the URL, the
  add to cart form's variant id and the gallery. No page reload.
{% endcomment %}

{% liquid
  assign SHOW_EMPTY_STATE = false
  assign REVIEWS_ANCHOR = '#sh-reviews'

  assign current_variant = product.selected_or_first_available_variant

  assign rating_value = 0
  assign rating_count = 0

  if product.metafields.reviews.rating.value != blank
    assign rating_value = product.metafields.reviews.rating.value.rating | times: 1.0
    assign rating_count = product.metafields.reviews.rating_count.value | times: 1
  elsif product.metafields.loox.avg_rating != blank
    assign rating_value = product.metafields.loox.avg_rating.value | times: 1.0
    assign rating_count = product.metafields.loox.num_reviews.value | times: 1
  endif

  assign rating_percent = rating_value | times: 20.0

  assign has_real_options = false
  for option in product.options_with_values
    unless option.name == 'Title' and option.values.size == 1
      assign has_real_options = true
    endunless
  endfor
%}

<div class="sh-pdp" id="ShPdp-{{ product.id }}" data-gallery="ShGallery-{{ product.id }}">

  {% comment %} Title {% endcomment %}
  <h1 class="sh-title">{{ product.title }}</h1>

  {% comment %} Review stars, directly under the title {% endcomment %}
  {% if rating_count > 0 %}
    <a class="sh-rating" href="{{ REVIEWS_ANCHOR }}"
       aria-label="Rated {{ rating_value }} out of 5 from {{ rating_count }} reviews">
      <span class="sh-rating-stars" style="--sh-rating: {{ rating_percent }}%;" aria-hidden="true">
        <span class="sh-rating-stars-bg">★★★★★</span>
        <span class="sh-rating-stars-fg">★★★★★</span>
      </span>
      <span class="sh-rating-count">({{ rating_count }})</span>
    </a>
  {% elsif SHOW_EMPTY_STATE %}
    <a class="sh-rating sh-rating--empty" href="{{ REVIEWS_ANCHOR }}">
      <span class="sh-rating-stars" style="--sh-rating: 0%;" aria-hidden="true">
        <span class="sh-rating-stars-bg">★★★★★</span>
        <span class="sh-rating-stars-fg">★★★★★</span>
      </span>
      <span class="sh-rating-count">Be the first to review</span>
    </a>
  {% endif %}

  {% comment %} Price {% endcomment %}
  <div class="sh-price" data-sh-price>
    <span class="sh-price-compare" data-sh-compare
      {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>
      {{ current_variant.compare_at_price | money }}
    </span>
    <span class="sh-price-current" data-sh-current>{{ current_variant.price | money }}</span>
    <span class="sh-price-badge" data-sh-badge
      {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>Sale</span>
  </div>

  <p class="sh-tax">{{ 'products.product.include_taxes' | t | default: 'Shipping calculated at checkout.' }}</p>

  {% comment %} Variant picker {% endcomment %}
  {% if has_real_options %}
    <div class="sh-variants" data-sh-variants-root>
      {% for option in product.options_with_values %}
        {% unless option.name == 'Title' and option.values.size == 1 %}
          <fieldset class="sh-option" data-option-position="{{ option.position }}">
            <legend class="sh-option-label">
              {{ option.name }}
              <span class="sh-option-selected" data-sh-selected-for="{{ option.position }}">{{ option.selected_value }}</span>
            </legend>
            <div class="sh-option-values">
              {% for value in option.values %}
                <button
                  type="button"
                  class="sh-pill{% if option.selected_value == value %} is-selected{% endif %}"
                  data-option-position="{{ option.position }}"
                  data-option-value="{{ value | escape }}"
                  aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                >{{ value }}</button>
              {% endfor %}
            </div>
          </fieldset>
        {% endunless %}
      {% endfor %}
    </div>
  {% endif %}

  <script type="application/json" data-sh-variant-data>
    [{% for v in product.variants %}{
      "id": {{ v.id }},
      "available": {{ v.available }},
      "options": {{ v.options | json }},
      "price": {{ v.price | money | json }},
      "compare_at": {{ v.compare_at_price | money | json }},
      "on_sale": {% if v.compare_at_price > v.price %}true{% else %}false{% endif %},
      "media_index": {% if v.featured_media %}{{ v.featured_media.position | minus: 1 }}{% else %}null{% endif %}
    }{% unless forloop.last %},{% endunless %}{% endfor %}]
  </script>

</div>

<style>
  /* ---------- shared scale for the whole info column ---------- */
  .sh-pdp {
    --sh-gap: var(--margin-lg, 1rem);
    --sh-muted: rgb(var(--color-foreground-rgb, 17 17 17) / var(--opacity-muted-text, 0.6));
    --sh-line: rgb(var(--color-foreground-rgb, 17 17 17) / 0.22);

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    width: 100%;
    font-family: var(--font-body--family, system-ui, sans-serif);
    color: var(--color-foreground, #111111);
  }
  .sh-pdp > * { margin: 0; }
  .sh-pdp > * + * { margin-top: var(--sh-gap); }

  /* ---------- title ---------- */
  .sh-title {
    font-family: var(--font-h1--family, var(--font-heading--family, system-ui, sans-serif));
    font-style: var(--font-h1--style, normal);
    font-weight: var(--font-h1--weight, 700);
    font-size: var(--font-h1--size, clamp(1.75rem, 1.35rem + 1.6vw, 2.75rem));
    line-height: var(--font-h1--line-height, 1.15);
    letter-spacing: var(--font-h1--letter-spacing, -0.02em);
    text-transform: var(--font-h1--case, none);
    color: var(--color-foreground, #111111);
    text-wrap: balance;
  }

  /* ---------- review stars ---------- */
  .sh-rating {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs, 0.5rem);
    text-decoration: none;
    color: inherit;
    line-height: 1;
  }
  .sh-rating:hover .sh-rating-count { text-decoration: underline; }

  .sh-rating-stars {
    position: relative;
    display: inline-block;
    font-size: var(--font-size--lg, 1.125rem);
    line-height: 1;
    letter-spacing: 0.18em;
    white-space: nowrap;
  }
  .sh-rating-stars-bg { color: var(--sh-line); }
  .sh-rating-stars-fg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    width: var(--sh-rating, 0%);
    color: var(--color-foreground, #111111);
  }
  .sh-rating-count {
    font-size: var(--font-size--sm, 0.875rem);
    color: var(--sh-muted);
  }

  /* ---------- price ---------- */
  .sh-price {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-sm, 0.7rem);
    line-height: 1;
  }
  .sh-price-compare {
    color: var(--sh-muted);
    text-decoration: line-through;
    font-size: var(--font-size--md, 1rem);
  }
  .sh-price-current {
    color: var(--color-foreground, #111111);
    font-weight: 600;
    font-size: var(--font-size--xl, 1.25rem);
  }
  .sh-price-badge {
    background: var(--color-foreground, #111111);
    color: var(--color-background, #FFFFFF);
    font-size: var(--font-size--2xs, 0.75rem);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-sm, 0.06em);
    padding: 0.35em 0.7em;
    border-radius: var(--style-border-radius-xs, 0);
  }
  .sh-price [hidden] { display: none !important; }

  .sh-tax {
    font-size: var(--font-size--sm, 0.875rem);
    color: var(--sh-muted);
  }

  /* ---------- variant picker ---------- */
  .sh-variants {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg, 1rem);
    width: 100%;
  }
  .sh-option {
    border: 0;
    padding: 0;
    margin: 0;
    min-inline-size: 0;
  }
  .sh-option-label {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0;
    margin-bottom: var(--margin-xs, 0.5rem);
    font-size: var(--font-size--sm, 0.875rem);
    color: var(--sh-muted);
  }
  .sh-option-selected { color: var(--color-foreground, #111111); }

  .sh-option-values {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-xs, 0.5rem);
  }

  .sh-pill {
    font-family: inherit;
    font-size: var(--font-size--sm, 0.875rem);
    line-height: 1;
    letter-spacing: var(--letter-spacing-sm, 0.06em);
    text-transform: uppercase;
    color: var(--color-foreground, #111111);
    background: transparent;
    border: var(--variant-picker-button-border-width, 1px) solid var(--sh-line);
    border-radius: var(--variant-picker-button-radius, 999px);
    padding: 0.85em 1.4em;
    min-height: var(--minimum-touch-target, 44px);
    cursor: pointer;
    transition: background var(--animation-speed, 0.15s) ease,
                color var(--animation-speed, 0.15s) ease,
                border-color var(--animation-speed, 0.15s) ease;
  }
  .sh-pill:hover { border-color: var(--color-foreground, #111111); }
  .sh-pill:focus-visible {
    outline: var(--focus-outline-width, 2px) solid var(--color-foreground, #111111);
    outline-offset: var(--focus-outline-offset, 2px);
  }
  .sh-pill.is-selected {
    background: var(--color-foreground, #111111);
    border-color: var(--color-foreground, #111111);
    color: var(--color-background, #FFFFFF);
  }
  .sh-pill.is-unavailable {
    color: var(--sh-muted);
    border-color: rgb(var(--color-foreground-rgb, 17 17 17) / 0.12);
    text-decoration: line-through;
  }
  .sh-pill.is-unavailable.is-selected {
    background: transparent;
    color: var(--sh-muted);
  }
  .sh-gallery { grid-column: 2; }
  .sh-pdp { grid-column: 2; }
</style>

<script>
  (function () {
    var root = document.getElementById('ShPdp-{{ product.id }}');
    if (!root) return;

    var dataEl = root.querySelector('[data-sh-variant-data]');
    if (!dataEl) return;

    var variants = [];
    try { variants = JSON.parse(dataEl.textContent); } catch (e) { return; }
    if (!variants.length) return;

    var pills = root.querySelectorAll('.sh-pill');
    var priceCurrent = root.querySelector('[data-sh-current]');
    var priceCompare = root.querySelector('[data-sh-compare]');
    var priceBadge = root.querySelector('[data-sh-badge]');
    var gallery = document.getElementById(root.dataset.gallery);

    function selectedOptions() {
      var out = [];
      root.querySelectorAll('.sh-option').forEach(function (fs) {
        var pos = parseInt(fs.dataset.optionPosition, 10);
        var active = fs.querySelector('.sh-pill.is-selected');
        out[pos - 1] = active ? active.dataset.optionValue : null;
      });
      return out;
    }

    function findVariant(opts) {
      return variants.find(function (v) {
        return opts.every(function (val, i) {
          return val === null || v.options[i] === val;
        });
      });
    }

    function markAvailability(opts) {
      root.querySelectorAll('.sh-option').forEach(function (fs) {
        var pos = parseInt(fs.dataset.optionPosition, 10);
        fs.querySelectorAll('.sh-pill').forEach(function (pill) {
          var test = opts.slice();
          test[pos - 1] = pill.dataset.optionValue;
          var match = variants.find(function (v) {
            return test.every(function (val, i) {
              return val === null || v.options[i] === val;
            });
          });
          pill.classList.toggle('is-unavailable', !match || !match.available);
        });
      });
    }

    function updatePrice(variant) {
      if (!variant) return;
      if (priceCurrent) priceCurrent.innerHTML = variant.price;
      if (priceCompare) {
        priceCompare.innerHTML = variant.compare_at || '';
        priceCompare.hidden = !variant.on_sale;
      }
      if (priceBadge) priceBadge.hidden = !variant.on_sale;
    }

    function updateCartForms(variant) {
      if (!variant) return;
      document.querySelectorAll('form[action*="/cart/add"] input[name="id"]').forEach(function (input) {
        input.value = variant.id;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      });
      document.querySelectorAll('form[action*="/cart/add"] select[name="id"]').forEach(function (sel) {
        sel.value = String(variant.id);
        sel.dispatchEvent(new Event('change', { bubbles: true }));
      });
    }

    function updateUrl(variant) {
      if (!variant || !window.history || !history.replaceState) return;
      var url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      history.replaceState({}, '', url.toString());
    }

    function syncLabels() {
      root.querySelectorAll('.sh-option').forEach(function (fs) {
        var pos = fs.dataset.optionPosition;
        var active = fs.querySelector('.sh-pill.is-selected');
        var label = root.querySelector('[data-sh-selected-for="' + pos + '"]');
        if (label && active) label.textContent = active.textContent.trim();
      });
    }

    function apply() {
      var opts = selectedOptions();
      var variant = findVariant(opts);
      markAvailability(opts);
      syncLabels();
      if (!variant) return;
      updatePrice(variant);
      updateCartForms(variant);
      updateUrl(variant);
      if (gallery && typeof gallery.shGoTo === 'function' && variant.media_index !== null) {
        gallery.shGoTo(variant.media_index);
      }
      root.dispatchEvent(new CustomEvent('sh:variant:change', { bubbles: true, detail: variant }));
    }

    pills.forEach(function (pill) {
      pill.addEventListener('click', function () {
        var fs = pill.closest('.sh-option');
        fs.querySelectorAll('.sh-pill').forEach(function (p) {
          p.classList.remove('is-selected');
          p.setAttribute('aria-pressed', 'false');
        });
        pill.classList.add('is-selected');
        pill.setAttribute('aria-pressed', 'true');
        apply();
      });
    });

    apply();
  })();
</script>
