{% comment %}
==========================================================================
  SHEENE - Product extras: Ingredients + Results
==========================================================================

  Snippet ka naam:  sheene-product-extras

  ISTEMAAL
  --------
  Product information section ke NEECHE alag section mein Custom Liquid:

      {% render 'sheene-product-extras' %}

  Sirf ek cheez chahiye:
      {% render 'sheene-product-extras', part: 'ingredients' %}
      {% render 'sheene-product-extras', part: 'results' %}

  Home page par saare results (kisi product se nahi):
      {% render 'sheene-product-extras', part: 'results', source: 'all', limit: 8 %}

  Mobile par expert quote bhi isi ke top par aata hai (SHOW_EXPERT_MOBILE).
  Desktop par woh product page mein slider ke neeche hai.

  Jiska admin data khali ho woh hide. Block galti se product ke right
  column mein chala jaye to bhi page load par khud section ke neeche
  full width chala jata hai.

  ADMIN
  -----
  Product metafields (namespace custom):
    pp_ingredients   Metaobject ref(s) > product_ingredient_card
    pp_results       Metaobject ref(s) > product_result_card
    Single ya list, dono chalte hain.

  Metaobjects:
    product_ingredient_card  name, description (multi line), image
    product_result_card      name, duration, quote (multi line),
                             image / after_image / before_image (jo bhara ho),
                             product (product ref, optional)
{% endcomment %}

{% liquid
  assign product = product | default: closest.product
  assign part = part | default: 'all'
  assign source = source | default: 'product'
  assign limit = limit | default: 8

  # SAFE_MODE = true: extras mover script band
  assign SAFE_MODE = false
  assign SHOW_EXPERT_MOBILE = true

  assign INGREDIENTS_HEADING = 'Ingredients that make a difference'
  assign RESULTS_HEADING = 'Results you can trust'
  assign RESULTS_SUBHEADING = 'Real customers. Unedited photos.'
  assign RESULT_IMAGE_RATIO = '1 / 1'

  if part != 'all'
    assign SHOW_EXPERT_MOBILE = false
  endif
%}

{% comment %} ================================================================
     EXPERT QUOTE, sirf mobile par (desktop par product page slider ke neeche hai)
   ================================================================ {% endcomment %}
{% assign expert_html = '' %}
{% if SHOW_EXPERT_MOBILE %}
  {% liquid
    assign ex_field = product.metafields.custom.pp_expert
    if ex_field == blank
      assign ex_field = product.metafields.custom.expert_quote
    endif
    assign ex = nil
    if ex_field.type contains 'list.'
      for e in ex_field.value limit: 1
        assign ex = e
      endfor
    else
      assign ex = ex_field.value
    endif
  %}
  {% if ex != blank and ex.quote.value != blank %}
    {% capture expert_html %}
      <figure class="sh-expert">
        {% if ex.photo.value != blank %}
          {% assign ex_alt = ex.name.value | escape %}
          <div class="sh-expert__photo">
            {{ ex.photo.value | image_url: width: 200 | image_tag: loading: 'lazy', alt: ex_alt }}
          </div>
        {% endif %}
        <span class="sh-expert__mark" aria-hidden="true">&rdquo;</span>
        <div>
          <blockquote class="sh-expert__quote">{{ ex.quote.value | escape | newline_to_br }}</blockquote>
          {% if ex.name.value != blank %}
            <figcaption class="sh-expert__by">
              {{ ex.name.value | escape }}
              {% if ex.credentials.value != blank %}<span class="sh-expert__cred">{{ ex.credentials.value | escape }}</span>{% endif %}
            </figcaption>
          {% endif %}
        </div>
      </figure>
    {% endcapture %}
    <style>
  .sh-expert {
    position: relative;
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    margin: 0;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    background: #F7F7F5;
    border-radius: 16px;
    font-family: var(--font-body--family, system-ui, sans-serif);
    color: var(--color-foreground, #111111);
  }
  .sh-expert__photo {
    flex: 0 0 auto;
    width: clamp(64px, 56px + 2vw, 88px);
    height: clamp(64px, 56px + 2vw, 88px);
    border-radius: 50%;
    overflow: hidden;
    background: #E8E8E5;
  }
  .sh-expert__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sh-expert__mark {
    position: absolute;
    top: 0.75rem;
    right: 1.1rem;
    font-size: 3rem;
    line-height: 1;
    font-weight: 700;
    color: rgb(var(--color-foreground-rgb, 17 17 17) / 0.12);
  }
  .sh-expert__quote {
    margin: 0;
    font-size: clamp(0.95rem, 0.9rem + 0.2vw, 1.05rem);
    line-height: 1.55;
    color: rgb(var(--color-foreground-rgb, 17 17 17) / 0.82);
  }
  .sh-expert__by { margin: 0.9rem 0 0; font-weight: 600; font-size: clamp(0.9rem, 0.86rem + 0.15vw, 1rem); }
  .sh-expert__cred { display: block; font-weight: 400; font-size: 0.88em; color: rgb(var(--color-foreground-rgb, 17 17 17) / 0.65); margin-top: 0.15rem; }
  .sh-expert-wrap { display: grid; gap: 1.5rem; align-items: start; }
  @media (min-width: 750px) {
    .sh-expert-wrap--split { grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 1rem + 2vw, 3rem); }
  }
  .sh-gallery-expert { margin-top: 1.5rem; }
  @media (min-width: 750px) { .sh-expert-mobile { display: none; } }
</style>
  {% endif %}
{% endif %}


<style>
  .sh-x {
    --sh-x-hair: rgb(var(--color-border-rgb, 17 17 17) / 0.14);
    --sh-x-muted: rgb(var(--color-foreground-rgb, 17 17 17) / 0.65);
    font-family: var(--font-body--family, system-ui, sans-serif);
    color: var(--color-foreground, #111111);
    width: 100%;
    max-width: 1240px;
    margin-inline: auto;
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }
  .sh-extras { width: 100%; }
  .sh-extras { box-sizing: border-box; }
  .sh-extras > .sh-x:not(.sh-x--band) { padding-inline: 0; }

  /* Ingredients band: andar padding, gol corners, cards kinare se nahi chipakte */
  .sh-x.sh-x--band {
    box-sizing: border-box;
    width: 100%;
    max-width: 1240px;
    margin-inline: auto;
    background: #F7F7F5;
    border-radius: 20px;
    padding: clamp(1.75rem, 1.25rem + 2vw, 3.25rem) clamp(1rem, 0.5rem + 2.5vw, 2.75rem);
  }
  .sh-x--band + .sh-x { margin-top: clamp(0.5rem, 0.3rem + 1vw, 1.5rem); }
  .sh-x-inner { width: 100%; }

  @media (max-width: 749px) {
    .sh-x.sh-x--band { border-radius: 16px; padding: 1.75rem 0.9rem; }
  }
  .sh-x-head { text-align: center; margin-bottom: clamp(1.25rem, 1rem + 1vw, 2rem); }
  .sh-x-title {
    margin: 0;
    font-family: var(--font-h2--family, var(--font-heading--family, system-ui, sans-serif));
    font-weight: var(--font-h2--weight, 700);
    font-size: clamp(1.4rem, 1.1rem + 1.1vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .sh-x-sub { margin: 0.4rem 0 0; font-size: clamp(0.9rem, 0.86rem + 0.15vw, 1rem); color: var(--sh-x-muted); }

  /* ---------- ingredients ---------- */
  .sh-ingr-grid { display: grid; gap: 0.9rem; }
  @media (min-width: 750px) { .sh-ingr-grid { grid-template-columns: 1fr 1fr; gap: 1rem; } }
  .sh-ingr {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--sh-x-hair);
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-background, #FFFFFF);
  }
  .sh-ingr__img { flex: 0 0 clamp(100px, 18vw, 190px); background: #F2F2F0; }
  .sh-ingr__img img { width: 100%; height: 100%; min-height: clamp(100px, 14vw, 170px); object-fit: cover; display: block; }
  .sh-ingr__body { flex: 1 1 auto; min-width: 0; padding: clamp(0.9rem, 0.7rem + 1vw, 1.75rem); display: flex; flex-direction: column; justify-content: center; gap: 0.3rem; }
  .sh-ingr__name { margin: 0; font-weight: 600; font-size: clamp(0.95rem, 0.9rem + 0.2vw, 1.05rem); }
  .sh-ingr__desc { margin: 0; font-size: clamp(0.85rem, 0.82rem + 0.12vw, 0.93rem); line-height: 1.45; color: var(--sh-x-muted); }

  /* ---------- results ---------- */
  .sh-res-track {
    --sh-res-gap: 1rem;
    display: flex;
    gap: var(--sh-res-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 0.25rem;
  }
  .sh-res-track::-webkit-scrollbar { display: none; }
  .sh-res {
    flex: 0 0 78%;
    scroll-snap-align: start;
    border: 1px solid var(--sh-x-hair);
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-background, #FFFFFF);
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 750px) { .sh-res { flex-basis: calc((100% - 2 * var(--sh-res-gap)) / 3); } }
  @media (min-width: 1100px) { .sh-res { flex-basis: calc((100% - 3 * var(--sh-res-gap)) / 4); } }
  .sh-res__img { position: relative; aspect-ratio: {{ RESULT_IMAGE_RATIO }}; background: #F2F2F0; overflow: hidden; }
  .sh-res__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sh-res__tag {
    position: absolute;
    left: 0.5rem;
    bottom: 0.5rem;
    padding: 0.25em 0.6em;
    border-radius: 999px;
    background: rgb(17 17 17 / 0.72);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .sh-res__body { padding: 0.9rem 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .sh-res__top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .sh-res__name { margin: 0; font-weight: 600; font-size: clamp(0.95rem, 0.9rem + 0.15vw, 1.02rem); }
  .sh-res__dur {
    padding: 0.2em 0.65em;
    border-radius: 999px;
    background: var(--color-foreground, #111111);
    color: var(--color-background, #FFFFFF);
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .sh-res__quote { margin: 0; font-size: clamp(0.85rem, 0.82rem + 0.12vw, 0.93rem); line-height: 1.5; color: var(--sh-x-muted); }
  .sh-res__prod { margin-top: auto; font-size: 0.85rem; font-weight: 600; color: inherit; text-decoration: underline; text-underline-offset: 3px; }
</style>

{% if part == 'all' %}<div class="sh-extras" id="ShExtras-{{ product.id }}">{% endif %}

{% if SHOW_EXPERT_MOBILE and expert_html != blank %}
  <div class="sh-x sh-expert-mobile">{{ expert_html }}</div>
{% endif %}

{% comment %} ============ INGREDIENTS ============ {% endcomment %}
{% if part == 'all' or part == 'ingredients' %}
  {% assign ingr = product.metafields.custom.pp_ingredients.value %}
  {% if ingr != blank and ingr.size > 0 %}
    <section class="sh-x sh-x--band" aria-labelledby="ShIngr-{{ product.id }}">
      <div class="sh-x-inner">
      <div class="sh-x-head">
        <h2 class="sh-x-title" id="ShIngr-{{ product.id }}">{{ INGREDIENTS_HEADING }}</h2>
      </div>
      <div class="sh-ingr-grid">
        {% for it in ingr %}
          {% if it.name.value != blank %}
            <article class="sh-ingr">
              {% if it.image.value != blank %}
                {% assign it_alt = it.name.value | escape %}
                <div class="sh-ingr__img">
                  {{ it.image.value | image_url: width: 300 | image_tag: loading: 'lazy', alt: it_alt, widths: '150,240,300', sizes: '120px' }}
                </div>
              {% endif %}
              <div class="sh-ingr__body">
                <h3 class="sh-ingr__name">{{ it.name.value | escape }}</h3>
                {% if it.description.value != blank %}
                  <p class="sh-ingr__desc">{{ it.description.value | escape | newline_to_br }}</p>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
      </div>
    </section>
  {% endif %}
{% endif %}

{% comment %} ============ RESULTS ============ {% endcomment %}
{% if part == 'all' or part == 'results' %}
  {% liquid
    assign res_list = nil
    assign res_single = nil
    assign res_is_single = false
    assign res_count = 0
    if source == 'all'
      assign res_list = shop.metaobjects.product_result_card.values
      if res_list.size == 0
        assign res_list = shop.metaobjects.result_card.values
      endif
      assign res_count = res_list.size | default: 0
    else
      assign res_field = product.metafields.custom.pp_results
      if res_field.type contains 'list.'
        assign res_list = res_field.value
        assign res_count = res_list.size | default: 0
      elsif res_field.value != blank
        assign res_single = res_field.value
        assign res_is_single = true
        assign res_count = 1
      endif
    endif
    if res_count > limit
      assign res_count = limit
    endif
  %}
  {% capture res_cards %}
    {% if res_count > 0 %}
    {% for n in (1..res_count) %}
      {% liquid
        if res_is_single
          assign r = res_single
        else
          assign r_i = n | minus: 1
          for rr in res_list offset: r_i limit: 1
            assign r = rr
          endfor
        endif
        assign r_img = r.image.value
        if r_img == blank
          assign r_img = r.after_image.value
        endif
        if r_img == blank
          assign r_img = r.before_image.value
        endif
        assign r_prod = nil
        assign r_img = r_img
        if r.product.value != blank
          for p in r.product.value limit: 1
            assign r_prod = p
          endfor
          if r_prod == blank
            assign r_prod = r.product.value
          endif
        endif
        assign r_alt = r.name.value | default: RESULTS_HEADING | escape
      %}
      {% if r_img != blank %}
        <article class="sh-res">
          <div class="sh-res__img">
            {{ r_img | image_url: width: 900 | image_tag: loading: 'lazy', alt: r_alt, widths: '360,540,720,900', sizes: '(min-width: 1100px) 24vw, (min-width: 750px) 32vw, 80vw' }}
          </div>
          <div class="sh-res__body">
            <div class="sh-res__top">
              {% if r.name.value != blank %}<h3 class="sh-res__name">{{ r.name.value | escape }}</h3>{% endif %}
              {% if r.duration.value != blank %}<span class="sh-res__dur">{{ r.duration.value | escape }}</span>{% endif %}
            </div>
            {% if r.quote.value != blank %}<p class="sh-res__quote">{{ r.quote.value | escape }}</p>{% endif %}
            {% if source == 'all' and r_prod != blank and r_prod.url != blank %}
              <a class="sh-res__prod" href="{{ r_prod.url }}">{{ r_prod.title }}</a>
            {% endif %}
          </div>
        </article>
      {% endif %}
    {% endfor %}
    {% endif %}
  {% endcapture %}
  {% if res_cards contains 'sh-res__img' %}
    <section class="sh-x" aria-labelledby="ShRes-{{ product.id | default: 'home' }}">
      <div class="sh-x-head">
        <h2 class="sh-x-title" id="ShRes-{{ product.id | default: 'home' }}">{{ RESULTS_HEADING }}</h2>
        {% if RESULTS_SUBHEADING != blank %}<p class="sh-x-sub">{{ RESULTS_SUBHEADING }}</p>{% endif %}
      </div>
      <div class="sh-res-track">{{ res_cards }}</div>
    </section>
  {% endif %}
{% endif %}

{% if part == 'all' %}
  </div>
  {% unless SAFE_MODE %}
  <script>
    (function () {
      /* Extras block galti se product ke right column mein ho to bhi
         khud product section ke neeche full width chala jata hai. */
      var el = document.getElementById('ShExtras-{{ product.id }}');
      if (!el || el.dataset.shMoved) return;
      el.dataset.shMoved = '1';
      var sec = el.closest('.shopify-section');
      if (sec && sec.querySelector('.sh-gallery, .sh-pdp')) sec.after(el);
      if (!el.children.length || !el.textContent.trim()) el.remove();
    })();
  </script>
  {% endunless %}
{% endif %}
