{% comment %}
==========================================================================
  SHEENE - Product Media Gallery / Slider
  File 1 of 2. Paste into a "Custom Liquid" block on the MEDIA side of the
  product page (left column, first block).

  The matching info block lives in: sheene-product-info.liquid
  That file talks to this one by id (ShGallery-{{ product.id }}), so when a
  shopper picks a variant the gallery jumps to that variant's image.
  Both files work fine on their own too.

  Fully dynamic:
  - Loops product.media, so it shows whatever a product actually has.
  - Handles image, self-hosted video, external video (YouTube/Vimeo) and
    3D model. If a product has no video, no video code runs.
  - One media item means no arrows and no dots. No pointless controls.
  - Swipe works on mobile and tablet. Sizing is fluid, no fixed breakpoints.

  Image shape: change --sh-gallery-ratio in the CSS below.
  1 / 1 square, 4 / 5 portrait, 3 / 4 tall.
{% endcomment %}

{% liquid
  assign media_count = product.media.size
%}

<div class="sh-gallery" id="ShGallery-{{ product.id }}" data-total="{{ media_count }}">

  <div class="sh-gallery-viewport">
    {% if media_count > 0 %}
      <div class="sh-gallery-track">
        {% for media in product.media %}
          <div class="sh-gallery-slide" data-index="{{ forloop.index0 }}">
            {% case media.media_type %}

              {% when 'image' %}
                {{
                  media
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    fetchpriority: 'auto',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    widths: '400,600,800,1000,1200,1600',
                    alt: media.alt | default: product.title,
                    class: 'sh-gallery-media'
                }}

              {% when 'video' %}
                {{
                  media
                  | video_tag:
                    controls: true,
                    autoplay: false,
                    loop: false,
                    muted: false,
                    class: 'sh-gallery-media'
                }}

              {% when 'external_video' %}
                <div class="sh-gallery-media sh-gallery-media--embed">
                  {{ media | external_video_tag }}
                </div>

              {% when 'model' %}
                {{ media | model_viewer_tag: class: 'sh-gallery-media' }}

            {% endcase %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="sh-gallery-slide sh-gallery-empty"></div>
    {% endif %}

    {% if media_count > 1 %}
      <button type="button" class="sh-gallery-arrow sh-gallery-arrow--prev" data-direction="prev" aria-label="Previous image">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg>
      </button>
      <button type="button" class="sh-gallery-arrow sh-gallery-arrow--next" data-direction="next" aria-label="Next image">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
      </button>
    {% endif %}
  </div>

  {% if media_count > 1 %}
    <div class="sh-gallery-dots" role="tablist" aria-label="Product images">
      {% for media in product.media %}
        <button type="button" class="sh-gallery-dot" data-goto="{{ forloop.index0 }}" aria-label="Go to image {{ forloop.index }}"></button>
      {% endfor %}
    </div>
  {% endif %}

</div>

<style>
  .sh-gallery {
    width: 100%;
    /* one knob for the image shape: 1/1 square, 4/5 portrait, 3/4 tall */
    --sh-gallery-ratio: 1 / 1;
  }

  .sh-gallery-viewport {
    position: relative;
    width: 100%;
    aspect-ratio: var(--sh-gallery-ratio);
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb, 17 17 17) / 0.04);
    border-radius: var(--style-border-radius-md, 0);
    touch-action: pan-y;
    overscroll-behavior-x: contain;
  }

  .sh-gallery-track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 0.4s var(--ease-out-quad, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .sh-gallery-slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sh-gallery-empty {
    background: rgb(var(--color-foreground-rgb, 17 17 17) / 0.04);
  }

  .sh-gallery-media,
  .sh-gallery-media video,
  .sh-gallery-media model-viewer {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sh-gallery-media--embed {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .sh-gallery-media--embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .sh-gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgb(var(--color-background-rgb, 255 255 255) / 0.85);
    color: var(--color-foreground, #111111);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--animation-speed, 0.15s) ease;
  }
  .sh-gallery-arrow--prev { left: 0.75rem; }
  .sh-gallery-arrow--next { right: 0.75rem; }
  .sh-gallery-arrow:hover { background: var(--color-background, #FFFFFF); }
  .sh-gallery-arrow:focus-visible {
    outline: var(--focus-outline-width, 2px) solid var(--color-foreground, #111111);
    outline-offset: 2px;
  }

  .sh-gallery-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--gap-xs, 0.5rem);
    margin-top: var(--margin-lg, 1rem);
  }

  .sh-gallery-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-foreground-rgb, 17 17 17) / 0.35);
    background: transparent;
    padding: 0;
    cursor: pointer;
    transition: background var(--animation-speed, 0.15s) ease;
  }
  .sh-gallery-dot.is-active {
    background: var(--color-foreground, #111111);
    border-color: var(--color-foreground, #111111);
  }
  .sh-gallery { grid-column: 2; }
  .sh-pdp { grid-column: 2; }
</style>

<script>
  (function () {
    var root = document.getElementById('ShGallery-{{ product.id }}');
    if (!root) return;

    var total = parseInt(root.dataset.total, 10) || 0;
    var track = root.querySelector('.sh-gallery-track');
    var dots = root.querySelectorAll('.sh-gallery-dot');
    var arrows = root.querySelectorAll('.sh-gallery-arrow');
    var index = 0;

    function pauseAllVideos() {
      root.querySelectorAll('video').forEach(function (v) { v.pause(); });
    }

    function goTo(newIndex) {
      if (total < 1 || !track) return;
      index = ((newIndex % total) + total) % total;
      track.style.transform = 'translateX(-' + (index * 100) + '%)';
      dots.forEach(function (dot, i) {
        dot.classList.toggle('is-active', i === index);
      });
      pauseAllVideos();
    }

    // exposed so the variant picker below can jump the gallery
    root.shGoTo = goTo;

    if (total > 1) {
      arrows.forEach(function (btn) {
        btn.addEventListener('click', function () {
          goTo(btn.dataset.direction === 'next' ? index + 1 : index - 1);
        });
      });

      dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          goTo(parseInt(dot.dataset.goto, 10));
        });
      });

      var viewport = root.querySelector('.sh-gallery-viewport');
      var startX = 0;
      viewport.addEventListener('touchstart', function (e) {
        startX = e.touches[0].clientX;
      }, { passive: true });
      viewport.addEventListener('touchend', function (e) {
        var deltaX = startX - e.changedTouches[0].clientX;
        if (Math.abs(deltaX) > 40) goTo(deltaX > 0 ? index + 1 : index - 1);
      }, { passive: true });
    }

    goTo(0);
  })();
</script>
