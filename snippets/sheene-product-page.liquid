{% comment %}
==========================================================================
  SHEENE - Product page (slider, body, goes well with)
==========================================================================

  Snippet ka naam:  sheene-product-page
  Ingredients aur Results ab alag file mein hain:  sheene-product-extras

  PAGE PAR CALLS
  --------------
    1. Right column (Slider/Body block):
         {% render 'sheene-product-page' %}
       Slider + expert quote (slider ke neeche) + tags, title, rating,
       price, intro, benefits, delivery, perks, variants.

    2. Buy buttons ke neeche:
         {% render 'sheene-product-page', part: 'goes_well' %}

    3. Product section ke neeche alag section (doosri file):
         {% render 'sheene-product-extras' %}

  Chahiye to 'slider' aur 'body' alag bhi chal jate hain.
  Har cheez khud check karti hai: admin mein data hai to dikhegi, warna hide.

  EXPERT QUOTE
    EXPERT_UNDER_SLIDER = true          desktop par slider ke theek neeche.
                                        Left column sticky rehta hai: lamba
                                        ho to pehle scroll, phir bottom par
                                        chipak jata hai.
    EXPERT_MOBILE_UNDER_SLIDER = false  mobile par slider ke neeche nahi;
                                        extras file mobile par usay apne top
                                        par dikhati hai, taake title aur price
                                        upar rahen. true = mobile par bhi
                                        slider ke neeche (tab extras file mein
                                        SHOW_EXPERT_MOBILE = false karo).

  ADMIN: PRODUCT METAFIELDS (namespace custom)
  --------------------------------------------
    pp_badges           List of single line text   Tags. Text | color | icon
                        color: neutral, blue, yellow, purple, green, pink,
                        orange, dark, ya hex (#A98BDE ya #FAF6C8/#2F5E8C)
                        icon: truck, check, sparkle, drop, leaf
    pp_subtitle         Single line text           "Includes 5 Products"
    sold_count          Integer                    Asli units sold
    pp_intro            Rich text                  Price ke neeche text
    pp_benefits         List of single line text   Check wali pills
    goes_well_products  List of product refs       Goes Well With
    pp_refer_products   List of product refs       Bhara ho to Goes Well ki
                                                   jagah "We recommend instead"
    pp_refer_heading    Single line text           optional
    pp_refer_note       Single line text           optional
    expert_quote        Metaobject ref > expert_quote (single ya list,
                        list ho to pehli entry). pp_expert bhi chalega.

  ADMIN: METAOBJECT
    expert_quote     name, credentials, quote (multi line), photo (image)

  PERKS ROW
  ---------
  Ek card: upar progress bar + "Rs.X away from <agla reward>", neeche teen
  rewards ki rows, har row green (unlocked) ya red (Add Rs.X more). Card ke
  neeche Dermatologist aur Returns chhoti trust line. Threshold 0 ho to
  hamesha green ("On all orders"). Cart kahin se bhi badle, sab khud update.

  ESTIMATED DELIVERY
  ------------------
  Light timeline card (Purchased > Processing > Delivered).
    DELIVERY_MIN_DAYS / MAX_DAYS   delivery window, aaj se kitne din
    ETA_PROCESS_DAYS               processing kitne din
    ETA_CUTOFF_HOUR                is ghante tak order = aaj ka order
  Sab Karachi time par, har 30 second update.

  REVIEW STARS
  ------------
  Judge.me (reviews.rating) ya Loox. Click Judge.me widget tak le jata hai.
{% endcomment %}


{% liquid
  assign part = part | default: 'all'
  assign product = product | default: closest.product

  # ================= BODY / SLIDER =================
  # SAFE_MODE = true: sticky JS, cart watcher aur  JS band. Debug ke liye.
  assign SAFE_MODE = false

  assign GALLERY_RATIO = '1 / 1'
  assign MEDIA_WIDTH = '52%'
  assign MAX_WIDTH = '1240px'
  assign COLUMN_GAP = '48px'
  assign STICKY_MEDIA = true

  assign VARIANT_BOX_TITLE = 'Choose variants'
  assign OPTION_LABEL_PREFIX = 'Select'
  assign PILL_RADIUS = '4px'

  assign HIDE_ARROWS_MOBILE = true
  assign MOBILE_GALLERY_GAP = '1.75rem'

  assign SHOW_EMPTY_STATE = false
  assign REVIEWS_ANCHOR = '#judgeme_product_reviews'

  assign TAG_RADIUS = '8px'
  assign STAR_COLOR = '#F2C230'
  assign SHOW_REVIEW_COUNT = true
  assign SOLD_MIN = 1
  assign SOLD_SUFFIX = 'Sold'

  # ---- perks: thresholds PKR mein ----
  assign FREE_DELIVERY_MIN = 2500
  assign TESTERS_MIN = 4000
  assign DISCOUNT_MIN = 2500

  assign FREE_DELIVERY_LABEL = 'Free Delivery'
  assign TESTERS_LABEL = 'Free 5 ml tester bottles'
  assign DISCOUNT_LABEL = 'Extra 10% off'
  assign PERK_MET_TEXT = 'Unlocked'
  assign PERK_ALWAYS_TEXT = 'On all orders'
  assign PERKS_AWAY_TEXT = 'away from'
  assign PERKS_ALL_TEXT = 'All rewards unlocked on this order'

  assign SHOW_DERMATOLOGIST = true
  assign DERMATOLOGIST_LABEL = 'Dermatologist Trusted Brand'
  assign RETURNS_LABEL = 'Easy Returns, 3 days'

  assign COLOR_MET = '#2E7D4F'
  assign COLOR_UNMET = '#C0392B'

  # ---- delivery estimate ----
  assign SHOW_DELIVERY = true
  assign DELIVERY_MIN_DAYS = 2
  assign DELIVERY_MAX_DAYS = 4
  assign ETA_CUTOFF_HOUR = 24
  assign ETA_PROCESS_DAYS = 1
  assign ETA_STEP_1 = 'Purchased'
  assign ETA_STEP_2 = 'Processing'
  assign ETA_STEP_3 = 'Delivered'

  # ================= GOES WELL / REFER =================
  assign GWW_HEADING = 'Goes well with'
  assign REFER_HEADING = 'We recommend instead'
  assign REFER_BUTTON = 'View product'
  assign ADD_TEXT = 'Add to cart'
  assign SELECT_TEXT = 'Select size'
  assign SOLD_OUT_TEXT = 'Sold out'
  assign MAX_ITEMS = 7


  # ================= EXPERT QUOTE =================
  assign EXPERT_UNDER_SLIDER = true
  assign EXPERT_MOBILE_UNDER_SLIDER = false
%}

{% comment %} ================================================================
     EXPERT QUOTE (ek dafa banta hai, slider ke neeche ya extras mein lagta hai)
   ================================================================ {% endcomment %}
{% assign expert_html = '' %}
{% if part == 'slider' or part == 'all' %}
  {% liquid
    assign ex_field = product.metafields.custom.pp_expert
    if ex_field == blank
      assign ex_field = product.metafields.custom.expert_quote
    endif
    assign ex = nil
    if ex_field.type contains 'list.'
      for e in ex_field.value limit: 1
        assign ex = e
      endfor
    else
      assign ex = ex_field.value
    endif
  %}
  {% if ex != blank and ex.quote.value != blank %}
    {% capture expert_html %}
      <figure class="sh-expert">
        {% if ex.photo.value != blank %}
          {% assign ex_alt = ex.name.value | escape %}
          <div class="sh-expert__photo">
            {{ ex.photo.value | image_url: width: 200 | image_tag: loading: 'lazy', alt: ex_alt }}
          </div>
        {% endif %}
        <span class="sh-expert__mark" aria-hidden="true">&rdquo;</span>
        <div>
          <blockquote class="sh-expert__quote">{{ ex.quote.value | escape | newline_to_br }}</blockquote>
          {% if ex.name.value != blank %}
            <figcaption class="sh-expert__by">
              {{ ex.name.value | escape }}
              {% if ex.credentials.value != blank %}<span class="sh-expert__cred">{{ ex.credentials.value | escape }}</span>{% endif %}
            </figcaption>
          {% endif %}
        </div>
      </figure>
    {% endcapture %}
    <style>
  .sh-expert {
    position: relative;
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    margin: 0;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    background: #F7F7F5;
    border-radius: 16px;
    font-family: var(--font-body--family, system-ui, sans-serif);
    color: var(--color-foreground, #111111);
  }
  .sh-expert__photo {
    flex: 0 0 auto;
    width: clamp(64px, 56px + 2vw, 88px);
    height: clamp(64px, 56px + 2vw, 88px);
    border-radius: 50%;
    overflow: hidden;
    background: #E8E8E5;
  }
  .sh-expert__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sh-expert__mark {
    position: absolute;
    top: 0.75rem;
    right: 1.1rem;
    font-size: 3rem;
    line-height: 1;
    font-weight: 700;
    color: rgb(var(--color-foreground-rgb, 17 17 17) / 0.12);
  }
  .sh-expert__quote {
    margin: 0;
    font-size: clamp(0.95rem, 0.9rem + 0.2vw, 1.05rem);
    line-height: 1.55;
    color: rgb(var(--color-foreground-rgb, 17 17 17) / 0.82);
  }
  .sh-expert__by { margin: 0.9rem 0 0; font-weight: 600; font-size: clamp(0.9rem, 0.86rem + 0.15vw, 1rem); }
  .sh-expert__cred { display: block; font-weight: 400; font-size: 0.88em; color: rgb(var(--color-foreground-rgb, 17 17 17) / 0.65); margin-top: 0.15rem; }
  .sh-expert-wrap { display: grid; gap: 1.5rem; align-items: start; }
  @media (min-width: 750px) {
    .sh-expert-wrap--split { grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 1rem + 2vw, 3rem); }
  }
  .sh-gallery-expert { margin-top: 1.5rem; }
  {% unless EXPERT_MOBILE_UNDER_SLIDER %}
  @media (max-width: 749px) { .sh-gallery-expert { display: none; } }
  {% endunless %}
  @media (min-width: 750px) { .sh-expert-mobile { display: none; } }
</style>
  {% endif %}
{% endif %}

{% assign sticky_on = STICKY_MEDIA %}

{% comment %} ================================================================
     SLIDER + BODY
   ================================================================ {% endcomment %}
{% if part == 'slider' or part == 'body' or part == 'all' %}
<style>
  .sh-gallery {
    width: 100%;
    --sh-gallery-ratio: {{ GALLERY_RATIO }};
  }

  .sh-gallery-viewport {
    position: relative;
    width: 100%;
    aspect-ratio: var(--sh-gallery-ratio);
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb, 17 17 17) / 0.04);
    border-radius: var(--style-border-radius-md, 0);
    touch-action: pan-y;
    overscroll-behavior-x: contain;
  }

  .sh-gallery-track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 0.4s var(--ease-out-quad, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .sh-gallery-slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sh-gallery-empty { background: rgb(var(--color-foreground-rgb, 17 17 17) / 0.04); }

  .sh-gallery-media,
  .sh-gallery-media video,
  .sh-gallery-media model-viewer {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sh-gallery-media--embed { position: relative; width: 100%; height: 100%; }
  .sh-gallery-media--embed iframe { width: 100%; height: 100%; border: 0; }

  .sh-gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgb(var(--color-background-rgb, 255 255 255) / 0.85);
    color: var(--color-foreground, #111111);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--animation-speed, 0.15s) ease;
  }
  .sh-gallery-arrow--prev { left: 0.75rem; }
  .sh-gallery-arrow--next { right: 0.75rem; }
  .sh-gallery-arrow:hover { background: var(--color-background, #FFFFFF); }
  .sh-gallery-arrow:focus-visible {
    outline: var(--focus-outline-width, 2px) solid var(--color-foreground, #111111);
    outline-offset: 2px;
  }

  .sh-gallery-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--gap-xs, 0.5rem);
    margin-top: var(--margin-lg, 1rem);
  }

  .sh-gallery-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-foreground-rgb, 17 17 17) / 0.35);
    background: transparent;
    padding: 0;
    cursor: pointer;
    transition: background var(--animation-speed, 0.15s) ease;
  }
  .sh-gallery-dot.is-active {
    background: var(--color-foreground, #111111);
    border-color: var(--color-foreground, #111111);
  }

  /* ---------- info column ---------- */
  .sh-pdp {
    --sh-gap: var(--margin-lg, 1rem);
    --sh-muted: rgb(var(--color-foreground-rgb, 17 17 17) / var(--opacity-muted-text, 0.6));
    --sh-line: rgb(var(--color-foreground-rgb, 17 17 17) / 0.22);
    --sh-hair: rgb(var(--color-border-rgb, 17 17 17) / 0.14);
    --sh-ok: {{ COLOR_MET }};
    --sh-no: {{ COLOR_UNMET }};

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    width: 100%;
    font-family: var(--font-body--family, system-ui, sans-serif);
    color: var(--color-foreground, #111111);
  }
  .sh-pdp > * { margin: 0; }
  .sh-pdp > * + * { margin-top: var(--sh-gap); }

  /* ---------- tags ---------- */
  .sh-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
  }
  .sh-pdp > .sh-tags + .sh-title { margin-top: 0.85rem; }

  .sh-tag {
    --sh-tag-bg: #F2F2F0;
    --sh-tag-fg: var(--color-foreground, #111111);
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 0.95em;
    border-radius: {{ TAG_RADIUS }};
    background: var(--sh-tag-bg);
    color: var(--sh-tag-fg);
    font-family: var(--font-body--family, system-ui, sans-serif);
    font-style: var(--font-body--style, normal);
    font-weight: 600;
    font-size: clamp(0.8rem, 0.76rem + 0.15vw, 0.9rem);
    line-height: 1.1;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .sh-tag--blue    { --sh-tag-bg: #E3EEFB; --sh-tag-fg: #2F5E8C; }
  .sh-tag--yellow  { --sh-tag-bg: #FAF6C8; --sh-tag-fg: #6B5A0E; }
  .sh-tag--purple  { --sh-tag-bg: #A98BDE; --sh-tag-fg: #FFFFFF; }
  .sh-tag--green   { --sh-tag-bg: #E1F2EA; --sh-tag-fg: #2F6B55; }
  .sh-tag--pink    { --sh-tag-bg: #FBE4EA; --sh-tag-fg: #8C3450; }
  .sh-tag--orange  { --sh-tag-bg: #FCE9DB; --sh-tag-fg: #8A4618; }
  .sh-tag--dark    { --sh-tag-bg: var(--color-foreground, #111111); --sh-tag-fg: var(--color-background, #FFFFFF); }

  .sh-tag__icon { display: block; width: 1.25em; height: 1.25em; flex: 0 0 auto; }
  .sh-tag__icon svg,
  .sh-ico svg {
    width: 100%;
    height: 100%;
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- title / subtitle ---------- */
  .sh-title {
    font-family: var(--font-h1--family, var(--font-heading--family, system-ui, sans-serif));
    font-style: var(--font-h1--style, normal);
    font-weight: var(--font-h1--weight, 700);
    font-size: clamp(1.75rem, 1.2rem + 1.4vw, 2.5rem);
    line-height: var(--font-h1--line-height, 1.15);
    letter-spacing: var(--font-h1--letter-spacing, -0.02em);
    text-transform: var(--font-h1--case, none);
    color: var(--color-foreground, #111111);
    text-wrap: balance;
  }

  .sh-pdp > .sh-title + .sh-meta,
  .sh-pdp > .sh-title + .sh-subtitle,
  .sh-pdp > .sh-meta + .sh-subtitle,
  .sh-pdp > .sh-subtitle + .sh-meta { margin-top: 0.6rem; }

  .sh-subtitle {
    font-size: clamp(0.9rem, 0.86rem + 0.15vw, 1rem);
    line-height: 1.3;
    color: var(--sh-muted);
  }

  /* ---------- rating + sold ---------- */
  .sh-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    font-weight: var(--font-body--weight, 400);
    font-size: clamp(0.95rem, 0.9rem + 0.2vw, 1.05rem);
    line-height: 1;
    color: var(--sh-muted);
  }
  .sh-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    line-height: 1;
  }
  .sh-rating:hover .sh-rating-value { text-decoration: underline; }
  .sh-rating-stars {
    position: relative;
    display: inline-block;
    font-size: 1.35em;
    line-height: 1;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .sh-rating-stars-bg { color: var(--sh-line); }
  .sh-rating-stars-fg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    width: var(--sh-rating, 0%);
    color: {{ STAR_COLOR }};
  }
  .sh-sold { display: inline-flex; align-items: center; gap: 0.75rem; }
  .sh-sold__sep {
    display: inline-block;
    width: 1px;
    height: 1.05em;
    background: currentColor;
    opacity: 0.6;
  }

  /* ---------- price ---------- */
  .sh-price {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-sm, 0.7rem);
    line-height: 1;
  }
  .sh-price-compare {
    color: var(--sh-muted);
    text-decoration: line-through;
    font-size: var(--font-size--md, 1rem);
  }
  .sh-price-current {
    color: var(--color-foreground, #111111);
    font-weight: 600;
    font-size: var(--font-size--xl, 1.25rem);
  }
  .sh-price-badge {
    background: var(--color-foreground, #111111);
    color: var(--color-background, #FFFFFF);
    font-size: var(--font-size--2xs, 0.75rem);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-sm, 0.06em);
    padding: 0.35em 0.7em;
    border-radius: var(--style-border-radius-xs, 0);
  }
  .sh-price [hidden] { display: none !important; }

  /* ---------- intro + benefits ---------- */
  .sh-intro {
    font-size: clamp(0.95rem, 0.9rem + 0.2vw, 1.05rem);
    line-height: 1.55;
    color: rgb(var(--color-foreground-rgb, 17 17 17) / 0.78);
    max-width: 60ch;
  }
  .sh-intro p { margin: 0; }
  .sh-intro p + p { margin-top: 0.6em; }
  .sh-intro strong, .sh-intro b { color: var(--color-foreground, #111111); font-weight: 600; }

  .sh-benefits {
    list-style: none;
    padding: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .sh-benefit {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--sh-hair);
    border-radius: 999px;
    font-size: clamp(0.88rem, 0.84rem + 0.15vw, 0.95rem);
    line-height: 1.3;
  }
  .sh-benefit .sh-ico {
    width: 1.15rem;
    height: 1.15rem;
    flex: 0 0 auto;
    display: block;
  }

  /* ---------- delivery estimate ---------- */
  .sh-eta { width: 100%; }
  .sh-eta__card {
    background: #F7F7F5;
    color: var(--color-foreground, #111111);
    border: 1px solid var(--sh-hair);
    border-radius: 14px;
    padding: clamp(1rem, 0.85rem + 0.6vw, 1.4rem) clamp(1rem, 0.8rem + 0.9vw, 1.6rem);
  }
  .sh-eta__track {
    display: grid;
    grid-template-columns: auto 1fr auto 1fr auto;
    align-items: center;
    gap: 0.6rem;
  }
  .sh-eta__icon { width: clamp(26px, 22px + 1vw, 34px); height: clamp(26px, 22px + 1vw, 34px); display: block; }
  .sh-eta__icon svg { width: 100%; height: 100%; display: block; fill: none; stroke: currentColor; stroke-width: 1.6px; stroke-linecap: round; stroke-linejoin: round; }
  .sh-eta__bar {
    position: relative;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    margin-inline: 0.35rem;
  }
  .sh-eta__bar::before,
  .sh-eta__bar::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    transform: translateY(-50%);
  }
  .sh-eta__bar::before { left: -3px; }
  .sh-eta__bar::after { right: -3px; }

  .sh-eta__steps {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.5rem;
    margin-top: 0.7rem;
  }
  .sh-eta__step { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .sh-eta__step:nth-child(2) { text-align: center; align-items: center; }
  .sh-eta__step:nth-child(3) { text-align: right; align-items: flex-end; }
  .sh-eta__date { font-weight: 700; font-size: clamp(0.8rem, 0.76rem + 0.18vw, 0.92rem); line-height: 1.2; white-space: nowrap; }
  .sh-eta__label { font-size: clamp(0.8rem, 0.76rem + 0.18vw, 0.95rem); line-height: 1.2; color: rgb(var(--color-foreground-rgb, 17 17 17) / 0.65); }

  /* ---------- perks ---------- */
  .sh-perks { width: 100%; display: flex; flex-direction: column; gap: 0.85rem; }
  .sh-perks__card {
    border: 1px solid var(--sh-hair);
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-background, #FFFFFF);
  }
  .sh-perks__head { padding: 0.95rem 1.1rem 0.9rem; background: #F7F7F5; }
  .sh-perks__msg {
    margin: 0 0 0.6rem;
    font-size: clamp(0.85rem, 0.82rem + 0.12vw, 0.93rem);
    line-height: 1.35;
    color: rgb(var(--color-foreground-rgb, 17 17 17) / 0.75);
  }
  .sh-perks__msg strong { color: var(--color-foreground, #111111); font-weight: 700; }
  .sh-perks__bar {
    height: 6px;
    border-radius: 999px;
    background: rgb(var(--color-foreground-rgb, 17 17 17) / 0.1);
    overflow: hidden;
  }
  .sh-perks__fill {
    display: block;
    height: 100%;
    width: var(--sh-progress, 0%);
    border-radius: inherit;
    background: var(--color-foreground, #111111);
    transition: width 0.45s ease, background 0.3s ease;
  }
  .sh-perks__card.is-complete .sh-perks__fill { background: var(--sh-ok); }

  .sh-perks__list { list-style: none; margin: 0; padding: 0; }
  .sh-perk {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1.1rem;
    border-top: 1px solid var(--sh-hair);
    --sh-perk-c: var(--sh-no);
    --sh-perk-bg: rgb(192 57 43 / 0.09);
  }
  .sh-perk.is-met { --sh-perk-c: var(--sh-ok); --sh-perk-bg: rgb(46 125 79 / 0.1); }
  .sh-perk__icon {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--sh-perk-bg);
    color: var(--sh-perk-c);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .sh-perk__icon .sh-ico { width: 18px; height: 18px; display: block; }
  .sh-perk__label {
    flex: 1 1 auto;
    min-width: 0;
    font-weight: 600;
    font-size: clamp(0.88rem, 0.84rem + 0.15vw, 0.97rem);
    line-height: 1.25;
    color: var(--color-foreground, #111111);
  }
  .sh-perk__status {
    flex: 0 0 auto;
    padding: 0.35em 0.75em;
    border-radius: 999px;
    background: var(--sh-perk-bg);
    color: var(--sh-perk-c);
    font-weight: 600;
    font-size: clamp(0.72rem, 0.7rem + 0.1vw, 0.8rem);
    line-height: 1.2;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .sh-perks__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.4rem;
    font-size: clamp(0.8rem, 0.77rem + 0.12vw, 0.88rem);
    color: rgb(var(--color-foreground-rgb, 17 17 17) / 0.7);
  }
  .sh-perks__trust-item { display: inline-flex; align-items: center; gap: 0.45rem; }
  .sh-perks__trust-item .sh-ico { width: 17px; height: 17px; display: block; }

  @media screen and (max-width: 400px) {
    .sh-perk { gap: 0.65rem; padding: 0.75rem 0.9rem; }
    .sh-perks__head { padding: 0.85rem 0.9rem; }
    .sh-perk__icon { width: 30px; height: 30px; }
    .sh-tags { gap: 0.45rem; }
  }

  /* ---------- variants ---------- */
  .sh-variants { width: 100%; }
  .sh-variants-box {
    width: 100%;
    margin: 0;
    padding: 0 1.25rem 1.35rem;
    border: 1px solid rgb(var(--color-border-rgb, 17 17 17) / 0.16);
    border-radius: 12px;
    min-inline-size: 0;
  }
  .sh-variants-legend {
    padding: 0 0.5rem;
    margin-inline-start: 0.25rem;
    font-weight: 600;
    font-size: clamp(0.75rem, 0.7rem + 0.15vw, 0.85rem);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgb(var(--color-foreground-rgb, 17 17 17) / 0.75);
  }
  .sh-option + .sh-option { margin-top: 1.25rem; }
  .sh-option-label {
    display: block;
    margin: 0 0 0.75rem;
    font-weight: 600;
    font-size: clamp(0.95rem, 0.88rem + 0.25vw, 1.05rem);
    color: var(--color-foreground, #111111);
  }
  .sh-option-values { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .sh-pill {
    font-family: var(--font-body--family, system-ui, sans-serif);
    font-style: var(--font-body--style, normal);
    font-weight: var(--font-body--weight, 400);
    font-size: clamp(0.85rem, 0.8rem + 0.15vw, 0.95rem);
    line-height: 1;
    color: var(--color-foreground, #111111);
    background: transparent;
    border: 1px solid rgb(var(--color-border-rgb, 17 17 17) / 0.22);
    border-radius: {{ PILL_RADIUS }};
    padding: 0.85em 1.5em;
    min-height: var(--minimum-touch-target, 44px);
    cursor: pointer;
    transition: border-color var(--animation-speed, 0.15s) ease, box-shadow var(--animation-speed, 0.15s) ease;
  }
  .sh-pill:hover { border-color: rgb(var(--color-border-rgb, 17 17 17) / 0.5); }
  .sh-pill:focus-visible {
    outline: var(--focus-outline-width, 2px) solid var(--color-foreground, #111111);
    outline-offset: var(--focus-outline-offset, 2px);
  }
  .sh-pill.is-selected {
    border-color: var(--color-foreground, #111111);
    box-shadow: inset 0 0 0 1px var(--color-foreground, #111111);
    font-weight: 600;
  }
  .sh-pill.is-unavailable {
    color: rgb(var(--color-foreground-rgb, 17 17 17) / 0.4);
    border-color: rgb(var(--color-border-rgb, 17 17 17) / 0.1);
    text-decoration: line-through;
  }
  .sh-pill.is-unavailable.is-selected { box-shadow: none; font-weight: var(--font-body--weight, 400); }

  /* ---------- mobile ---------- */
  @media screen and (max-width: 749px) {
    {% if HIDE_ARROWS_MOBILE %}.sh-gallery-arrow { display: none; }{% endif %}
    .sh-gallery { margin-bottom: {{ MOBILE_GALLERY_GAP }}; }
  }

  /* ---------- section layout ---------- */
  @media screen and (min-width: 750px) {
    .product-information__grid { grid-template-columns: 1fr !important; }
    .product-information__media { display: none !important; }

    .product-details {
      width: 100%;
      max-width: {{ MAX_WIDTH }};
      margin-inline: auto;
    }

    .layout-panel-flex > *:has(> .sh-gallery),
    .layout-panel-flex > *:has(> .sh-pdp) { display: contents; }

    .layout-panel-flex:has(> * > .sh-gallery) {
      display: grid !important;
      grid-template-columns: {{ MEDIA_WIDTH }} 1fr;
      column-gap: {{ COLUMN_GAP }};
      row-gap: 0;
      align-items: start;
      align-content: start;
    }

    .layout-panel-flex:has(> * > .sh-gallery) > .sh-pdp,
    .layout-panel-flex:has(> * > .sh-gallery) .sh-pdp { margin-block-end: var(--gap-lg, 1rem); }

    .layout-panel-flex:has(> * > .sh-gallery) > .sh-gallery,
    .layout-panel-flex:has(> * > .sh-gallery) .sh-gallery {
      grid-column: 1;
      grid-row: 1 / span 50;
      {% if sticky_on %}position: sticky; top: var(--sh-sticky-top, calc(var(--header-height, 0px) + 1.5rem)); align-self: start;{% endif %}
    }

    .layout-panel-flex--row:has(.sh-gallery) { align-items: flex-start; }
    .layout-panel-flex--row > *:has(> .sh-gallery) {
      flex: 0 0 {{ MEDIA_WIDTH }};
      min-width: 0;
      {% if sticky_on %}position: sticky; top: var(--sh-sticky-top, calc(var(--header-height, 0px) + 1.5rem)); align-self: start;{% endif %}
    }
    .layout-panel-flex--row > *:has(> .sh-pdp) {
      flex: 1 1 0;
      min-width: 0;
      padding-left: {{ COLUMN_GAP }};
    }
  }
</style>
{% endif %}

{% comment %} ============ GALLERY ============ {% endcomment %}
{% if part == 'slider' or part == 'all' %}
  {% assign media_count = product.media.size %}

  <div class="sh-gallery" id="ShGallery-{{ product.id }}" data-total="{{ media_count }}">
    <div class="sh-gallery-viewport">
      {% if media_count > 0 %}
        <div class="sh-gallery-track">
          {% for media in product.media %}
            <div class="sh-gallery-slide" data-index="{{ forloop.index0 }}">
              {% case media.media_type %}
                {% when 'image' %}
                  {{
                    media
                    | image_url: width: 1600
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 750px) 52vw, 100vw',
                      widths: '400,600,800,1000,1200,1600',
                      alt: media.alt | default: product.title,
                      class: 'sh-gallery-media'
                  }}
                {% when 'video' %}
                  {{ media | video_tag: controls: true, autoplay: false, loop: false, muted: false, class: 'sh-gallery-media' }}
                {% when 'external_video' %}
                  <div class="sh-gallery-media sh-gallery-media--embed">{{ media | external_video_tag }}</div>
                {% when 'model' %}
                  {{ media | model_viewer_tag: class: 'sh-gallery-media' }}
              {% endcase %}
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="sh-gallery-slide sh-gallery-empty"></div>
      {% endif %}

      {% if media_count > 1 %}
        <button type="button" class="sh-gallery-arrow sh-gallery-arrow--prev" data-direction="prev" aria-label="Previous image">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg>
        </button>
        <button type="button" class="sh-gallery-arrow sh-gallery-arrow--next" data-direction="next" aria-label="Next image">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
        </button>
      {% endif %}
    </div>

    {% if media_count > 1 %}
      <div class="sh-gallery-dots" aria-label="Product images">
        {% for media in product.media %}
          <button type="button" class="sh-gallery-dot" data-goto="{{ forloop.index0 }}" aria-label="Go to image {{ forloop.index }}"></button>
        {% endfor %}
      </div>
    {% endif %}

    {% if EXPERT_UNDER_SLIDER and expert_html != blank %}
      <div class="sh-gallery-expert">{{ expert_html }}</div>
    {% endif %}
  </div>

  <script>
    (function () {
      var root = document.getElementById('ShGallery-{{ product.id }}');
      if (!root || root.dataset.shInit) return;
      root.dataset.shInit = '1';

      var total = parseInt(root.dataset.total, 10) || 0;
      var track = root.querySelector('.sh-gallery-track');
      var dots = root.querySelectorAll('.sh-gallery-dot');
      var arrows = root.querySelectorAll('.sh-gallery-arrow');
      var index = 0;

      function goTo(n) {
        if (total < 1 || !track) return;
        index = ((n % total) + total) % total;
        track.style.transform = 'translateX(-' + (index * 100) + '%)';
        dots.forEach(function (d, i) { d.classList.toggle('is-active', i === index); });
        root.querySelectorAll('video').forEach(function (v) { v.pause(); });
      }
      root.shGoTo = goTo;

      if (total > 1) {
        arrows.forEach(function (b) {
          b.addEventListener('click', function () {
            goTo(b.dataset.direction === 'next' ? index + 1 : index - 1);
          });
        });
        dots.forEach(function (d) {
          d.addEventListener('click', function () { goTo(parseInt(d.dataset.goto, 10)); });
        });
        var vp = root.querySelector('.sh-gallery-viewport');
        var startX = 0;
        vp.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
        vp.addEventListener('touchend', function (e) {
          var dx = startX - e.changedTouches[0].clientX;
          if (Math.abs(dx) > 40) goTo(dx > 0 ? index + 1 : index - 1);
        }, { passive: true });
      }

      goTo(0);

      {% if sticky_on and SAFE_MODE == false %}
      /* Sticky left column jo viewport se lamba ho: pehle scroll hota hai,
         bottom tak pohanch kar chipak jata hai, jaise jenpharm par. */
      var GAP = 24;
      function headerOffset() {
        var v = parseFloat(getComputedStyle(root).getPropertyValue('--header-height'));
        if (!isNaN(v) && v > 0) return v;
        var h = document.querySelector('header-component, .header-wrapper, header');
        return h ? h.getBoundingClientRect().height : 0;
      }
      function setStickyTop() {
        var base = headerOffset() + GAP;
        var h = root.offsetHeight;
        var vh = window.innerHeight;
        var top = (base + h + GAP > vh) ? (vh - h - GAP) : base;
        var val = top + 'px';
        root.style.setProperty('--sh-sticky-top', val);
        if (root.parentElement) root.parentElement.style.setProperty('--sh-sticky-top', val);
      }
      setStickyTop();
      window.addEventListener('resize', setStickyTop);
      window.addEventListener('load', setStickyTop);
      if (window.ResizeObserver) new ResizeObserver(setStickyTop).observe(root);
      {% endif %}
    })();
  </script>
{% endif %}


{% comment %} ============ INFO ============ {% endcomment %}
{% if part == 'body' or part == 'all' %}
  {% liquid
    assign current_variant = product.selected_or_first_available_variant

    assign rating_value = 0
    assign rating_count = 0
    if product.metafields.reviews.rating.value != blank
      assign rating_value = product.metafields.reviews.rating.value.rating | times: 1.0
      assign rating_count = product.metafields.reviews.rating_count.value | times: 1
    elsif product.metafields.loox.avg_rating != blank
      assign rating_value = product.metafields.loox.avg_rating.value | times: 1.0
      assign rating_count = product.metafields.loox.num_reviews.value | times: 1
    endif
    assign rating_percent = rating_value | times: 20.0
    assign rating_display = rating_value | round: 1

    assign badge_field = product.metafields.custom.pp_badges
    assign badge_list = ''
    if badge_field != blank
      if badge_field.type contains 'list.'
        assign badge_list = badge_field.value
      else
        assign badge_list = badge_field.value | newline_to_br | split: '<br />'
      endif
    endif
    assign allowed_colors = 'neutral,blue,yellow,purple,green,pink,orange,dark' | split: ','

    assign sold = product.metafields.custom.sold_count.value | default: 0 | times: 1
    assign sold_label = ''
    if sold >= SOLD_MIN
      if sold >= 1000000
        assign sold_tenths = sold | divided_by: 100000
        assign sold_num = sold_tenths | divided_by: 10.0 | append: '' | remove: '.0'
        assign sold_label = sold_num | append: 'M+ ' | append: SOLD_SUFFIX
      elsif sold >= 10000
        assign sold_num = sold | divided_by: 1000
        assign sold_label = sold_num | append: 'K+ ' | append: SOLD_SUFFIX
      elsif sold >= 1000
        assign sold_tenths = sold | divided_by: 100
        assign sold_num = sold_tenths | divided_by: 10.0 | append: '' | remove: '.0'
        assign sold_label = sold_num | append: 'K+ ' | append: SOLD_SUFFIX
      else
        assign sold_label = sold | append: ' ' | append: SOLD_SUFFIX
      endif
    endif

    assign show_stars = false
    if rating_count > 0 or SHOW_EMPTY_STATE
      assign show_stars = true
    endif

    assign subtitle = product.metafields.custom.pp_subtitle.value
    assign intro_field = product.metafields.custom.pp_intro
    assign benefits = product.metafields.custom.pp_benefits.value

    assign cart_cents = cart.items_subtotal_price | default: 0
    assign fd_cents = FREE_DELIVERY_MIN | times: 100
    assign ts_cents = TESTERS_MIN | times: 100
    assign dc_cents = DISCOUNT_MIN | times: 100

    assign has_real_options = false
    for option in product.options_with_values
      unless option.name == 'Title' and option.values.size == 1
        assign has_real_options = true
      endunless
    endfor
  %}

  <div class="sh-pdp" id="ShPdp-{{ product.id }}" data-gallery="ShGallery-{{ product.id }}">

    {% if badge_list != blank and badge_list.size > 0 %}
      {% capture tags_html %}
        {% for raw in badge_list %}
          {% liquid
            assign bits = raw | split: '|'
            assign tag_text = bits[0] | strip
            assign tag_color = bits[1] | strip | downcase | default: 'neutral'
            assign tag_icon = bits[2] | strip | downcase
            assign tag_style = ''

            assign first_char = tag_color | slice: 0
            if first_char == '#'
              assign hex_pair = tag_color | split: '/'
              assign hex_bg = hex_pair[0] | strip
              assign hex_fg = hex_pair[1] | strip
              assign bg_len = hex_bg | size
              if bg_len == 4 or bg_len == 7
                if hex_fg == blank
                  assign bg_brightness = hex_bg | color_brightness
                  if bg_brightness > 150
                    assign hex_fg = hex_bg | color_darken: 58
                  else
                    assign hex_fg = '#FFFFFF'
                  endif
                endif
                assign tag_style = '--sh-tag-bg:' | append: hex_bg | append: ';--sh-tag-fg:' | append: hex_fg | append: ';'
              endif
              assign tag_color = 'neutral'
            else
              unless allowed_colors contains tag_color
                assign tag_color = 'neutral'
              endunless
            endif
          %}
          {% if tag_text != blank %}
            <li class="sh-tag sh-tag--{{ tag_color }}"{% if tag_style != blank %} style="{{ tag_style | escape }}"{% endif %}>
              <span>{{ tag_text | escape }}</span>
              {% case tag_icon %}
                {% when 'truck' %}
                  <span class="sh-tag__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M2.75 6.25h10.5v9.5H2.75z"/><path d="M13.25 9.75h3.4l3.6 3.4v2.6h-7z"/><circle cx="6.75" cy="17.75" r="1.6"/><circle cx="16.75" cy="17.75" r="1.6"/><path d="M8.35 17.75h6.8"/></svg></span>
                {% when 'check' %}
                  <span class="sh-tag__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></span>
                {% when 'sparkle' %}
                  <span class="sh-tag__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3c.6 4.6 3.4 7.4 8 8-4.6.6-7.4 3.4-8 8-.6-4.6-3.4-7.4-8-8 4.6-.6 7.4-3.4 8-8z"/></svg></span>
                {% when 'drop' %}
                  <span class="sh-tag__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3.5s6 6.4 6 10.5a6 6 0 0 1-12 0c0-4.1 6-10.5 6-10.5z"/></svg></span>
                {% when 'leaf' %}
                  <span class="sh-tag__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/><path d="M5 19 13 11"/></svg></span>
              {% endcase %}
            </li>
          {% endif %}
        {% endfor %}
      {% endcapture %}
      {% if tags_html contains '<li' %}
        <ul class="sh-tags" aria-label="Product highlights">{{ tags_html }}</ul>
      {% endif %}
    {% endif %}

    <h1 class="sh-title">{{ product.title }}</h1>

    {% if show_stars or sold_label != blank %}
      <div class="sh-meta">
        {% if rating_count > 0 %}
          <a class="sh-rating" href="{{ REVIEWS_ANCHOR }}"
             aria-label="Rated {{ rating_display }} out of 5 from {{ rating_count }} reviews">
            <span class="sh-rating-stars" style="--sh-rating: {{ rating_percent }}%;" aria-hidden="true">
              <span class="sh-rating-stars-bg">★★★★★</span>
              <span class="sh-rating-stars-fg">★★★★★</span>
            </span>
            <span class="sh-rating-value">{{ rating_display }}</span>
            {% if SHOW_REVIEW_COUNT %}<span class="sh-rating-count">({{ rating_count }})</span>{% endif %}
          </a>
        {% elsif SHOW_EMPTY_STATE %}
          <a class="sh-rating sh-rating--empty" href="{{ REVIEWS_ANCHOR }}">
            <span class="sh-rating-stars" style="--sh-rating: 0%;" aria-hidden="true">
              <span class="sh-rating-stars-bg">★★★★★</span>
              <span class="sh-rating-stars-fg">★★★★★</span>
            </span>
            <span class="sh-rating-count">Be the first to review</span>
          </a>
        {% endif %}

        {% if sold_label != blank %}
          <span class="sh-sold">
            {% if show_stars %}<span class="sh-sold__sep" aria-hidden="true"></span>{% endif %}
            <span class="sh-sold__label">{{ sold_label }}</span>
          </span>
        {% endif %}
      </div>
    {% endif %}

    {% if subtitle != blank %}
      <p class="sh-subtitle">{{ subtitle | escape }}</p>
    {% endif %}

    <div class="sh-price">
      <span class="sh-price-compare" data-sh-compare
        {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>
        {{ current_variant.compare_at_price | money }}
      </span>
      <span class="sh-price-current" data-sh-current>{{ current_variant.price | money }}</span>
      <span class="sh-price-badge" data-sh-badge
        {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>Sale</span>
    </div>

    {% if intro_field != blank %}
      <div class="sh-intro">
        {% if intro_field.type == 'rich_text_field' %}
          {{ intro_field | metafield_tag }}
        {% else %}
          <p>{{ intro_field.value | escape | newline_to_br }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if benefits != blank and benefits.size > 0 %}
      <ul class="sh-benefits">
        {% for b in benefits %}
          {% assign b_text = b | strip %}
          {% if b_text != blank %}
            <li class="sh-benefit">
              <span class="sh-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.2 12.3 2.6 2.6 5-5.2"/></svg></span>
              <span>{{ b_text | escape }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}

    {% if SHOW_DELIVERY %}
      <div class="sh-eta" data-sh-eta
           data-min="{{ DELIVERY_MIN_DAYS }}"
           data-max="{{ DELIVERY_MAX_DAYS }}"
           data-process="{{ ETA_PROCESS_DAYS }}"
           data-cutoff="{{ ETA_CUTOFF_HOUR }}">
        <div class="sh-eta__card">
          <div class="sh-eta__track" aria-hidden="true">
            <span class="sh-eta__icon"><svg viewBox="0 0 24 24"><path d="M5.5 8h13l-1 12.5h-11z"/><path d="M9 10V6.5a3 3 0 0 1 6 0V10"/></svg></span>
            <span class="sh-eta__bar"></span>
            <span class="sh-eta__icon"><svg viewBox="0 0 24 24"><path d="M2.75 6.25h10.5v9.5H2.75z"/><path d="M13.25 9.75h3.4l3.6 3.4v2.6h-7z"/><circle cx="6.75" cy="17.75" r="1.6"/><circle cx="16.75" cy="17.75" r="1.6"/></svg></span>
            <span class="sh-eta__bar"></span>
            <span class="sh-eta__icon"><svg viewBox="0 0 24 24"><path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21z"/><circle cx="12" cy="9.8" r="2.4"/></svg></span>
          </div>
          <div class="sh-eta__steps">
            <div class="sh-eta__step"><span class="sh-eta__date" data-eta-s1>&nbsp;</span><span class="sh-eta__label">{{ ETA_STEP_1 }}</span></div>
            <div class="sh-eta__step"><span class="sh-eta__date" data-eta-s2>&nbsp;</span><span class="sh-eta__label">{{ ETA_STEP_2 }}</span></div>
            <div class="sh-eta__step"><span class="sh-eta__date" data-eta-s3>&nbsp;</span><span class="sh-eta__label">{{ ETA_STEP_3 }}</span></div>
          </div>
        </div>
      </div>
    {% endif %}

    {% liquid
      assign next_min = 0
      assign next_label = ''
      if fd_cents > cart_cents
        assign next_min = fd_cents
        assign next_label = FREE_DELIVERY_LABEL
      endif
      if dc_cents > cart_cents
        if next_min == 0 or dc_cents < next_min
          assign next_min = dc_cents
          assign next_label = DISCOUNT_LABEL
        endif
      endif
      if ts_cents > cart_cents
        if next_min == 0 or ts_cents < next_min
          assign next_min = ts_cents
          assign next_label = TESTERS_LABEL
        endif
      endif
      assign progress = 100
      if next_min > 0
        assign progress = cart_cents | times: 100 | divided_by: next_min
      endif
    %}
    <div class="sh-perks" data-sh-perks>
