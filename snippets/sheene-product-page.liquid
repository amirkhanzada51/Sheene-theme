        "compare_at": {{ v.compare_at_price | money | json }},
        "on_sale": {% if v.compare_at_price > v.price %}true{% else %}false{% endif %},
        "media_index": {% if v.featured_media %}{{ v.featured_media.position | minus: 1 }}{% else %}null{% endif %}
