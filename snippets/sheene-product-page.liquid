                    type="button"
                    class="sh-gww-variant-btn"
                    data-variant-id="{{ v.id }}"
                    data-price="{{ v.price | money | escape }}"
                    data-compare="{{ v.compare_at_price | money | escape }}"
                    data-on-sale="{% if v.compare_at_price > v.price %}true{% else %}false{% endif %}"
                    {% unless v.available %}disabled{% endunless %}
                  >{{ v.title }}</button>
                {% endfor %}
              </div>
            {% endif %}

            <button
              type="button"
              class="sh-gww-add{% if multi %} needs-selection{% endif %}"
              data-add-to-cart
