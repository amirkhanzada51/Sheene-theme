  {% if mode == 'gww' %}
    <script>
      (function () {
        var root = document.getElementById('ShGww-{{ product.id }}');
        if (!root || root.dataset.shInit) return;
        root.dataset.shInit = '1';
        var ADD_TEXT = {{ ADD_TEXT | json }};

        root.querySelectorAll('.sh-gww-card').forEach(function (card) {
          var vBtns = card.querySelectorAll('.sh-gww-variant-btn');
          var add = card.querySelector('[data-add-to-cart]');
          var cur = card.querySelector('[data-current-price]');
          var cmp = card.querySelector('[data-compare-price]');

          vBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
              if (btn.disabled) return;
              vBtns.forEach(function (b) { b.classList.remove('is-active'); });
              btn.classList.add('is-active');
              cur.textContent = btn.dataset.price;
              cmp.textContent = btn.dataset.compare;
              cmp.hidden = btn.dataset.onSale !== 'true';
              add.dataset.variantId = btn.dataset.variantId;
              add.textContent = ADD_TEXT;
              add.classList.remove('needs-selection');
            });
          });

          if (!add) return;
          add.addEventListener('click', function () {
            if (add.disabled || add.classList.contains('needs-selection')) return;
            var label = add.textContent;
            add.disabled = true;
            add.textContent = 'Adding...';
            fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({ items: [{ id: add.dataset.variantId, quantity: 1 }] })
            })
              .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
              .then(function () { add.textContent = 'Added'; window.location.reload(); })
              .catch(function () {
                add.textContent = label;
                add.disabled = false;
                alert('Could not add this to your cart. Please try again.');
              });
          });
        });
      })();
    </script>
  {% endif %}
{% endif %}
{% endif %}
