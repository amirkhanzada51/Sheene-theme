  {% comment %} ---------- variants ---------- {% endcomment %}
  <script>
    (function () {
      var root = document.getElementById('ShPdp-{{ product.id }}');
      if (!root || root.dataset.shInit) return;
      root.dataset.shInit = '1';

      var dataEl = root.querySelector('[data-sh-variant-data]');
      if (!dataEl) return;
      var variants = [];
      try { variants = JSON.parse(dataEl.textContent); } catch (e) { return; }
      if (!variants.length) return;

      var priceCurrent = root.querySelector('[data-sh-current]');
      var priceCompare = root.querySelector('[data-sh-compare]');
      var priceBadge = root.querySelector('[data-sh-badge]');
      var gallery = document.getElementById(root.dataset.gallery);

      function selectedOptions() {
        var out = [];
        root.querySelectorAll('.sh-option').forEach(function (fs) {
          var pos = parseInt(fs.dataset.optionPosition, 10);
          var active = fs.querySelector('.sh-pill.is-selected');
          out[pos - 1] = active ? active.dataset.optionValue : null;
        });
        return out;
      }

      function match(opts) {
        return variants.find(function (v) {
          return opts.every(function (val, i) { return val === null || v.options[i] === val; });
        });
      }

      function markAvailability(opts) {
        root.querySelectorAll('.sh-option').forEach(function (fs) {
          var pos = parseInt(fs.dataset.optionPosition, 10);
          fs.querySelectorAll('.sh-pill').forEach(function (pill) {
            var test = opts.slice();
            test[pos - 1] = pill.dataset.optionValue;
            var m = match(test);
            pill.classList.toggle('is-unavailable', !m || !m.available);
          });
        });
      }

      function apply() {
        var opts = selectedOptions();
        var variant = match(opts);
        markAvailability(opts);
        if (!variant) return;

        if (priceCurrent) priceCurrent.innerHTML = variant.price;
        if (priceCompare) {
          priceCompare.innerHTML = variant.compare_at || '';
          priceCompare.hidden = !variant.on_sale;
        }
        if (priceBadge) priceBadge.hidden = !variant.on_sale;

        document.querySelectorAll('form[action*="/cart/add"] [name="id"]').forEach(function (el) {
          el.value = variant.id;
          el.dispatchEvent(new Event('change', { bubbles: true }));
        });

        if (window.history && history.replaceState) {
          var url = new URL(window.location.href);
          url.searchParams.set('variant', variant.id);
          history.replaceState({}, '', url.toString());
        }

        if (gallery && typeof gallery.shGoTo === 'function' && variant.media_index !== null) {
          gallery.shGoTo(variant.media_index);
        }
      }

      root.querySelectorAll('.sh-pill').forEach(function (pill) {
        pill.addEventListener('click', function () {
          var fs = pill.closest('.sh-option');
          fs.querySelectorAll('.sh-pill').forEach(function (p) {
            p.classList.remove('is-selected');
            p.setAttribute('aria-pressed', 'false');
          });
          pill.classList.add('is-selected');
          pill.setAttribute('aria-pressed', 'true');
          apply();
        });
      });

      apply();
    })();
  </script>

  {% comment %} ---------- delivery estimate + live perks ---------- {% endcomment %}
  <script>
    (function () {
      var root = document.getElementById('ShPdp-{{ product.id }}');
      if (!root || root.dataset.shLiveInit) return;
      root.dataset.shLiveInit = '1';

      var MONEY_FORMAT = {{ shop.money_format | strip_html | json }};
      var MET_TEXT = {{ PERK_MET_TEXT | json }};
      var ALWAYS_TEXT = {{ PERK_ALWAYS_TEXT | json }};

      /* ---- delivery estimate + countdown, Karachi time (UTC+5, no DST) ---- */
      var eta = root.querySelector('[data-sh-eta]');
      if (eta) {
        var MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        var PKT = 5 * 3600 * 1000;
        var minD = parseInt(eta.dataset.min, 10) || 2;
        var maxD = parseInt(eta.dataset.max, 10) || 4;
        var procD = parseInt(eta.dataset.process, 10);
        if (isNaN(procD)) procD = 1;
        var cutoff = parseInt(eta.dataset.cutoff, 10);
        if (isNaN(cutoff) || cutoff < 1 || cutoff > 24) cutoff = 24;

        var q = function (s) { return eta.querySelector(s); };
        var pad = function (n) { return (n < 10 ? '0' : '') + n; };
        var day = function (base, n) { return new Date(base + n * 86400000); };
        var short = function (d) { return MON[d.getUTCMonth()] + ' ' + d.getUTCDate(); };
        var full = function (d) { return pad(d.getUTCDate()) + '/' + pad(d.getUTCMonth() + 1) + '/' + d.getUTCFullYear(); };
        var range = function (a, b) {
          if (a.getTime() === b.getTime()) return short(a);
          return a.getUTCMonth() === b.getUTCMonth()
            ? short(a) + ' - ' + b.getUTCDate()
            : short(a) + ' - ' + short(b);
        };

        var renderEta = function () {
          var pk = Date.now() + PKT;
          var midnight = Math.floor(pk / 86400000) * 86400000;
          var cut = midnight + cutoff * 3600000;
          var base = midnight;
          if (pk >= cut) { cut += 86400000; base += 86400000; }

          var left = Math.max(0, cut - pk);
          var h = Math.floor(left / 3600000);
          var m = Math.floor((left % 3600000) / 60000);

          var d0 = day(base, 0);
          var pEnd = day(base, Math.max(0, Math.min(procD, minD - 1)));
          var dA = day(base, minD);
          var dB = day(base, maxD);

          q('[data-eta-s1]').textContent = short(d0);
          q('[data-eta-s2]').textContent = range(d0, pEnd);
          q('[data-eta-s3]').textContent = range(dA, dB);
        };
        renderEta();
        setInterval(renderEta, 30000);
      }

      /* ---- money ---- */
      function num(n, dec, th, ds) {
        var p = n.toFixed(dec).split('.');
        p[0] = p[0].replace(/\B(?=(\d{3})+(?!\d))/g, th);
        return p.join(ds);
      }
      function money(cents) {
        var v = cents / 100;
        return MONEY_FORMAT.replace(/\{\{\s*(\w+)\s*\}\}/, function (_, k) {
          switch (k) {
            case 'amount_no_decimals': return num(v, 0, ',', '.');
            case 'amount_with_comma_separator': return num(v, 2, '.', ',');
            case 'amount_no_decimals_with_comma_separator': return num(v, 0, '.', ',');
            default: return num(v, 2, ',', '.').replace(/\.00$/, '');
          }
        });
      }

      /* ---- perks ---- */
      var perks = root.querySelectorAll('[data-sh-perk]');
      var perksCard = root.querySelector('[data-sh-perks-card]');
      var perksMsg = root.querySelector('[data-sh-perks-msg]');
      var perksFill = root.querySelector('[data-sh-perks-fill]');
      var AWAY_TEXT = {{ PERKS_AWAY_TEXT | json }};
      var ALL_TEXT = {{ PERKS_ALL_TEXT | json }};
      var esc = function (s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; };
      function paint(subtotal) {
        var nextMin = 0, nextLabel = '';
        perks.forEach(function (el) {
          var m = parseInt(el.dataset.min, 10) || 0;
          if (m > subtotal && (nextMin === 0 || m < nextMin)) { nextMin = m; nextLabel = el.dataset.label || ''; }
        });
        if (perksCard) perksCard.classList.toggle('is-complete', nextMin === 0);
        if (perksMsg) {
          perksMsg.innerHTML = nextMin === 0
            ? '<strong>' + esc(ALL_TEXT) + '</strong>'
            : '<strong>' + esc(money(Math.ceil((nextMin - subtotal) / 100) * 100)) + '</strong> ' + esc(AWAY_TEXT) + ' <strong>' + esc(nextLabel) + '</strong>';
        }
        if (perksFill) perksFill.style.setProperty('--sh-progress', (nextMin === 0 ? 100 : Math.min(100, Math.floor(subtotal * 100 / nextMin))) + '%');
        perks.forEach(function (el) {
          var min = parseInt(el.dataset.min, 10) || 0;
          var met = subtotal >= min;
          el.classList.toggle('is-met', met);
          var st = el.querySelector('[data-sh-perk-status]');
          if (!st) return;
          if (min === 0) st.textContent = ALWAYS_TEXT;
          else if (met) st.textContent = MET_TEXT;
          else st.textContent = 'Add ' + money(Math.ceil((min - subtotal) / 100) * 100) + ' more';
        });
      }

      function refresh() {
        fetch('/cart.js', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
          .then(function (r) { return r.json(); })
          .then(function (c) { paint(c.items_subtotal_price || 0); })
          .catch(function () {});
      }

      if (perks.length) {
        if (!window.__shCartWatch && !{{ SAFE_MODE | json }}) {
          window.__shCartWatch = true;
          var origFetch = window.fetch;
          window.fetch = function () {
            var args = arguments;
            var input = args[0];
            var url = typeof input === 'string' ? input : (input && input.url) || '';
            return origFetch.apply(window, args).then(function (res) {
              if (/\/cart\/(add|change|update|clear)/.test(url)) {
                setTimeout(function () { document.dispatchEvent(new CustomEvent('sheene:cart-changed')); }, 60);
              }
              return res;
            });
          };
        }
        document.addEventListener('sheene:cart-changed', refresh);
        document.addEventListener('cart:update', refresh);
        window.addEventListener('pageshow', function (e) { if (e.persisted) refresh(); });
        refresh();
      }
    })();
  </script>
{% endif %}


{% comment %} ================================================================
     GOES WELL WITH / RECOMMEND INSTEAD
   ================================================================ {% endcomment %}
{% if part == 'goes_well' %}
  {% liquid
  assign refer_list = product.metafields.custom.pp_refer_products.value
  assign gww_list = product.metafields.custom.goes_well_products.value

  assign mode = ''
  if refer_list != blank and refer_list.size > 0
    assign mode = 'refer'
    assign items = refer_list
    assign heading = product.metafields.custom.pp_refer_heading.value | default: REFER_HEADING
    assign note = product.metafields.custom.pp_refer_note.value
  elsif gww_list != blank and gww_list.size > 0
    assign mode = 'gww'
    assign items = gww_list
    assign heading = GWW_HEADING
  endif
  %}

{% if mode != blank %}
  <div class="sh-gww sh-gww--{{ mode }}" id="ShGww-{{ product.id }}">
    <div class="sh-gww-label">{{ heading | escape }}</div>
    {% if mode == 'refer' and note != blank %}
      <p class="sh-gww-note">{{ note | escape }}</p>
    {% endif %}

    {% for item in items limit: MAX_ITEMS %}
      {% liquid
        assign iv = item.selected_or_first_available_variant | default: item.variants.first
        assign item_title = item.title | escape
        assign item_on_sale = false
        if iv.compare_at_price > iv.price
          assign item_on_sale = true
        endif
        assign multi = false
        if item.variants.size > 1
          assign multi = true
        endif
      %}

      <div class="sh-gww-card">
        <a href="{{ item.url }}" class="sh-gww-image">
          {% if item.featured_image %}
            {{ item.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item_title, sizes: '120px', widths: '120,180,240,300' }}
          {% endif %}
        </a>

        <div class="sh-gww-details">
          <div class="sh-gww-price">
            <span class="sh-gww-price-current" data-current-price>{{ iv.price | money }}</span>
            <span class="sh-gww-price-compare" data-compare-price {% unless item_on_sale %}hidden{% endunless %}>{{ iv.compare_at_price | money }}</span>
          </div>

          <a href="{{ item.url }}" class="sh-gww-title">{{ item.title }}</a>

          {% if mode == 'refer' %}
            <a href="{{ item.url }}" class="sh-gww-add sh-gww-add--link">{{ REFER_BUTTON }}</a>
          {% else %}
            {% if multi %}
