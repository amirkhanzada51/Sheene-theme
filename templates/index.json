      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n\n/* =========================================================\n   NEW ARRIVALS — FINAL STABLE VERSION\n   =========================================================\n   DESKTOP  : 4 PRODUCTS PER SLIDE\n   MOBILE   : 2 PRODUCTS PER SLIDE\n   PRODUCTS : MAX 8\n   IMAGES    : SMOOTH HORIZONTAL IMAGE SLIDER\n   VARIANTS  : REAL SHOPIFY VARIANT SELECTION\n   CART      : SELECTED VARIANT SAVED\n   ========================================================= */\n\n\n/* =========================================================\n   MAIN SECTION\n   ========================================================= */\n\n.custom-best-sellers {\n  width: 100%;\n  max-width: 100%;\n  margin: 0;\n  padding: 40px 7px 8px;\n  background: #fff;\n  overflow: hidden !important;\n  box-sizing: border-box;\n}\n\n.custom-best-sellers *,\n.custom-best-sellers *::before,\n.custom-best-sellers *::after {\n  box-sizing: border-box;\n}\n\n\n/* =========================================================\n   HEADING\n   ========================================================= */\n\n.custom-best-sellers__heading {\n  margin: 0 0 34px;\n  padding: 0;\n\n  font-size: 32px;\n  line-height: 1.2;\n  font-weight: 500;\n\n  color: #111;\n\n  text-align: left;\n\n  letter-spacing: -0.5px;\n}\n\n\n/* =========================================================\n   PRODUCT VIEWPORT\n   ========================================================= */\n\n.custom-best-sellers__viewport {\n  position: relative;\n\n  width: 100%;\n  max-width: 100%;\n\n  overflow: hidden !important;\n}\n\n\n/* =========================================================\n   PRODUCT TRACK\n   ========================================================= */\n\n.custom-best-sellers__track {\n  display: flex;\n  flex-wrap: nowrap;\n\n  width: 100%;\n\n  margin: 0;\n  padding: 0;\n\n  gap: 24px;\n\n  transform: translate3d(0, 0, 0);\n\n  transition:\n    transform 0.55s cubic-bezier(.22, .61, .36, 1);\n\n  will-change: transform;\n}\n\n\n/* =========================================================\n   PRODUCT CARD\n   ========================================================= */\n\n.custom-best-sellers__card {\n  position: relative;\n\n  flex: 0 0 calc((100% - 72px) / 4);\n\n  width: calc((100% - 72px) / 4);\n\n  min-width: 0;\n\n  display: flex;\n  flex-direction: column;\n\n  background: #fff;\n\n  overflow: visible;\n}\n\n\n/* =========================================================\n   PRODUCT IMAGE BOX\n   ========================================================= */\n\n.custom-best-sellers__image-box {\n  position: relative;\n\n  width: 100%;\n\n  aspect-ratio: 2 / 3;\n\n  background: #e9edef;\n\n  overflow: hidden;\n}\n\n\n/* =========================================================\n   IMAGE LINK\n   ========================================================= */\n\n.custom-best-sellers__image-link {\n  position: absolute;\n\n  inset: 0;\n\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  text-decoration: none;\n\n  overflow: hidden;\n\n  z-index: 1;\n}\n\n\n/* =========================================================\n   IMAGE TRACK\n   ========================================================= */\n\n.custom-best-sellers__image-track {\n  display: flex;\n  flex-wrap: nowrap;\n\n  width: 100%;\n  height: 100%;\n\n  margin: 0;\n  padding: 0;\n\n  transform: translate3d(0, 0, 0);\n\n  transition:\n    transform 0.45s cubic-bezier(.22, .61, .36, 1);\n\n  will-change: transform;\n}\n\n\n/* =========================================================\n   IMAGE SLIDE\n   ========================================================= */\n\n.custom-best-sellers__image-slide {\n  position: relative;\n\n  flex: 0 0 100%;\n\n  width: 100%;\n  height: 100%;\n\n  min-width: 100%;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  overflow: hidden;\n}\n\n\n/* =========================================================\n   PRODUCT IMAGE\n   FULL IMAGE — NO CROP\n   ========================================================= */\n\n.custom-best-sellers__image {\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  max-width: 100%;\n  max-height: 100%;\n\n  object-fit: contain;\n  object-position: center center;\n\n  margin: 0;\n  padding: 0;\n\n  border: 0;\n\n  vertical-align: middle;\n\n  user-select: none;\n\n  -webkit-user-drag: none;\n}\n\n\n/* =========================================================\n   BEST SELLER BADGE\n   ========================================================= */\n\n.custom-best-sellers__badge {\n  position: absolute;\n\n  top: 11px;\n  right: 11px;\n\n  z-index: 30;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  min-height: 21px;\n\n  padding: 4px 8px;\n\n  background: #000;\n  color: #fff;\n\n  border-radius: 10px;\n\n  font-size: 15px;\n  line-height: 1;\n\n  font-weight: 600;\n\n  white-space: nowrap;\n}\n\n\n/* =========================================================\n   IMAGE ARROWS\n   ========================================================= */\n\n.custom-best-sellers__image-arrow {\n  position: absolute;\n\n  top: 50%;\n\n  transform: translateY(-50%);\n\n  z-index: 40;\n\n  width: 20px;\n  height: 20px;\n\n  padding: 0;\n  margin: 0;\n\n  border: 0;\n\n  border-radius: 50%;\n\n  background: rgba(255, 255, 255, .94);\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  cursor: pointer;\n\n  appearance: none;\n  -webkit-appearance: none;\n\n  outline: none;\n\n  box-shadow:\n    0 1px 4px rgba(0, 0, 0, .06);\n\n  transition:\n    transform .15s ease;\n}\n\n\n/* NO HOVER COLOR CHANGE */\n\n.custom-best-sellers__image-arrow:hover {\n  background: rgba(255, 255, 255, .94);\n}\n\n\n/* CLICK */\n\n.custom-best-sellers__image-arrow:active {\n  transform:\n    translateY(-50%)\n    scale(.92);\n}\n\n\n/* PREVIOUS */\n\n.custom-best-sellers__image-arrow--prev {\n  left: 7px;\n}\n\n\n/* NEXT */\n\n.custom-best-sellers__image-arrow--next {\n  right: 7px;\n}\n\n\n/* SVG */\n\n.custom-best-sellers__image-arrow svg {\n  width: 13px;\n  height: 13px;\n\n  display: block;\n\n  fill: none;\n\n  stroke: #777;\n\n  stroke-width: 1.7;\n\n  stroke-linecap: round;\n  stroke-linejoin: round;\n\n  pointer-events: none;\n}\n\n\n/* =========================================================\n   IMAGE DOTS\n   ========================================================= */\n\n.custom-best-sellers__image-dots {\n  position: absolute;\n\n  left: 50%;\n  bottom: 8px;\n\n  transform: translateX(-50%);\n\n  z-index: 35;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 3px;\n\n  height: 7px;\n\n  pointer-events: none;\n}\n\n\n.custom-best-sellers__image-dot {\n  width: 4px;\n  height: 4px;\n\n  min-width: 4px;\n\n  padding: 0;\n  margin: 0;\n\n  border: 0;\n\n  border-radius: 50%;\n\n  background: #b9b9b9;\n}\n\n\n.custom-best-sellers__image-dot.is-active {\n  background: #000;\n}\n\n\n/* =========================================================\n   PRODUCT CONTENT\n   ========================================================= */\n\n.custom-best-sellers__content {\n  display: flex;\n\n  flex-direction: column;\n\n  width: 100%;\n\n  min-width: 0;\n\n  padding-top: 17px;\n}\n\n\n/* =========================================================\n   PRODUCT TITLE\n   ========================================================= */\n\n.custom-best-sellers__title {\n  margin: 0;\n  padding: 0;\n\n  font-size: 18px;\n  line-height: 1.25;\n\n  font-weight: 600;\n\n  color: #111;\n\n  letter-spacing: 0;\n\n  white-space: normal;\n}\n\n\n.custom-best-sellers__title a {\n  color: inherit;\n\n  text-decoration: none;\n}\n\n\n/* =========================================================\n   DESCRIPTION\n   ========================================================= */\n\n.custom-best-sellers__description {\n  margin-top: 7px;\n\n  min-height: 20px;\n\n  overflow: hidden;\n\n  font-size: 15px;\n  line-height: 1.35;\n\n  font-weight: 400;\n\n  color: #858585;\n}\n\n\n/* =========================================================\n   RATING\n   ========================================================= */\n\n.custom-best-sellers__rating {\n  display: flex;\n\n  align-items: center;\n\n  gap: 1px;\n\n  margin-top: 7px;\n\n  height: 17px;\n}\n\n\n.custom-best-sellers__star {\n  font-size: 16px;\n\n  line-height: 1;\n\n  color: #000;\n}\n\n\n.custom-best-sellers__star.empty {\n  color: #777;\n}\n\n\n/* =========================================================\n   PRICE\n   ========================================================= */\n\n.custom-best-sellers__price-row {\n  display: flex;\n\n  align-items: center;\n\n  flex-wrap: wrap;\n\n  gap: 7px;\n\n  margin-top: 8px;\n\n  min-height: 21px;\n}\n\n\n.custom-best-sellers__price {\n  font-size: 15px;\n  line-height: 1.35;\n\n  font-weight: 500;\n\n  color: #111;\n}\n\n\n.custom-best-sellers__compare {\n  font-size: 15px;\n  line-height: 1.35;\n\n  font-weight: 400;\n\n  color: #888;\n\n  text-decoration: line-through;\n}\n\n\n/* =========================================================\n   VARIANTS\n   ========================================================= */\n\n.custom-best-sellers__variants {\n  display: flex;\n\n  align-items: center;\n\n  flex-wrap: wrap;\n\n  gap: 7px;\n\n  margin-top: 10px;\n\n  min-height: 30px;\n}\n\n\n.custom-best-sellers__variant {\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  min-height: 22px;\n\n  padding: 3px 12px;\n\n  border: 1px solid #bdbdbd;\n\n  border-radius: 15px;\n\n  background: #fff;\n\n  color: #222;\n\n  font-size: 15px;\n  line-height: 1.2;\n\n  font-weight: 400;\n\n  white-space: nowrap;\n\n  cursor: pointer;\n\n  font-family: inherit;\n\n  appearance: none;\n  -webkit-appearance: none;\n\n  outline: none;\n\n  transition:\n    background .15s ease,\n    color .15s ease,\n    border-color .15s ease;\n}\n\n\n/* SELECTED */\n\n.custom-best-sellers__variant.is-selected {\n  background: #000;\n\n  border-color: #000;\n\n  color: #fff;\n\n  font-weight: 600;\n}\n\n\n/* DISABLED */\n\n.custom-best-sellers__variant:disabled {\n  opacity: .4;\n\n  cursor: not-allowed;\n}\n\n\n/* =========================================================\n   CART FORM\n   ========================================================= */\n\n.custom-best-sellers__cart-form {\n  width: 100%;\n\n  margin: 0;\n  padding: 0;\n}\n\n\n/* =========================================================\n   ADD TO CART\n   ========================================================= */\n\n.custom-best-sellers__add {\n  width: 100%;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  margin-top: 10px;\n\n  padding: 14px 15px;\n\n  min-height: 48px;\n\n  border: 1px solid #000;\n\n  border-radius: 0;\n\n  background: #000;\n\n  color: #fff;\n\n  font-family: Jost, sans-serif;\n\n  font-size: 16px;\n  line-height: 1.2;\n\n  font-weight: 500;\n\n  text-align: center;\n\n  cursor: pointer;\n\n  appearance: none;\n  -webkit-appearance: none;\n\n  outline: none;\n\n  box-shadow: none;\n\n  transition: none;\n}\n\n\n/* =========================================================\n   ADD TO CART — NO HOVER EFFECT\n   ========================================================= */\n\n.custom-best-sellers__add:hover,\n.custom-best-sellers__add:focus,\n.custom-best-sellers__add:active {\n  background: #000 !important;\n\n  color: #fff !important;\n\n  border-color: #000 !important;\n\n  box-shadow: none !important;\n}\n\n\n/* =========================================================\n   BOTTOM SLIDER\n   ========================================================= */\n\n.custom-best-sellers__bottom {\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 100%;\n\n  margin-top: 42px;\n}\n\n\n.custom-best-sellers__bottom-dots {\n  display: flex;\n\n  align-items: center;\n\n  justify-content: center;\n\n  gap: 5px;\n}\n\n\n.custom-best-sellers__bottom-dot {\n  width: 24px;\n  height: 4px;\n\n  padding: 0;\n  margin: 0;\n\n  border: 0;\n\n  border-radius: 5px;\n\n  background: #e7e7e7;\n\n  cursor: pointer;\n\n  appearance: none;\n  -webkit-appearance: none;\n}\n\n\n.custom-best-sellers__bottom-dot.is-active {\n  background: #000;\n}\n\n\n/* =========================================================\n   VIEW ALL\n   ========================================================= */\n\n.custom-best-sellers__view-all-wrap {\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  margin-top: 20px;\n}\n\n\n.custom-best-sellers__view-all {\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  min-width: 163px;\n  min-height: 39px;\n\n  padding: 14px 46px;\n\n  border: 1px solid #111;\n\n  background: #fff;\n\n  color: #111;\n\n  text-decoration: none;\n\n  font-family: Jost, sans-serif;\n\n  font-size: 18px;\n  line-height: 1.2;\n\n  font-weight: 400;\n\n  transition: none;\n}\n\n\n/* =========================================================\n   VIEW ALL — NO HOVER\n   ========================================================= */\n\n.custom-best-sellers__view-all:hover,\n.custom-best-sellers__view-all:focus,\n.custom-best-sellers__view-all:active {\n  background: #fff !important;\n\n  color: #111 !important;\n\n  border-color: #111 !important;\n\n  box-shadow: none !important;\n}\n\n\n/* =========================================================\n   TABLET\n   ========================================================= */\n\n@media screen and (max-width: 989px) {\n\n  .custom-best-sellers {\n    padding-left: 12px;\n    padding-right: 12px;\n  }\n\n\n  .custom-best-sellers__track {\n    gap: 16px;\n  }\n\n\n  .custom-best-sellers__card {\n    flex: 0 0 calc((100% - 48px) / 4);\n\n    width: calc((100% - 48px) / 4);\n  }\n\n\n  .custom-best-sellers__image-box {\n    aspect-ratio: 2 / 3;\n  }\n\n}\n\n\n/* =========================================================\n   MOBILE\n   EXACTLY 2 PRODUCTS\n   ========================================================= */\n\n@media screen and (max-width: 749px) {\n\n  .custom-best-sellers {\n    width: 100% !important;\n    max-width: 100% !important;\n\n    padding:\n      28px 7px 12px !important;\n\n    margin: 0 !important;\n\n    overflow-x: hidden !important;\n    overflow-y: visible !important;\n  }\n\n\n  .custom-best-sellers__heading {\n    margin:\n      0 0 28px !important;\n\n    padding: 0 !important;\n\n    font-size: 32px !important;\n\n    line-height: 1.2;\n  }\n\n\n  .custom-best-sellers__viewport {\n    width: 100% !important;\n\n    max-width: 100% !important;\n\n    overflow: hidden !important;\n  }\n\n\n  .custom-best-sellers__track {\n    gap: 12px;\n  }\n\n\n  .custom-best-sellers__card {\n    flex:\n      0 0 calc((100% - 12px) / 2);\n\n    width:\n      calc((100% - 12px) / 2);\n\n    min-width: 0;\n  }\n\n\n  .custom-best-sellers__image-box {\n    width: 100%;\n\n    aspect-ratio: 2 / 3;\n\n    overflow: hidden;\n  }\n\n\n  .custom-best-sellers__badge {\n    top: 8px;\n    right: 8px;\n\n    min-height: 20px;\n\n    padding: 4px 7px;\n\n    font-size: 15px;\n  }\n\n\n  .custom-best-sellers__image-arrow {\n    width: 20px;\n    height: 20px;\n  }\n\n\n  .custom-best-sellers__image-arrow--prev {\n    left: 6px;\n  }\n\n\n  .custom-best-sellers__image-arrow--next {\n    right: 6px;\n  }\n\n\n  .custom-best-sellers__content {\n    padding-top: 13px;\n  }\n\n\n  .custom-best-sellers__title {\n    font-size: 18px !important;\n\n    line-height: 1.25;\n  }\n\n\n  .custom-best-sellers__description {\n    margin-top: 6px;\n\n    min-height: 19px;\n\n    font-size: 15px !important;\n\n    line-height: 1.3;\n  }\n\n\n  .custom-best-sellers__rating {\n    margin-top: 6px;\n  }\n\n\n  .custom-best-sellers__star {\n    font-size: 15px;\n  }\n\n\n  .custom-best-sellers__price-row {\n    margin-top: 7px;\n\n    gap: 5px;\n  }\n\n\n  .custom-best-sellers__price,\n  .custom-best-sellers__compare {\n    font-size: 15px !important;\n  }\n\n\n  .custom-best-sellers__variants {\n    gap: 5px;\n\n    margin-top: 9px;\n  }\n\n\n  .custom-best-sellers__variant {\n    font-size: 15px !important;\n\n    padding:\n      3px 9px;\n  }\n\n\n  .custom-best-sellers__add {\n    margin-top: 9px;\n\n    padding:\n      14px 15px !important;\n\n    min-height: 0;\n\n    font-size: 16px !important;\n  }\n\n\n  .custom-best-sellers__bottom {\n    margin-top: 35px;\n  }\n\n\n  .custom-best-sellers__bottom-dot {\n    width: 22px;\n    height: 4px;\n  }\n\n\n  .custom-best-sellers__view-all-wrap {\n    margin-top: 19px;\n  }\n\n\n  .custom-best-sellers__view-all {\n    min-width: 163px;\n\n    min-height: 39px;\n\n    padding:\n      14px 30px;\n\n    font-size: 18px;\n  }\n\n}\n\n\n/* =========================================================\n   SMALL MOBILE\n   ========================================================= */\n\n@media screen and (max-width: 380px) {\n\n  .custom-best-sellers {\n    padding-left: 6px !important;\n    padding-right: 6px !important;\n  }\n\n\n  .custom-best-sellers__track {\n    gap: 10px;\n  }\n\n\n  .custom-best-sellers__card {\n    flex:\n      0 0 calc((100% - 10px) / 2);\n\n    width:\n      calc((100% - 10px) / 2);\n  }\n\n\n  .custom-best-sellers__title {\n    font-size: 18px !important;\n  }\n\n\n  .custom-best-sellers__description {\n    font-size: 15px !important;\n  }\n\n\n  .custom-best-sellers__variant {\n    padding-left: 7px;\n    padding-right: 7px;\n  }\n\n}\n\n\n/* =========================================================\n   SAFETY\n   ========================================================= */\n\nhtml,\nbody {\n  max-width: 100%;\n  overflow-x: hidden;\n}\n\n\n.custom-best-sellers {\n  contain: layout paint;\n}\n\n</style>\n\n\n<section\n  class=\"custom-best-sellers\"\n  id=\"CustomBestSellers-{{ section.id | default: 'main' }}\"\n>\n\n  <!-- =====================================================\n       HEADING\n       ===================================================== -->\n\n  <h2 class=\"custom-best-sellers__heading\">\n    New Arrivals\n  </h2>\n\n\n  <!-- =====================================================\n       PRODUCT VIEWPORT\n       ===================================================== -->\n\n  <div class=\"custom-best-sellers__viewport\">\n\n    <div class=\"custom-best-sellers__track\">\n\n      {% assign best_seller_collection = collections['new-arrivals'] %}\n      {% assign product_limit = 8 %}\n\n\n      {% if best_seller_collection != blank\n        and best_seller_collection.products_count > 0\n      %}\n\n\n        {% for product in best_seller_collection.products limit: product_limit %}\n\n          <!-- =================================================\n               PRODUCT CARD\n               ================================================= -->\n\n          <article\n            class=\"custom-best-sellers__card\"\n            data-product-card\n          >\n\n\n            <!-- =================================================\n                 PRODUCT IMAGE AREA\n                 ================================================= -->\n\n            <div\n              class=\"custom-best-sellers__image-box\"\n              data-image-slider\n            >\n\n\n              <!-- NEW ARRIVAL BADGE -->\n\n              <span class=\"custom-best-sellers__badge\">\n                New Arrival\n              </span>\n\n\n              <!-- =================================================\n                   IMAGE LINK + REAL IMAGE TRACK\n                   ================================================= -->\n\n              <a\n                href=\"{{ product.url }}\"\n                class=\"custom-best-sellers__image-link\"\n                aria-label=\"{{ product.title | escape }}\"\n              >\n\n                <div\n                  class=\"custom-best-sellers__image-track\"\n                  data-image-track\n                >\n\n                  {% if product.images.size > 0 %}\n\n                    {% for image in product.images limit: 8 %}\n\n                      <div\n                        class=\"custom-best-sellers__image-slide\"\n                      >\n\n                        <img\n                          class=\"custom-best-sellers__image\"\n                          src=\"{{ image | image_url: width: 1200 }}\"\n                          alt=\"{{ image.alt | default: product.title | escape }}\"\n                          loading=\"{% if forloop.first %}eager{% else %}lazy{% endif %}\"\n                          width=\"{{ image.width }}\"\n                          height=\"{{ image.height }}\"\n                          draggable=\"false\"\n                        >\n\n                      </div>\n\n                    {% endfor %}\n\n                  {% elsif product.featured_image %}\n\n                    <div class=\"custom-best-sellers__image-slide\">\n\n                      <img\n                        class=\"custom-best-sellers__image\"\n                        src=\"{{ product.featured_image | image_url: width: 1200 }}\"\n                        alt=\"{{ product.featured_image.alt | default: product.title | escape }}\"\n                        loading=\"lazy\"\n                        width=\"{{ product.featured_image.width }}\"\n                        height=\"{{ product.featured_image.height }}\"\n                        draggable=\"false\"\n                      >\n\n                    </div>\n\n                  {% endif %}\n\n                </div>\n\n              </a>\n\n\n              <!-- =================================================\n                   PREVIOUS IMAGE\n                   ================================================= -->\n\n              <button\n                type=\"button\"\n                class=\"\n                  custom-best-sellers__image-arrow\n                  custom-best-sellers__image-arrow--prev\n                \"\n                aria-label=\"Previous product image\"\n                data-image-prev\n              >\n\n                <svg viewBox=\"0 0 24 24\">\n\n                  <path\n                    d=\"M14.5 5L7.5 12L14.5 19\"\n                  ></path>\n\n                </svg>\n\n              </button>\n\n\n              <!-- =================================================\n                   NEXT IMAGE\n                   ================================================= -->\n\n              <button\n                type=\"button\"\n                class=\"\n                  custom-best-sellers__image-arrow\n                  custom-best-sellers__image-arrow--next\n                \"\n                aria-label=\"Next product image\"\n                data-image-next\n              >\n\n                <svg viewBox=\"0 0 24 24\">\n\n                  <path\n                    d=\"M9.5 5L16.5 12L9.5 19\"\n                  ></path>\n\n                </svg>\n\n              </button>\n\n\n              <!-- =================================================\n                   IMAGE DOTS\n                   ================================================= -->\n\n              {% if product.images.size > 1 %}\n\n                <div\n                  class=\"custom-best-sellers__image-dots\"\n                  data-image-dots\n                >\n\n                  {% for image in product.images limit: 8 %}\n\n                    <span\n                      class=\"\n                        custom-best-sellers__image-dot\n                        {% if forloop.first %}is-active{% endif %}\n                      \"\n                    ></span>\n\n                  {% endfor %}\n\n                </div>\n\n              {% endif %}\n\n\n            </div>\n\n\n            <!-- =================================================\n                 PRODUCT CONTENT\n                 ================================================= -->\n\n            <div class=\"custom-best-sellers__content\">\n\n\n              <!-- PRODUCT TITLE -->\n\n              <h3 class=\"custom-best-sellers__title\">\n\n                <a href=\"{{ product.url }}\">\n                  {{ product.title }}\n                </a>\n\n              </h3>\n\n\n              <!-- PRODUCT DESCRIPTION -->\n\n              <div class=\"custom-best-sellers__description\">\n\n                {{ product.description\n                  | strip_html\n                  | truncate: 72\n                }}\n\n              </div>\n\n\n              <!-- =================================================\n                   RATING\n                   ================================================= -->\n\n              <div\n                class=\"custom-best-sellers__rating\"\n                aria-label=\"4 out of 5 stars\"\n              >\n\n                <span class=\"custom-best-sellers__star\">\n                  ★\n                </span>\n\n                <span class=\"custom-best-sellers__star\">\n                  ★\n                </span>\n\n                <span class=\"custom-best-sellers__star\">\n                  ★\n                </span>\n\n                <span class=\"custom-best-sellers__star\">\n                  ★\n                </span>\n\n                <span class=\"custom-best-sellers__star empty\">\n                  ☆\n                </span>\n\n              </div>\n\n\n              <!-- =================================================\n                   PRICE\n                   ================================================= -->\n\n              <div class=\"custom-best-sellers__price-row\">\n\n                <span\n                  class=\"custom-best-sellers__price\"\n                  data-product-price\n                >\n                  {{ product.selected_or_first_available_variant.price | money }}\n                </span>\n\n\n                {% if product.selected_or_first_available_variant.compare_at_price\n                  > product.selected_or_first_available_variant.price\n                %}\n\n                  <span\n                    class=\"custom-best-sellers__compare\"\n                    data-product-compare\n                  >\n                    {{ product.selected_or_first_available_variant.compare_at_price | money }}\n                  </span>\n\n                {% else %}\n\n                  <span\n                    class=\"custom-best-sellers__compare\"\n                    data-product-compare\n                    style=\"display:none;\"\n                  ></span>\n\n                {% endif %}\n\n              </div>\n\n\n              <!-- =================================================\n                   VARIANTS\n                   REAL SHOPIFY VARIANTS\n                   ================================================= -->\n\n              {% assign available_variant = product.selected_or_first_available_variant %}\n\n\n              {% if product.variants.size > 1 %}\n\n                <div\n                  class=\"custom-best-sellers__variants\"\n                  data-variant-selector\n                >\n\n                  {% for variant in product.variants %}\n\n                    <button\n                      type=\"button\"\n                      class=\"\n                        custom-best-sellers__variant\n                        {% if variant.id == available_variant.id %}\n                          is-selected\n                        {% endif %}\n                      \"\n                      data-variant-id=\"{{ variant.id }}\"\n                      data-variant-price=\"{{ variant.price | money | escape }}\"\n                      data-variant-compare=\"{{ variant.compare_at_price | default: 0 | money | escape }}\"\n                      data-variant-available=\"{{ variant.available }}\"\n                      {% unless variant.available %}\n                        disabled\n                      {% endunless %}\n                    >\n\n                      {{ variant.title }}\n\n                    </button>\n\n                  {% endfor %}\n\n                </div>\n\n\n              {% elsif product.variants.first.title != 'Default Title' %}\n\n                <div\n                  class=\"custom-best-sellers__variants\"\n                  data-variant-selector\n                >\n\n                  <button\n                    type=\"button\"\n                    class=\"\n                      custom-best-sellers__variant\n                      is-selected\n                    \"\n                    data-variant-id=\"{{ product.variants.first.id }}\"\n                    data-variant-price=\"{{ product.variants.first.price | money | escape }}\"\n                    data-variant-compare=\"{{ product.variants.first.compare_at_price | default: 0 | money | escape }}\"\n                    data-variant-available=\"{{ product.variants.first.available }}\"\n                    {% unless product.variants.first.available %}\n                      disabled\n                    {% endunless %}\n                  >\n\n                    {{ product.variants.first.title }}\n\n                  </button>\n\n                </div>\n\n              {% endif %}\n\n\n              <!-- =================================================\n                   ADD TO CART\n                   ================================================= -->\n\n              <form\n                action=\"{{ routes.cart_add_url }}\"\n                method=\"post\"\n                class=\"custom-best-sellers__cart-form\"\n                data-cart-form\n              >\n\n                <input\n                  type=\"hidden\"\n                  name=\"id\"\n                  value=\"{{ available_variant.id }}\"\n                  data-selected-variant\n                >\n\n\n                <button\n                  type=\"submit\"\n                  class=\"custom-best-sellers__add\"\n                  {% unless available_variant.available %}\n                    disabled\n                  {% endunless %}\n                >\n\n                  {% if available_variant.available %}\n                    Add to cart\n                  {% else %}\n                    Sold out\n                  {% endif %}\n\n                </button>\n\n              </form>\n\n\n            </div>\n\n          </article>\n\n        {% endfor %}\n\n\n      {% else %}\n\n        <div\n          style=\"\n            width:100%;\n            padding:50px 20px;\n            text-align:center;\n            font-size:16px;\n          \"\n        >\n\n          Please create a Shopify collection with handle\n          <strong>new-arrivals</strong>.\n\n        </div>\n\n      {% endif %}\n\n    </div>\n\n  </div>\n\n\n  <!-- =====================================================\n       BOTTOM PRODUCT SLIDER DOTS\n       ===================================================== -->\n\n  <div class=\"custom-best-sellers__bottom\">\n\n    <div\n      class=\"custom-best-sellers__bottom-dots\"\n      data-product-slider-dots\n    ></div>\n\n  </div>\n\n\n  <!-- =====================================================\n       VIEW ALL\n       ===================================================== -->\n\n  {% if best_seller_collection != blank %}\n\n    <div class=\"custom-best-sellers__view-all-wrap\">\n\n      <a\n        href=\"{{ best_seller_collection.url }}\"\n        class=\"custom-best-sellers__view-all\"\n      >\n        View all products\n      </a>\n\n    </div>\n\n  {% endif %}\n\n\n</section>\n\n\n<script>\n\n(function () {\n\n  'use strict';\n\n\n  /* =========================================================\n     INITIALIZE\n     ========================================================= */\n\n  function initBestSellers() {\n\n    var sections =\n      document.querySelectorAll(\n        '.custom-best-sellers'\n      );\n\n\n    sections.forEach(function (section) {\n\n\n      if (\n        section.dataset.initialized === 'true'\n      ) {\n        return;\n      }\n\n\n      section.dataset.initialized = 'true';\n\n\n      /* =====================================================\n         PRODUCT SLIDER ELEMENTS\n         ===================================================== */\n\n      var viewport =\n        section.querySelector(\n          '.custom-best-sellers__viewport'\n        );\n\n\n      var track =\n        section.querySelector(\n          '.custom-best-sellers__track'\n        );\n\n\n      var cards =\n        Array.from(\n          section.querySelectorAll(\n            '.custom-best-sellers__card'\n          )\n        );\n\n\n      var dotsContainer =\n        section.querySelector(\n          '[data-product-slider-dots]'\n        );\n\n\n      if (\n        !viewport ||\n        !track ||\n        !cards.length\n      ) {\n        return;\n      }\n\n\n      /* =====================================================\n         CURRENT PRODUCT PAGE\n         ===================================================== */\n\n      var currentPage = 0;\n\n\n      /* =====================================================\n         GET VISIBLE PRODUCTS\n         ===================================================== */\n\n      function getVisibleProducts() {\n\n        if (\n          window.innerWidth <= 749\n        ) {\n\n          return 2;\n\n        }\n\n\n        return 4;\n\n      }\n\n\n      /* =====================================================\n         GET GAP\n         ===================================================== */\n\n      function getGap() {\n\n        if (\n          window.innerWidth <= 749\n        ) {\n\n          return window.innerWidth <= 380\n            ? 10\n            : 12;\n\n        }\n\n\n        if (\n          window.innerWidth <= 989\n        ) {\n\n          return 16;\n\n        }\n\n\n        return 24;\n\n      }\n\n\n      /* =====================================================\n         TOTAL PAGES\n         ===================================================== */\n\n      function getTotalPages() {\n\n        var visible =\n          getVisibleProducts();\n\n\n        return Math.max(\n          1,\n          Math.ceil(\n            cards.length / visible\n          )\n        );\n\n      }\n\n\n      /* =====================================================\n         BUILD BOTTOM DOTS\n         ===================================================== */\n\n      function buildBottomDots() {\n\n        if (!dotsContainer) {\n          return;\n        }\n\n\n        dotsContainer.innerHTML = '';\n\n\n        var totalPages =\n          getTotalPages();\n\n\n        for (\n          var i = 0;\n          i < totalPages;\n          i++\n        ) {\n\n          var button =\n            document.createElement(\n              'button'\n            );\n\n\n          button.type =\n            'button';\n\n\n          button.className =\n            'custom-best-sellers__bottom-dot';\n\n\n          button.setAttribute(\n            'aria-label',\n            'Show product group ' +\n            (i + 1)\n          );\n\n\n          button.dataset.page =\n            i;\n\n\n          if (\n            i === currentPage\n          ) {\n\n            button.classList.add(\n              'is-active'\n            );\n\n          }\n\n\n          button.addEventListener(\n            'click',\n            function () {\n\n              var page =\n                parseInt(\n                  this.dataset.page,\n                  10\n                );\n\n\n              if (\n                isNaN(page)\n              ) {\n                return;\n              }\n\n\n              currentPage =\n                Math.max(\n                  0,\n                  Math.min(\n                    page,\n                    getTotalPages() - 1\n                  )\n                );\n\n\n              updateProductSlider();\n\n            }\n          );\n\n\n          dotsContainer.appendChild(\n            button\n          );\n\n        }\n\n      }\n\n\n      /* =====================================================\n         PRODUCT SLIDER\n         IMPORTANT:\n         EXACT CARD-BASED CALCULATION\n         ===================================================== */\n\n      function updateProductSlider() {\n\n        var visible =\n          getVisibleProducts();\n\n\n        var gap =\n          getGap();\n\n\n        var totalPages =\n          getTotalPages();\n\n\n        if (\n          currentPage >= totalPages\n        ) {\n\n          currentPage =\n            totalPages - 1;\n\n        }\n\n\n        if (\n          currentPage < 0\n        ) {\n\n          currentPage = 0;\n\n        }\n\n\n        /*\n          Calculate actual card width\n          directly from DOM.\n        */\n\n        var cardWidth =\n          cards[0].getBoundingClientRect().width;\n\n\n        /*\n          Move exactly:\n          card width + gap\n          multiplied by visible cards.\n        */\n\n        var moveDistance =\n          currentPage *\n          visible *\n          (cardWidth + gap);\n\n\n        /*\n          For final page calculate actual\n          available movement so there is\n          no blank area.\n        */\n\n        var maxMove =\n          Math.max(\n            0,\n            track.scrollWidth -\n            viewport.clientWidth\n          );\n\n\n        moveDistance =\n          Math.min(\n            moveDistance,\n            maxMove\n          );\n\n\n        /*\n          Smooth product movement.\n        */\n\n        track.style.transform =\n          'translate3d(' +\n          (-moveDistance) +\n          'px, 0, 0)';\n\n\n        /*\n          Update dots.\n        */\n\n        if (dotsContainer) {\n\n          var dots =\n            dotsContainer.querySelectorAll(\n              '.custom-best-sellers__bottom-dot'\n            );\n\n\n          dots.forEach(\n            function (dot, index) {\n\n              dot.classList.toggle(\n                'is-active',\n                index === currentPage\n              );\n\n            }\n          );\n\n        }\n\n      }\n\n\n      /* =====================================================\n         PRODUCT IMAGE SLIDERS\n         ===================================================== */\n\n      cards.forEach(function (card) {\n\n\n        var imageBox =\n          card.querySelector(\n            '[data-image-slider]'\n          );\n\n\n        if (!imageBox) {\n          return;\n        }\n\n\n        var imageTrack =\n          imageBox.querySelector(\n            '[data-image-track]'\n          );\n\n\n        var slides =\n          Array.from(\n            imageBox.querySelectorAll(\n              '.custom-best-sellers__image-slide'\n            )\n          );\n\n\n        var prevButton =\n          imageBox.querySelector(\n            '[data-image-prev]'\n          );\n\n\n        var nextButton =\n          imageBox.querySelector(\n            '[data-image-next]'\n          );\n\n\n        var dots =\n          Array.from(\n            imageBox.querySelectorAll(\n              '.custom-best-sellers__image-dot'\n            )\n          );\n\n\n        /*\n          If only one image,\n          arrows and dots are hidden.\n        */\n\n        if (\n          slides.length <= 1\n        ) {\n\n          if (prevButton) {\n            prevButton.style.display =\n              'none';\n          }\n\n\n          if (nextButton) {\n            nextButton.style.display =\n              'none';\n          }\n\n\n          if (dots.length) {\n\n            dots.forEach(\n              function (dot) {\n\n                dot.style.display =\n                  'none';\n\n              }\n            );\n\n          }\n\n\n          return;\n\n        }\n\n\n        var currentImage = 0;\n\n\n        /* =================================================\n           UPDATE IMAGE SLIDER\n           ================================================= */\n\n        function updateImageSlider(\n          direction\n        ) {\n\n          /*\n            Calculate next index.\n          */\n\n          if (\n            direction === 'next'\n          ) {\n\n            currentImage++;\n\n\n            if (\n              currentImage >=\n              slides.length\n            ) {\n\n              currentImage = 0;\n\n            }\n\n          }\n\n\n          if (\n            direction === 'prev'\n          ) {\n\n            currentImage--;\n\n\n            if (\n              currentImage < 0\n            ) {\n\n              currentImage =\n                slides.length - 1;\n\n            }\n\n          }\n\n\n          /*\n            Actual horizontal movement.\n            Each slide = 100%.\n          */\n\n          var move =\n            currentImage * 100;\n\n\n          imageTrack.style.transform =\n            'translate3d(-' +\n            move +\n            '%, 0, 0)';\n\n\n          /*\n            Update dots.\n          */\n\n          dots.forEach(\n            function (\n              dot,\n              index\n            ) {\n\n              dot.classList.toggle(\n                'is-active',\n                index === currentImage\n              );\n\n            }\n          );\n\n        }\n\n\n        /* =================================================\n           NEXT IMAGE\n           ================================================= */\n\n        if (nextButton) {\n\n          nextButton.addEventListener(\n            'click',\n            function (event) {\n\n              event.preventDefault();\n\n              event.stopPropagation();\n\n\n              updateImageSlider(\n                'next'\n              );\n\n            }\n          );\n\n        }\n\n\n        /* =================================================\n           PREVIOUS IMAGE\n           ================================================= */\n\n        if (prevButton) {\n\n          prevButton.addEventListener(\n            'click',\n            function (event) {\n\n              event.preventDefault();\n\n              event.stopPropagation();\n\n\n              updateImageSlider(\n                'prev'\n              );\n\n            }\n          );\n\n        }\n\n\n        /*\n          Prevent arrow clicks from\n          following the image link.\n        */\n\n        [prevButton, nextButton].forEach(\n          function (button) {\n\n            if (!button) {\n              return;\n            }\n\n\n            button.addEventListener(\n              'mousedown',\n              function (event) {\n\n                event.preventDefault();\n\n              }\n            );\n\n          }\n        );\n\n\n      });\n\n\n      /* =====================================================\n         VARIANT SELECTOR\n         ===================================================== */\n\n      cards.forEach(function (card) {\n\n\n        var selector =\n          card.querySelector(\n            '[data-variant-selector]'\n          );\n\n\n        var hiddenInput =\n          card.querySelector(\n            '[data-selected-variant]'\n          );\n\n\n        var addButton =\n          card.querySelector(\n            '.custom-best-sellers__add'\n          );\n\n\n        var priceElement =\n          card.querySelector(\n            '[data-product-price]'\n          );\n\n\n        var compareElement =\n          card.querySelector(\n            '[data-product-compare]'\n          );\n\n\n        if (\n          !selector ||\n          !hiddenInput\n        ) {\n          return;\n        }\n\n\n        var variants =\n          Array.from(\n            selector.querySelectorAll(\n              '.custom-best-sellers__variant'\n            )\n          );\n\n\n        variants.forEach(\n          function (variant) {\n\n\n            variant.addEventListener(\n              'click',\n              function (event) {\n\n                event.preventDefault();\n\n\n                /*\n                  Don't select unavailable\n                  variants.\n                */\n\n                if (\n                  variant.disabled\n                ) {\n\n                  return;\n\n                }\n\n\n                /*\n                  Remove previous selection.\n                */\n\n                variants.forEach(\n                  function (item) {\n\n                    item.classList.remove(\n                      'is-selected'\n                    );\n\n                  }\n                );\n\n\n                /*\n                  Select clicked variant.\n                */\n\n                variant.classList.add(\n                  'is-selected'\n                );\n\n\n                /*\n                  Get REAL Shopify\n                  variant ID.\n                */\n\n                var variantId =\n                  variant.getAttribute(\n                    'data-variant-id'\n                  );\n\n\n                if (\n                  variantId\n                ) {\n\n                  hiddenInput.value =\n                    variantId;\n\n                }\n\n\n                /*\n                  Update price.\n                */\n\n                var variantPrice =\n                  variant.getAttribute(\n                    'data-variant-price'\n                  );\n\n\n                if (\n                  priceElement &&\n                  variantPrice\n                ) {\n\n                  priceElement.textContent =\n                    variantPrice;\n\n                }\n\n\n                /*\n                  Update compare price.\n                */\n\n                var variantCompare =\n                  variant.getAttribute(\n                    'data-variant-compare'\n                  );\n\n\n                if (\n                  compareElement\n                ) {\n\n                  if (\n                    variantCompare &&\n                    variantCompare !==\n                    'Rs. 0.00' &&\n                    variantCompare !==\n                    'Rs.0.00'\n                  ) {\n\n                    compareElement.textContent =\n                      variantCompare;\n\n                    compareElement.style.display =\n                      '';\n\n                  } else {\n\n                    compareElement.textContent =\n                      '';\n\n                    compareElement.style.display =\n                      'none';\n\n                  }\n\n                }\n\n\n                /*\n                  Update Add to Cart.\n                */\n\n                if (addButton) {\n\n                  addButton.disabled =\n                    false;\n\n                  addButton.textContent =\n                    'Add to cart';\n\n                }\n\n              }\n            );\n\n          }\n        );\n\n\n      });\n\n\n      /* =====================================================\n         CART FORM\n         ===================================================== */\n\n      var cartForms =\n        section.querySelectorAll(\n          '[data-cart-form]'\n        );\n\n\n      cartForms.forEach(\n        function (form) {\n\n          form.addEventListener(\n            'submit',\n            function (event) {\n\n              var selectedVariant =\n                form.querySelector(\n                  '[data-selected-variant]'\n                );\n\n\n              /*\n                Make sure an actual\n                variant ID exists.\n              */\n\n              if (\n                !selectedVariant ||\n                !selectedVariant.value\n              ) {\n\n                event.preventDefault();\n\n                return;\n\n              }\n\n            }\n          );\n\n        }\n      );\n\n\n      /* =====================================================\n         INITIAL PRODUCT SLIDER\n         ===================================================== */\n\n      buildBottomDots();\n\n\n      setTimeout(\n        function () {\n\n          updateProductSlider();\n\n        },\n        100\n      );\n\n\n      /* =====================================================\n         RESIZE\n         ===================================================== */\n\n      var resizeTimer = null;\n\n\n      window.addEventListener(\n        'resize',\n        function () {\n\n\n          clearTimeout(\n            resizeTimer\n          );\n\n\n          resizeTimer =\n            setTimeout(\n              function () {\n\n\n                var totalPages =\n                  getTotalPages();\n\n\n                if (\n                  currentPage >=\n                  totalPages\n                ) {\n\n                  currentPage =\n                    Math.max(\n                      0,\n                      totalPages - 1\n                    );\n\n                }\n\n\n                buildBottomDots();\n\n\n                updateProductSlider();\n\n\n              },\n              120\n            );\n\n        }\n      );\n\n\n    });\n\n  }\n\n\n  /* =========================================================\n     INITIAL LOAD\n     ========================================================= */\n\n  if (\n    document.readyState ===\n    'loading'\n  ) {\n\n    document.addEventListener(\n      'DOMContentLoaded',\n      initBestSellers\n    );\n\n  } else {\n\n    initBestSellers();\n\n  }\n\n\n  /* =========================================================\n     SHOPIFY THEME EDITOR\n     ========================================================= */\n\n  document.addEventListener(\n    'shopify:section:load',\n    function (event) {\n\n\n      var section =\n        event.target &&\n        event.target.querySelector\n          ? event.target.querySelector(\n              '.custom-best-sellers'\n            )\n          : null;\n\n\n      if (section) {\n\n        section.dataset.initialized =\n          'false';\n\n      }\n\n\n      initBestSellers();\n\n    }\n  );\n\n\n})();\n\n</script>",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
