{
  "sections": {
    "custom_liquid_HChwgB": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n/* =========================================================\n   3 IMAGE HERO SLIDER\n   FULLY RESPONSIVE\n   ZERO HORIZONTAL PAGE OVERFLOW\n   CUSTOM LIQUID\n   ========================================================= */\n/* ---------------------------------------------------------\n   CRITICAL GLOBAL FIX\n   --------------------------------------------------------- */\nhtml {\n  max-width: 100%;\n  overflow-x: hidden !important;\n}\nbody {\n  max-width: 100%;\n  overflow-x: hidden !important;\n}\n/* ---------------------------------------------------------\n   HERO\n   --------------------------------------------------------- */\n.custom-five-hero {\n  position: relative;\n  display: block;\n  width: 100% !important;\n  max-width: 100% !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  overflow: hidden !important;\n  line-height: 0;\n  isolation: isolate;\n  box-sizing: border-box;\n  contain: paint;\n}\n/* ---------------------------------------------------------\n   ALL CHILDREN\n   --------------------------------------------------------- */\n.custom-five-hero *,\n.custom-five-hero *::before,\n.custom-five-hero *::after {\n  box-sizing: border-box;\n}\n/* ---------------------------------------------------------\n   VIEWPORT\n   --------------------------------------------------------- */\n.custom-five-hero__viewport {\n  position: relative;\n  display: block;\n  width: 100% !important;\n  max-width: 100% !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  overflow: hidden !important;\n  line-height: 0;\n  touch-action: pan-y;\n  box-sizing: border-box;\n}\n/* ---------------------------------------------------------\n   TRACK\n   --------------------------------------------------------- */\n.custom-five-hero__track {\n  display: flex;\n  width: 300% !important;\n  max-width: none !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  transform:\n    translate3d(0, 0, 0);\n  transition:\n    transform 0.55s\n    cubic-bezier(\n      0.22,\n      0.61,\n      0.36,\n      1\n    );\n  will-change: transform;\n  line-height: 0;\n  white-space: nowrap;\n  backface-visibility: hidden;\n}\n/* ---------------------------------------------------------\n   SLIDE\n   --------------------------------------------------------- */\n.custom-five-hero__slide {\n  display: block;\n  position: relative;\n  width: 33.3333% !important;\n  min-width: 33.3333% !important;\n  max-width: 33.3333% !important;\n  flex: 0 0 33.3333% !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  overflow: hidden;\n  line-height: 0;\n  box-sizing: border-box;\n  aspect-ratio: 1600 / 528;\n}\n/* ---------------------------------------------------------\n   IMAGE\n   --------------------------------------------------------- */\n.custom-five-hero__slide img {\n  display: block;\n  width: 100% !important;\n  max-width: 100% !important;\n  height: 100% !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  border: 0 !important;\n  outline: 0 !important;\n  object-fit: cover;\n  object-position: center;\n  vertical-align: top;\n  user-select: none;\n  -webkit-user-select: none;\n  -webkit-user-drag: none;\n  pointer-events: none;\n}\n/* =========================================================\n   ARROWS\n   ========================================================= */\n.custom-five-hero__arrow {\n  position: absolute;\n  top: 50%;\n  z-index: 20;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 50px;\n  height: 50px;\n  margin: 0;\n  padding: 0;\n  border: 0;\n  border-radius: 50%;\n  background:\n    rgba(255,255,255,.95);\n  color: #000;\n  cursor: pointer;\n  transform:\n    translateY(-50%);\n  box-shadow:\n    0 4px 18px\n    rgba(0,0,0,.10);\n  transition:\n    transform .2s ease,\n    background .2s ease,\n    box-shadow .2s ease;\n  appearance: none;\n  -webkit-appearance: none;\n  touch-action: manipulation;\n}\n/* ---------------------------------------------------------\n   ARROW HOVER\n   --------------------------------------------------------- */\n.custom-five-hero__arrow:hover {\n  background: #fff;\n  box-shadow:\n    0 6px 22px\n    rgba(0,0,0,.16);\n}\n/* ---------------------------------------------------------\n   ARROW ACTIVE\n   --------------------------------------------------------- */\n.custom-five-hero__arrow:active {\n  transform:\n    translateY(-50%)\n    scale(.94);\n}\n/* ---------------------------------------------------------\n   PREVIOUS\n   --------------------------------------------------------- */\n.custom-five-hero__arrow--prev {\n  left: 24px;\n}\n/* ---------------------------------------------------------\n   NEXT\n   --------------------------------------------------------- */\n.custom-five-hero__arrow--next {\n  right: 24px;\n}\n/* ---------------------------------------------------------\n   ARROW SVG\n   --------------------------------------------------------- */\n.custom-five-hero__arrow svg {\n  display: block;\n  width: 28px;\n  height: 28px;\n  fill: none;\n  stroke: #000;\n  stroke-width: 2.5;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n/* =========================================================\n   DOTS\n   ========================================================= */\n.custom-five-hero__dots {\n  position: absolute;\n  left: 50%;\n  bottom: 18px;\n  z-index: 20;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  max-width:\n    calc(100% - 40px);\n  transform:\n    translateX(-50%);\n  line-height: 0;\n}\n/* ---------------------------------------------------------\n   DOT\n   --------------------------------------------------------- */\n.custom-five-hero__dot {\n  display: block;\n  width: 8px;\n  height: 8px;\n  min-width: 8px;\n  margin: 0;\n  padding: 0;\n  border: 0;\n  border-radius: 50%;\n  background:\n    rgba(0,0,0,.25);\n  cursor: pointer;\n  flex-shrink: 0;\n  appearance: none;\n  -webkit-appearance: none;\n  transition:\n    width .25s ease,\n    background .25s ease;\n}\n/* ---------------------------------------------------------\n   ACTIVE DOT\n   --------------------------------------------------------- */\n.custom-five-hero__dot.is-active {\n  width: 24px;\n  border-radius: 20px;\n  background: #000;\n}\n/* =========================================================\n   LARGE TABLET / SMALL LAPTOP\n   ========================================================= */\n@media screen and (max-width: 1199px) {\n  .custom-five-hero__arrow {\n    width: 46px;\n    height: 46px;\n  }\n  .custom-five-hero__arrow--prev {\n    left: 18px;\n  }\n  .custom-five-hero__arrow--next {\n    right: 18px;\n  }\n  .custom-five-hero__arrow svg {\n    width: 25px;\n    height: 25px;\n  }\n}\n/* =========================================================\n   TABLET\n   ========================================================= */\n@media screen and (max-width: 989px) {\n  .custom-five-hero {\n    width: 100% !important;\n    max-width: 100% !important;\n    margin: 0 !important;\n    overflow: hidden !important;\n  }\n  .custom-five-hero__viewport {\n    width: 100% !important;\n    max-width: 100% !important;\n    overflow: hidden !important;\n  }\n  .custom-five-hero__arrow {\n    width: 44px;\n    height: 44px;\n  }\n  .custom-five-hero__arrow--prev {\n    left: 15px;\n  }\n  .custom-five-hero__arrow--next {\n    right: 15px;\n  }\n  .custom-five-hero__arrow svg {\n    width: 23px;\n    height: 23px;\n  }\n  .custom-five-hero__dots {\n    bottom: 14px;\n    gap: 7px;\n  }\n  .custom-five-hero__dot {\n    width: 7px;\n    height: 7px;\n    min-width: 7px;\n  }\n  .custom-five-hero__dot.is-active {\n    width: 21px;\n  }\n}\n/* =========================================================\n   MOBILE\n   ========================================================= */\n@media screen and (max-width: 749px) {\n  .custom-five-hero {\n    position: relative;\n    display: block;\n    width: 100% !important;\n    max-width: 100% !important;\n    min-width: 0 !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    overflow: hidden !important;\n    left: auto !important;\n    right: auto !important;\n  }\n  .custom-five-hero__viewport {\n    width: 100% !important;\n    max-width: 100% !important;\n    min-width: 0 !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    overflow: hidden !important;\n  }\n  .custom-five-hero__track {\n    width: 300% !important;\n    max-width: none !important;\n    transform:\n      translate3d(0,0,0);\n  }\n  .custom-five-hero__slide {\n    width: 33.3333% !important;\n    min-width: 33.3333% !important;\n    max-width: 33.3333% !important;\n    flex: 0 0 33.3333% !important;\n  }\n  .custom-five-hero__slide img {\n    width: 100% !important;\n    max-width: 100% !important;\n    height: 100% !important;\n  }\n  /* -------------------------------------------------------\n     MOBILE ARROWS\n     ------------------------------------------------------- */\n  .custom-five-hero__arrow {\n    width: 42px;\n    height: 42px;\n    box-shadow:\n      0 3px 14px\n      rgba(0,0,0,.12);\n  }\n  .custom-five-hero__arrow--prev {\n    left: 9px;\n  }\n  .custom-five-hero__arrow--next {\n    right: 9px;\n  }\n  .custom-five-hero__arrow svg {\n    width: 21px;\n    height: 21px;\n    stroke-width: 2.7;\n  }\n  /* -------------------------------------------------------\n     MOBILE DOTS\n     ------------------------------------------------------- */\n  .custom-five-hero__dots {\n    bottom: 9px;\n    gap: 6px;\n    max-width:\n      calc(100% - 30px);\n  }\n  .custom-five-hero__dot {\n    width: 6px;\n    height: 6px;\n    min-width: 6px;\n  }\n  .custom-five-hero__dot.is-active {\n    width: 18px;\n  }\n}\n/* =========================================================\n   SMALL MOBILE\n   ========================================================= */\n@media screen and (max-width: 480px) {\n  .custom-five-hero {\n    width: 100% !important;\n    max-width: 100% !important;\n    overflow: hidden !important;\n  }\n  .custom-five-hero__viewport {\n    width: 100% !important;\n    max-width: 100% !important;\n    overflow: hidden !important;\n  }\n  .custom-five-hero__arrow {\n    width: 38px;\n    height: 38px;\n  }\n  .custom-five-hero__arrow--prev {\n    left: 7px;\n  }\n  .custom-five-hero__arrow--next {\n    right: 7px;\n  }\n  .custom-five-hero__arrow svg {\n    width: 19px;\n    height: 19px;\n  }\n}\n/* =========================================================\n   EXTRA SMALL DEVICES\n   ========================================================= */\n@media screen and (max-width: 380px) {\n  .custom-five-hero {\n    width: 100% !important;\n    max-width: 100% !important;\n  }\n  .custom-five-hero__arrow {\n    width: 34px;\n    height: 34px;\n  }\n  .custom-five-hero__arrow--prev {\n    left: 6px;\n  }\n  .custom-five-hero__arrow--next {\n    right: 6px;\n  }\n  .custom-five-hero__arrow svg {\n    width: 17px;\n    height: 17px;\n  }\n}\n/* =========================================================\n   ULTRA SMALL\n   ========================================================= */\n@media screen and (max-width: 320px) {\n  .custom-five-hero__arrow {\n    width: 30px;\n    height: 30px;\n  }\n  .custom-five-hero__arrow--prev {\n    left: 5px;\n  }\n  .custom-five-hero__arrow--next {\n    right: 5px;\n  }\n  .custom-five-hero__arrow svg {\n    width: 15px;\n    height: 15px;\n  }\n  .custom-five-hero__dots {\n    bottom: 7px;\n  }\n}\n</style>\n<!-- =========================================================\n     HERO SLIDER\n     ========================================================= -->\n<div\n  class=\"custom-five-hero\"\n  id=\"CustomFiveHero\"\n>\n  <div class=\"custom-five-hero__viewport\">\n    <div class=\"custom-five-hero__track\">\n      <!-- =====================================================\n           SLIDE 1 - FACE MASKS\n           ===================================================== -->\n      <div class=\"custom-five-hero__slide\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0704/1295/9787/files/ChatGPT_Image_Sep_3_2026_11_00_59_PM.png?v=1788458506\"\n          alt=\"Introducing Retinol and Glycolic Face Serums\" loading=\"eager\"\n          fetchpriority=\"high\"\n          draggable=\"false\"\n        >\n      </div>\n      <!-- =====================================================\n           SLIDE 2 - FACE SERUMS\n           ===================================================== -->\n      <div class=\"custom-five-hero__slide\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0704/1295/9787/files/ChatGPT_Image_Sep_3_2026_10_53_57_PM.png?v=1788458054\"\n          alt=\"Introducing Oil to Milk and Sunscreen SPF 50 Plus\" loading=\"lazy\" draggable=\"false\">\n      </div>\n      <!-- =====================================================\n           SLIDE 3 - CLEANSER & SPF\n           ===================================================== -->\n      <div class=\"custom-five-hero__slide\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0704/1295/9787/files/ChatGPT_Image_Sep_3_2026_10_46_09_PM.png?v=1788457586\"\n          alt=\"Introducing the bundle of all three face masks\"\n          loading=\"lazy\"\n          draggable=\"false\"\n        >\n      </div>\n    </div>\n    <!-- =======================================================\n         PREVIOUS\n         ======================================================= -->\n    <button\n      type=\"button\"\n      class=\"custom-five-hero__arrow custom-five-hero__arrow--prev\"\n      aria-label=\"Previous banner\"\n    >\n      <svg viewBox=\"0 0 24 24\">\n        <path d=\"M15 18L9 12L15 6\"></path>\n      </svg>\n    </button>\n    <!-- =======================================================\n         NEXT\n         ======================================================= -->\n    <button\n      type=\"button\"\n      class=\"custom-five-hero__arrow custom-five-hero__arrow--next\"\n      aria-label=\"Next banner\"\n    >\n      <svg viewBox=\"0 0 24 24\">\n        <path d=\"M9 18L15 12L9 6\"></path>\n      </svg>\n    </button>\n    <!-- =======================================================\n         DOTS\n         ======================================================= -->\n    <div class=\"custom-five-hero__dots\">\n      <button\n        type=\"button\"\n        class=\"custom-five-hero__dot is-active\"\n        data-slide=\"0\"\n        aria-label=\"Go to banner 1\"\n      ></button>\n      <button\n        type=\"button\"\n        class=\"custom-five-hero__dot\"\n        data-slide=\"1\"\n        aria-label=\"Go to banner 2\"\n      ></button>\n      <button\n        type=\"button\"\n        class=\"custom-five-hero__dot\"\n        data-slide=\"2\"\n        aria-label=\"Go to banner 3\"\n      ></button>\n    </div>\n  </div>\n</div>\n<script>\n(function () {\n  function initFiveHeroSlider() {\n    var slider =\n      document.querySelector(\n        '.custom-five-hero'\n      );\n    if (!slider) {\n      return;\n    }\n    if (\n      slider.dataset.initialized === 'true'\n    ) {\n      return;\n    }\n    slider.dataset.initialized = 'true';\n    var track =\n      slider.querySelector(\n        '.custom-five-hero__track'\n      );\n    var slides =\n      slider.querySelectorAll(\n        '.custom-five-hero__slide'\n      );\n    var prevButton =\n      slider.querySelector(\n        '.custom-five-hero__arrow--prev'\n      );\n    var nextButton =\n      slider.querySelector(\n        '.custom-five-hero__arrow--next'\n      );\n    var dots =\n      slider.querySelectorAll(\n        '.custom-five-hero__dot'\n      );\n    var currentSlide = 0;\n    var totalSlides =\n      slides.length;\n    var autoSlideDelay = 5000;\n    var autoSlideTimer = null;\n    var touchStartX = 0;\n    var touchEndX = 0;\n    var isDragging = false;\n    /* =====================================================\n       UPDATE\n       ===================================================== */\n    function updateSlider(index) {\n      if (index < 0) {\n        index =\n          totalSlides - 1;\n      }\n      if (\n        index >= totalSlides\n      ) {\n        index = 0;\n      }\n      currentSlide = index;\n      track.style.transform =\n        'translate3d(-' +\n        (currentSlide * (100 / totalSlides)) +\n        '%, 0, 0)';\n      dots.forEach(\n        function (dot, dotIndex) {\n          if (\n            dotIndex ===\n            currentSlide\n          ) {\n            dot.classList.add(\n              'is-active'\n            );\n          } else {\n            dot.classList.remove(\n              'is-active'\n            );\n          }\n        }\n      );\n    }\n    /* =====================================================\n       NEXT\n       ===================================================== */\n    function nextSlide() {\n      updateSlider(\n        currentSlide + 1\n      );\n    }\n    /* =====================================================\n       PREVIOUS\n       ===================================================== */\n    function previousSlide() {\n      updateSlider(\n        currentSlide - 1\n      );\n    }\n    /* =====================================================\n       AUTO PLAY\n       ===================================================== */\n    function startAutoSlide() {\n      stopAutoSlide();\n      autoSlideTimer =\n        setInterval(\n          function () {\n            nextSlide();\n          },\n          autoSlideDelay\n        );\n    }\n    function stopAutoSlide() {\n      if (\n        autoSlideTimer\n      ) {\n        clearInterval(\n          autoSlideTimer\n        );\n        autoSlideTimer = null;\n      }\n    }\n    /* =====================================================\n       NEXT BUTTON\n       ===================================================== */\n    if (nextButton) {\n      nextButton.addEventListener(\n        'click',\n        function () {\n          nextSlide();\n          startAutoSlide();\n        }\n      );\n    }\n    /* =====================================================\n       PREVIOUS BUTTON\n       ===================================================== */\n    if (prevButton) {\n      prevButton.addEventListener(\n        'click',\n        function () {\n          previousSlide();\n          startAutoSlide();\n        }\n      );\n    }\n    /* =====================================================\n       DOTS\n       ===================================================== */\n    dots.forEach(\n      function (dot) {\n        dot.addEventListener(\n          'click',\n          function () {\n            var index =\n              parseInt(\n                dot.getAttribute(\n                  'data-slide'\n                ),\n                10\n              );\n            updateSlider(index);\n            startAutoSlide();\n          }\n        );\n      }\n    );\n    /* =====================================================\n       TOUCH START\n       ===================================================== */\n    slider.addEventListener(\n      'touchstart',\n      function (event) {\n        if (\n          !event.touches ||\n          !event.touches.length\n        ) {\n          return;\n        }\n        touchStartX =\n          event.touches[0].clientX;\n        touchEndX =\n          touchStartX;\n        isDragging = true;\n        stopAutoSlide();\n      },\n      {\n        passive: true\n      }\n    );\n    /* =====================================================\n       TOUCH MOVE\n       ===================================================== */\n    slider.addEventListener(\n      'touchmove',\n      function (event) {\n        if (!isDragging) {\n          return;\n        }\n        if (\n          !event.touches ||\n          !event.touches.length\n        ) {\n          return;\n        }\n        touchEndX =\n          event.touches[0].clientX;\n      },\n      {\n        passive: true\n      }\n    );\n    /* =====================================================\n       TOUCH END\n       ===================================================== */\n    slider.addEventListener(\n      'touchend',\n      function () {\n        if (!isDragging) {\n          return;\n        }\n        isDragging = false;\n        var distance =\n          touchEndX -\n          touchStartX;\n        if (\n          Math.abs(distance) > 50\n        ) {\n          if (distance < 0) {\n            nextSlide();\n          } else {\n            previousSlide();\n          }\n        }\n        startAutoSlide();\n      },\n      {\n        passive: true\n      }\n    );\n    /* =====================================================\n       MOUSE\n       ===================================================== */\n    slider.addEventListener(\n      'mouseenter',\n      function () {\n        stopAutoSlide();\n      }\n    );\n    slider.addEventListener(\n      'mouseleave',\n      function () {\n        startAutoSlide();\n      }\n    );\n    /* =====================================================\n       INITIAL\n       ===================================================== */\n    updateSlider(0);\n    startAutoSlide();\n  }\n  /* =======================================================\n     DOM READY\n     ======================================================= */\n  if (\n    document.readyState ===\n    'loading'\n  ) {\n    document.addEventListener(\n      'DOMContentLoaded',\n      initFiveHeroSlider\n    );\n  } else {\n    initFiveHeroSlider();\n  }\n  /* =======================================================\n     SHOPIFY THEME EDITOR\n     ======================================================= */\n  document.addEventListener(\n    'shopify:section:load',\n    function () {\n      initFiveHeroSlider();\n    }\n  );\n})();\n</script>",
