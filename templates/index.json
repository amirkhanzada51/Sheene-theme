        "text_jFgTPW": {
          "type": "text",
          "name": "t:names.heading",
          "settings": {
            "text": "<h2><strong>Beware of Fake Products – Buy Only from the Official Sheene Shop</strong></h2>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "custom",
