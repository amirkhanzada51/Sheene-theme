                      "type": "text",
                      "settings": {
                        "text": "<p><strong>Skin type:</strong> Oily/Combination, Acne-Prone</p><p><strong>Concerns:</strong> Acne, Breakouts & Oiliness</p><p><strong>Suitable for:</strong> 15+ years of age</p>",
                        "width": "100%",
