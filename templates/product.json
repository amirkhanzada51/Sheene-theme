                  "blocks": {
                    "text_tCATaG": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Apply on wet face. Pour an appropriate quantity into wet hands, rub together into a light lather, and massage into face. Rinse thoroughly.<br/><br/><strong>When to use:</strong>When to use: AM & PM. Everyday.<br/><br/></p>",
